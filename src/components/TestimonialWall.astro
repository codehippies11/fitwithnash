---
type Testimonial = {
  client_name?: string;
  quote?: string | null;
  image_url?: string | null;
  image_alt?: string | null;
  testimonial_type?: 'auto' | 'quote' | 'image' | 'mixed' | string | null;
  source_label?: string | null;
};

interface Props {
  testimonials: Testimonial[];
  tone?: 'dark' | 'light';
  label?: string;
  layout?: 'wall' | 'carousel';
}

const { testimonials, tone = 'dark', label = 'Client testimonials', layout = 'wall' } = Astro.props;
const clean = (value?: string | null) => String(value || '').trim();
const proofType = (item: Testimonial) => {
  const hasImage = Boolean(clean(item.image_url));
  const hasQuote = Boolean(clean(item.quote));
  if (item.testimonial_type && item.testimonial_type !== 'auto') return item.testimonial_type;
  if (hasImage && hasQuote) return 'mixed';
  return hasImage ? 'image' : 'quote';
};
---

<div class:list={['proof-wall', `proof-wall--${tone}`, `proof-wall--${layout}`]} aria-label={label} data-proof-wall data-layout={layout}>
  <div class="proof-wall__header" aria-hidden={layout !== 'carousel'}>
    <p>Selected client proof</p>
    {layout === 'carousel' && <div class="proof-wall__controls"><button type="button" data-proof-previous aria-label="Previous testimonial">←</button><button type="button" data-proof-next aria-label="Next testimonial">→</button></div>}
  </div>
  <div class="proof-wall__grid" data-proof-track tabindex={layout === 'carousel' ? 0 : undefined}>
    {testimonials.map((item, index) => {
      const type = proofType(item);
      const quote = clean(item.quote);
      const image = clean(item.image_url);
      const name = clean(item.client_name) || 'FitWithNash client';
      const imageAlt = clean(item.image_alt) || `Client proof shared by ${name}`;
      return <article class:list={['proof-card', `proof-card--${type}`]} data-proof-card>
        {image && <figure class="proof-card__visual">
          <img src={image} alt={imageAlt} loading="lazy" />
          <figcaption>Client-shared proof</figcaption>
        </figure>}
        {quote && <blockquote class="proof-card__quote">“{quote}”</blockquote>}
        <footer class="proof-card__meta">
          <span>{String(index + 1).padStart(2, '0')} / {type === 'image' ? 'Visual proof' : 'Client voice'}</span>
          <strong>{name}</strong>
          {clean(item.source_label) && <small>{item.source_label}</small>}
        </footer>
      </article>;
    })}
  </div>
</div>

<script>
  const cards = document.querySelectorAll('[data-proof-card]');
  if (!('IntersectionObserver' in window)) cards.forEach((card) => card.classList.add('is-visible'));
  else {
    const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    }), { threshold: 0.14 });
    cards.forEach((card, index) => {
      card.style.setProperty('--motion-order', String(index));
      observer.observe(card);
    });
  }
  document.querySelectorAll('[data-proof-wall][data-layout="carousel"]').forEach((wall) => {
    const track = wall.querySelector('[data-proof-track]');
    const previous = wall.querySelector('[data-proof-previous]');
    const next = wall.querySelector('[data-proof-next]');
    const scroll = (direction) => track?.scrollBy({ left: direction * Math.min(track.clientWidth * .88, 760), behavior: 'smooth' });
    previous?.addEventListener('click', () => scroll(-1));
    next?.addEventListener('click', () => scroll(1));
  });
</script>

<style>
  .proof-wall { --wall-ink:#11130f; --wall-paper:#f7f5ee; --wall-accent:#d9ff45; --wall-muted:#6a6d65; }
  .proof-wall--dark { --wall-ink:#f4f3eb; --wall-paper:#171a14; --wall-accent:#d9ff45; --wall-muted:#b6bab0; }
  .proof-wall__header { display:none; align-items:center; justify-content:space-between; margin-top:38px; border-top:1px solid color-mix(in srgb,var(--wall-ink) 18%,transparent); padding-top:14px; }
  .proof-wall__header p { margin:0; color:var(--wall-muted); font:700 10px/1 ui-monospace,SFMono-Regular,Menlo,monospace; letter-spacing:.12em; text-transform:uppercase; }
  .proof-wall__controls { display:flex; gap:7px; }
  .proof-wall__controls button { display:grid; width:40px; height:40px; place-items:center; border:1px solid color-mix(in srgb,var(--wall-ink) 24%,transparent); border-radius:50%; background:transparent; color:var(--wall-ink); font-size:18px; cursor:pointer; transition:background .2s ease,color .2s ease,transform .2s ease; }
  .proof-wall__controls button:hover { background:var(--wall-accent); color:#10120f; transform:translateY(-2px); }
  .proof-wall__grid { display:grid; grid-template-columns:repeat(12,minmax(0,1fr)); gap:14px; margin-top:50px; }
  .proof-card { display:flex; min-height:286px; flex-direction:column; grid-column:span 4; overflow:hidden; border:1px solid color-mix(in srgb,var(--wall-ink) 15%,transparent); background:var(--wall-paper); color:var(--wall-ink); box-shadow:0 16px 40px rgba(0,0,0,.08); opacity:0; transform:translateY(24px) scale(.985); transition:opacity .65s ease,transform .65s cubic-bezier(.2,.75,.25,1),box-shadow .35s ease; transition-delay:calc(var(--motion-order,0) * 70ms); }
  .proof-card.is-visible { opacity:1; transform:translateY(0) scale(1); }
  .proof-card:hover { box-shadow:0 24px 55px rgba(0,0,0,.16); transform:translateY(-5px); }
  .proof-card--mixed { grid-column:span 6; min-height:520px; }
  .proof-card--image { grid-column:span 4; min-height:430px; }
  .proof-card--quote { justify-content:space-between; padding:28px; }
  .proof-card--quote:nth-child(5n+1) { grid-column:span 5; }
  .proof-card__visual { position:relative; display:grid; flex:1; min-height:230px; margin:0; overflow:hidden; background:linear-gradient(135deg,#31382c,#171a14); }
  .proof-card__visual::after { position:absolute; inset:0; content:""; background:linear-gradient(180deg,transparent 68%,rgba(0,0,0,.34)); pointer-events:none; }
  .proof-card__visual img { width:100%; height:100%; object-fit:contain; background:#1a1d18; transition:transform .7s cubic-bezier(.2,.75,.25,1); }
  .proof-card:hover .proof-card__visual img { transform:scale(1.035); }
  .proof-card__visual figcaption { position:absolute; z-index:1; right:12px; bottom:12px; padding:7px 9px; background:var(--wall-accent); color:#10120f; font:700 9px/1 ui-monospace,SFMono-Regular,Menlo,monospace; letter-spacing:.08em; text-transform:uppercase; }
  .proof-card__quote { margin:0; padding:clamp(23px,3vw,42px); font:600 clamp(1.45rem,2.35vw,2.65rem)/1.05 "Playfair Display",serif; letter-spacing:-.042em; }
  .proof-card--mixed .proof-card__quote { padding-bottom:20px; }
  .proof-card__meta { display:grid; gap:5px; margin-top:auto; padding:18px 20px 20px; border-top:1px solid color-mix(in srgb,var(--wall-ink) 12%,transparent); }
  .proof-card--quote .proof-card__meta { padding:22px 0 0; }
  .proof-card__meta span { color:color-mix(in srgb,var(--wall-ink) 58%,var(--wall-accent)); font:700 9px/1.35 ui-monospace,SFMono-Regular,Menlo,monospace; letter-spacing:.08em; text-transform:uppercase; }
  .proof-card__meta strong { font:700 13px/1.2 Manrope,system-ui,sans-serif; }
  .proof-card__meta small { color:var(--wall-muted); font:500 11px/1.4 Manrope,system-ui,sans-serif; }
  .proof-wall--carousel .proof-wall__header { display:flex; }
  .proof-wall--carousel .proof-wall__grid { display:flex; gap:16px; margin-top:18px; overflow-x:auto; overscroll-behavior-x:contain; padding:1px 1px 20px; scroll-snap-type:x mandatory; scrollbar-width:none; }
  .proof-wall--carousel .proof-wall__grid::-webkit-scrollbar { display:none; }
  .proof-wall--carousel .proof-card { width:min(69vw,780px); min-width:min(69vw,780px); min-height:560px; grid-column:auto; scroll-snap-align:start; scroll-snap-stop:always; }
  .proof-wall--carousel .proof-card:nth-child(3n+2) { width:min(44vw,520px); min-width:min(44vw,520px); }
  .proof-wall--carousel .proof-card--quote { justify-content:space-between; }
  .proof-wall--carousel .proof-card--quote:nth-child(5n+1) { grid-column:auto; }
  .proof-wall--carousel .proof-card__visual { min-height:300px; }
  .proof-wall--carousel .proof-card--image .proof-card__visual { min-height:470px; }
  @media (max-width:820px) { .proof-wall__grid { grid-template-columns:repeat(2,minmax(0,1fr)); margin-top:34px; } .proof-card,.proof-card--mixed,.proof-card--image,.proof-card--quote:nth-child(5n+1) { min-height:0; grid-column:span 1; } .proof-card--mixed { min-height:460px; } .proof-card--image { min-height:360px; } .proof-wall--carousel .proof-card,.proof-wall--carousel .proof-card:nth-child(3n+2) { width:min(76vw,580px); min-width:min(76vw,580px); min-height:480px; } }
  @media (max-width:540px) { .proof-wall__grid { grid-template-columns:1fr; } .proof-card,.proof-card--mixed,.proof-card--image,.proof-card--quote:nth-child(5n+1) { grid-column:1; } .proof-card--mixed { min-height:420px; } .proof-card--quote { min-height:260px; } .proof-card__quote { font-size:clamp(1.55rem,8vw,2.25rem); } .proof-wall--carousel .proof-card,.proof-wall--carousel .proof-card:nth-child(3n+2) { width:86vw; min-width:86vw; min-height:440px; } .proof-wall--carousel .proof-card--image .proof-card__visual { min-height:365px; } }
  @media (prefers-reduced-motion:reduce) { .proof-card,.proof-card__visual img { transition:none; } .proof-card { opacity:1; transform:none; } }
</style>
