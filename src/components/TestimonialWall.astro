---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Testimonial = {
  client_name?: string;
  quote?: string | null;
  image_url?: string | null;
  image_alt?: string | null;
  testimonial_type?: 'auto' | 'quote' | 'image' | 'mixed' | string | null;
  source_label?: string | null;
  rating?: number | null;
  image?: ImageMetadata | null;
};

interface Props {
  testimonials: Testimonial[];
  tone?: 'dark' | 'light';
  label?: string;
  layout?: 'wall' | 'stack' | 'carousel';
}

const { testimonials, tone = 'dark', label = 'Client testimonials', layout = 'wall' } = Astro.props;
const clean = (value?: string | null) => String(value || '').trim();
const proofType = (item: Testimonial) => {
  const hasImage = Boolean(clean(item.image_url));
  const hasQuote = Boolean(clean(item.quote));
  if (item.testimonial_type && item.testimonial_type !== 'auto') return item.testimonial_type;
  if (hasImage && hasQuote) return 'mixed';
  return hasImage ? 'image' : 'quote';
};
---

<div class:list={['proof-wall', `proof-wall--${tone}`, `proof-wall--${layout}`]} role={layout === 'carousel' ? 'region' : undefined} aria-roledescription={layout === 'carousel' ? 'carousel' : undefined} aria-label={label} data-proof-wall data-layout={layout}>
  <div class="proof-wall__header" aria-hidden={layout !== 'carousel'}>
    <div><p>Original client reviews</p>{layout === 'carousel' && <span class="proof-wall__swipe-hint">Swipe through client stories</span>}</div>
    {layout === 'carousel' && <div class="proof-wall__utility"><button type="button" data-proof-toggle aria-pressed="true"><span data-proof-toggle-label>Pause</span></button></div>}
  </div>
  <div class="proof-wall__grid" data-proof-track tabindex={layout === 'carousel' ? 0 : undefined} aria-label={layout === 'carousel' ? 'Scrollable client reviews' : undefined}>
    {testimonials.map((item, index) => {
      const type = proofType(item);
      const quote = clean(item.quote);
      const image = clean(item.image_url);
      const imageAsset = item.image;
      const name = clean(item.client_name) || 'FitWithNash client';
      const imageAlt = clean(item.image_alt) || `Client proof shared by ${name}`;
      const rating = Number(item.rating || 0);
      return <article class:list={['proof-card', `proof-card--${type}`, layout === 'carousel' && !image && 'proof-card--no-image']} role={layout === 'carousel' ? 'group' : undefined} aria-roledescription={layout === 'carousel' ? 'slide' : undefined} aria-label={layout === 'carousel' ? `${name}, review ${index + 1} of ${testimonials.length}` : undefined} data-proof-card>
        {layout === 'carousel' ? <>
          <div class="proof-card__copy">
            <div class="proof-card__rating">
              {rating > 0 && <span role="img" aria-label={`${rating} out of 5 stars`}><b aria-hidden="true">{'★'.repeat(rating)}</b><i aria-hidden="true">{'★'.repeat(Math.max(0, 5 - rating))}</i></span>}
              <small>{clean(item.source_label) || 'Client experience'}</small>
            </div>
            {quote ? <blockquote class="proof-card__quote">“{quote}”</blockquote> : <p class="proof-card__summary">Original client words, preserved in the review.</p>}
            <footer class="proof-card__identity"><strong>{name}</strong><span>FitWithNash client</span></footer>
          </div>
          {image && <a class="proof-card__evidence" href={image} target="_blank" rel="noreferrer" data-proof-view data-proof-src={image} data-proof-alt={imageAlt} data-proof-label={`${name} · original client review`} aria-label={`View the original review from ${name}`}>
            {imageAsset ? <Image src={imageAsset} alt={imageAlt} widths={[360, 480, 640]} sizes="(max-width: 760px) 84vw, 42vw" format="webp" quality={78} loading="lazy" /> : <img src={image} alt={imageAlt} loading="lazy" decoding="async" />}
            <span>View original review <b aria-hidden="true">↗</b></span>
          </a>}
        </> : <>
          {image && <figure class="proof-card__visual"><img src={image} alt={imageAlt} loading="lazy" decoding="async" /><figcaption>Client-shared proof</figcaption></figure>}
          {quote && <blockquote class="proof-card__quote">“{quote}”</blockquote>}
          <footer class="proof-card__meta"><span>{type === 'image' ? 'Visual proof' : 'Client voice'}</span><strong>{name}</strong>{clean(item.source_label) && <small>{item.source_label}</small>}</footer>
        </>}
      </article>;
    })}
  </div>
  {layout === 'carousel' && <div class="proof-wall__carousel-nav" aria-label="Testimonial carousel navigation">
    <div class="proof-wall__controls">
      <button type="button" data-proof-previous aria-label="Show previous testimonial"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6" /></svg><span>Previous</span></button>
      <button type="button" data-proof-next aria-label="Show next testimonial"><span>Next</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></button>
    </div>
  </div>}
  {layout === 'carousel' && <span class="proof-wall__announcer" data-proof-announcer aria-live="polite"></span>}
</div>

<script>
  const proofCards = document.querySelectorAll('[data-proof-card]');
  if (!('IntersectionObserver' in window)) proofCards.forEach((card) => card.classList.add('is-visible'));
  else {
    const revealProof = new IntersectionObserver((entries) => entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      entry.target.classList.add('is-visible');
      revealProof.unobserve(entry.target);
    }), { threshold: 0.12 });
    proofCards.forEach((card, index) => {
      card.style.setProperty('--motion-order', String(index));
      revealProof.observe(card);
    });
  }

  document.querySelectorAll('[data-proof-wall][data-layout="carousel"]').forEach((wall) => {
    const track = wall.querySelector('[data-proof-track]');
    const previous = wall.querySelector('[data-proof-previous]');
    const next = wall.querySelector('[data-proof-next]');
    const toggle = wall.querySelector('[data-proof-toggle]');
    const toggleLabel = wall.querySelector('[data-proof-toggle-label]');
    const announcer = wall.querySelector('[data-proof-announcer]');
    const originals = [...(track?.querySelectorAll('[data-proof-card]') || [])];
    if (!track || originals.length < 2) return;

    const makeClone = (card, position) => {
      const clone = card.cloneNode(true);
      clone.setAttribute('aria-hidden', 'true');
      clone.setAttribute('inert', '');
      clone.removeAttribute('aria-label');
      clone.dataset.proofClone = position;
      return clone;
    };
    track.prepend(makeClone(originals.at(-1), 'start'));
    track.append(makeClone(originals[0], 'end'));

    const carouselCards = [...track.querySelectorAll('[data-proof-card]')];
    const total = originals.length;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activeIndex = 1;
    let timer = 0;
    let resumeTimer = 0;
    let playing = !reducedMotion;
    let viewerOpen = false;
    let inViewport = false;
    let pointerInside = false;
    let focusInside = false;
    let scrollTimer = 0;
    let restoreSnapFrame = 0;

    const logicalIndex = (index) => index === 0 ? total - 1 : index === total + 1 ? 0 : index - 1;
    const cardName = (index) => originals[logicalIndex(index)]?.querySelector('.proof-card__identity strong')?.textContent?.trim() || 'Client';
    const stop = () => {
      window.clearInterval(timer);
      timer = 0;
    };
    const position = (index, behavior = 'smooth') => {
      const card = carouselCards[index];
      if (!card) return;
      const left = card.offsetLeft - (track.clientWidth - card.clientWidth) / 2;
      if (behavior === 'auto') track.scrollLeft = left;
      else track.scrollTo({ left, behavior });
    };
    const sync = (index, behavior = 'smooth', announce = false) => {
      activeIndex = Math.max(0, Math.min(total + 1, index));
      carouselCards.forEach((card, cardIndex) => {
        card.classList.toggle('is-current', cardIndex === activeIndex);
        if (!card.dataset.proofClone) {
          const isActive = cardIndex === activeIndex;
          card.setAttribute('aria-hidden', isActive ? 'false' : 'true');
          if (isActive) card.removeAttribute('inert'); else card.setAttribute('inert', '');
        }
      });
      const current = logicalIndex(activeIndex);
      if (announce && announcer) announcer.textContent = `${cardName(activeIndex)}, testimonial ${current + 1} of ${total}`;
      position(activeIndex, reducedMotion ? 'auto' : behavior);
    };
    const start = () => {
      stop();
      if (!playing || !inViewport || document.hidden || pointerInside || focusInside || viewerOpen) return;
      timer = window.setInterval(() => sync(activeIndex + 1, 'smooth'), 3000);
    };
    const scheduleResume = () => {
      window.clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(start, 3800);
    };
    const manualMove = (direction) => {
      stop();
      sync(activeIndex + direction, 'smooth', true);
      scheduleResume();
    };
    const nearestIndex = () => {
      const center = track.getBoundingClientRect().left + track.clientWidth / 2;
      return carouselCards.reduce((best, card, index) => {
        const rect = card.getBoundingClientRect();
        const distance = Math.abs(rect.left + rect.width / 2 - center);
        return distance < best.distance ? { index, distance } : best;
      }, { index: activeIndex, distance: Infinity }).index;
    };
    const normalize = () => {
      const nearest = nearestIndex();
      if (nearest === 0) sync(total, 'auto');
      else if (nearest === total + 1) sync(1, 'auto');
      else if (nearest !== activeIndex) sync(nearest, 'auto');
      start();
    };
    const centerActive = () => {
      track.style.scrollSnapType = 'none';
      position(activeIndex, 'auto');
      window.cancelAnimationFrame(restoreSnapFrame);
      restoreSnapFrame = requestAnimationFrame(() => track.style.removeProperty('scroll-snap-type'));
    };

    previous?.addEventListener('click', () => manualMove(-1));
    next?.addEventListener('click', () => manualMove(1));
    toggle?.addEventListener('click', () => {
      playing = !playing;
      toggle.setAttribute('aria-pressed', String(playing));
      if (toggleLabel) toggleLabel.textContent = playing ? 'Pause' : 'Play';
      if (playing) start(); else stop();
    });
    track.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      manualMove(event.key === 'ArrowRight' ? 1 : -1);
    });
    track.addEventListener('pointerenter', () => { pointerInside = true; stop(); });
    track.addEventListener('pointerleave', () => { pointerInside = false; scheduleResume(); });
    track.addEventListener('focusin', () => { focusInside = true; stop(); });
    track.addEventListener('focusout', (event) => {
      if (wall.contains(event.relatedTarget)) return;
      focusInside = false;
      scheduleResume();
    });
    track.addEventListener('touchstart', () => { stop(); scheduleResume(); }, { passive: true });
    track.addEventListener('scrollend', normalize);
    track.addEventListener('scroll', () => {
      window.clearTimeout(scrollTimer);
      scrollTimer = window.setTimeout(normalize, 140);
    }, { passive: true });
    document.addEventListener('visibilitychange', start);
    document.addEventListener('proofviewer:open', () => { viewerOpen = true; stop(); });
    document.addEventListener('proofviewer:close', () => { viewerOpen = false; start(); });

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        inViewport = entry.isIntersecting;
        if (inViewport) start(); else stop();
      }, { threshold: 0.22 }).observe(wall);
    } else inViewport = true;

    toggle?.setAttribute('aria-pressed', String(playing));
    if (toggleLabel) toggleLabel.textContent = playing ? 'Pause' : 'Play';
    sync(activeIndex, 'auto');
    requestAnimationFrame(() => requestAnimationFrame(centerActive));
    window.addEventListener('load', centerActive, { once: true });
    document.fonts?.ready?.then(centerActive);
    window.setTimeout(centerActive, 280);
    if ('ResizeObserver' in window) new ResizeObserver(centerActive).observe(track);
    start();
  });
</script>

<style>
  .proof-wall { --wall-ink:#11130f; --wall-paper:#f7f5ee; --wall-accent:#d9ff45; --wall-muted:#6a6d65; }
  .proof-wall--dark { --wall-ink:#f4f3eb; --wall-paper:#171a14; --wall-accent:#d9ff45; --wall-muted:#b6bab0; }
  .proof-wall__header { display:none; align-items:center; justify-content:space-between; margin-top:38px; border-top:1px solid color-mix(in srgb,var(--wall-ink) 18%,transparent); padding-top:14px; }
  .proof-wall__header p { margin:0; color:var(--wall-muted); font:700 10px/1 ui-monospace,SFMono-Regular,Menlo,monospace; letter-spacing:.12em; text-transform:uppercase; }
  .proof-wall__carousel-nav { position:absolute; z-index:4; top:50%; right:8px; left:8px; display:block; margin:0; padding:0; pointer-events:none; transform:translateY(-50%); }
  .proof-wall__browse-copy { display:none; }
  .proof-wall__browse-copy strong { font:800 11px/1 Manrope,system-ui,sans-serif; letter-spacing:.04em; text-transform:uppercase; }
  .proof-wall__browse-copy span { color:var(--wall-muted); font:700 9px/1 ui-monospace,SFMono-Regular,Menlo,monospace; letter-spacing:.06em; text-transform:uppercase; }
  .proof-wall__swipe-hint { color:var(--wall-muted); font:700 9px/1 ui-monospace,SFMono-Regular,Menlo,monospace; letter-spacing:.08em; text-transform:uppercase; }
  .proof-wall__controls { display:flex; align-items:center; justify-content:space-between; width:100%; pointer-events:none; }
  .proof-wall__controls button { position:relative; display:grid; width:58px; height:58px; place-items:center; overflow:hidden; border:1px solid rgba(53,57,61,.42); border-radius:50%; background:rgba(86,91,96,.78); color:#fff; cursor:pointer; opacity:.43; pointer-events:auto; box-shadow:none; backdrop-filter:blur(4px); transition:opacity .28s ease,background .28s ease,color .28s ease,transform .32s cubic-bezier(.22,1,.36,1),box-shadow .32s ease; }
  .proof-wall__controls button::before { position:absolute; inset:-45%; content:""; background:linear-gradient(115deg,transparent 36%,rgba(217,255,69,.42) 50%,transparent 64%); opacity:0; transform:translateX(-55%) rotate(12deg); transition:transform .55s ease,opacity .28s ease; }
  .proof-wall__controls button svg { position:relative; z-index:1; width:25px; height:25px; fill:none; stroke:currentColor; stroke-linecap:round; stroke-linejoin:round; stroke-width:2.1; transition:transform .28s cubic-bezier(.22,1,.36,1); }
  .proof-wall__controls button span { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; }
  .proof-wall__controls button:hover, .proof-wall__controls button:focus-visible { background:var(--wall-accent); color:#10120f; opacity:1; box-shadow:0 10px 28px rgba(0,0,0,.18); transform:scale(1.06); outline:none; }
  .proof-wall__controls button:hover::before, .proof-wall__controls button:focus-visible::before { opacity:1; transform:translateX(62%) rotate(12deg); }
  .proof-wall__controls button:first-child:hover svg { transform:translateX(-4px); }
  .proof-wall__controls button:last-child:hover svg { transform:translateX(4px); }
  .proof-wall__controls button:active { transform:scale(.94); }
  .proof-wall__grid { display:grid; grid-template-columns:repeat(12,minmax(0,1fr)); gap:14px; margin-top:50px; }
  .proof-card { position:relative; display:flex; min-height:286px; flex-direction:column; grid-column:span 4; isolation:isolate; overflow:hidden; border:1px solid color-mix(in srgb,var(--wall-ink) 15%,transparent); background:var(--wall-paper); color:var(--wall-ink); box-shadow:0 16px 40px rgba(0,0,0,.08); opacity:0; transform:translateY(24px) scale(.985); transition:opacity .65s ease,transform .65s cubic-bezier(.2,.75,.25,1),box-shadow .35s ease; transition-delay:calc(var(--motion-order,0) * 70ms); }
  .proof-card::before { display:none; }
  .proof-card.is-visible { opacity:1; transform:translateY(0) scale(1); }
  .proof-card:hover { box-shadow:0 24px 55px rgba(0,0,0,.16); transform:translateY(-5px); }
  .proof-card--mixed { grid-column:span 6; min-height:520px; }
  .proof-card--image { grid-column:span 4; min-height:430px; }
  .proof-card--quote { justify-content:space-between; padding:28px; }
  .proof-card--quote:nth-child(5n+1) { grid-column:span 5; }
  .proof-card__visual { position:relative; display:grid; flex:1; min-height:230px; margin:0; overflow:hidden; background:linear-gradient(135deg,#31382c,#171a14); }
  .proof-card__visual::after { position:absolute; inset:0; content:""; background:linear-gradient(180deg,transparent 68%,rgba(0,0,0,.34)); pointer-events:none; }
  .proof-card__visual img { width:100%; height:100%; object-fit:contain; background:#1a1d18; transition:transform .7s cubic-bezier(.2,.75,.25,1); }
  .proof-card:hover .proof-card__visual img { transform:scale(1.035); }
  .proof-card__visual figcaption { position:absolute; z-index:1; right:12px; bottom:12px; padding:7px 9px; background:var(--wall-accent); color:#10120f; font:700 9px/1 ui-monospace,SFMono-Regular,Menlo,monospace; letter-spacing:.08em; text-transform:uppercase; }
  .proof-card__quote { margin:0; padding:clamp(23px,3vw,42px); font:600 clamp(1.45rem,2.35vw,2.65rem)/1.05 "Playfair Display",serif; letter-spacing:-.042em; }
  .proof-card--mixed .proof-card__quote { padding-bottom:20px; }
  .proof-card__meta { display:grid; gap:5px; margin-top:auto; padding:18px 20px 20px; border-top:1px solid color-mix(in srgb,var(--wall-ink) 12%,transparent); }
  .proof-card--quote .proof-card__meta { padding:22px 0 0; }
  .proof-card__meta span { color:color-mix(in srgb,var(--wall-ink) 58%,var(--wall-accent)); font:700 9px/1.35 ui-monospace,SFMono-Regular,Menlo,monospace; letter-spacing:.08em; text-transform:uppercase; }
  .proof-card__meta strong { font:700 13px/1.2 Manrope,system-ui,sans-serif; }
  .proof-card__meta small { color:var(--wall-muted); font:500 11px/1.4 Manrope,system-ui,sans-serif; }
  .proof-wall--carousel { --wall-paper:#fff; --wall-ink:#151715; --wall-muted:#64695f; position:relative; }
  .proof-wall--carousel .proof-wall__header { display:flex; }
  .proof-wall--carousel .proof-wall__grid { position:relative; display:flex; min-width:0; gap:20px; margin-top:22px; overflow-x:auto; overscroll-behavior-x:contain; padding:14px max(0px,calc((100% - min(100%,640px))/2)) 30px; scroll-padding-inline:max(0px,calc((100% - min(100%,640px))/2)); scroll-snap-type:x mandatory; scrollbar-width:none; }
  .proof-wall--carousel .proof-wall__grid::-webkit-scrollbar { display:none; }
  .proof-wall--carousel .proof-card { position:relative; width:min(86vw,640px); min-width:min(86vw,640px); max-width:100%; min-height:0; grid-column:auto; isolation:isolate; scroll-snap-align:center; scroll-snap-stop:always; border:1.5px solid rgba(168,105,47,.34); border-radius:16px; background:#fff; }
  .proof-wall--carousel .proof-card::before { position:absolute; z-index:5; inset:-2px; display:block; padding:1.5px; border-radius:17px; background:linear-gradient(112deg,transparent 38%,rgba(222,135,38,.24) 45%,#f3aa45 49%,#ffe0a3 50%,#e47d25 52%,rgba(222,135,38,.18) 57%,transparent 64%); background-size:280% 100%; background-position:155% 0; content:""; opacity:0; pointer-events:none; -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0); -webkit-mask-composite:xor; mask-composite:exclude; animation:carousel-edge-glint 10.5s cubic-bezier(.22,1,.36,1) infinite; }
  .proof-wall--carousel .proof-card.is-current::before { animation-duration:8.4s; }
  @keyframes carousel-edge-glint { 0%,67%,100% { background-position:155% 0; opacity:0; } 70% { opacity:.28; } 79% { background-position:-55% 0; opacity:.92; } 86% { opacity:0; } }
  .proof-wall--carousel .proof-card--quote { justify-content:space-between; }
  .proof-wall--carousel .proof-card--quote:nth-child(5n+1) { grid-column:auto; }
  .proof-wall--carousel .proof-card__visual { min-height:330px; padding:0; background:#fff; }
  .proof-wall--carousel .proof-card__visual::after { display:none; }
  .proof-wall--carousel .proof-card__visual img { border:0; border-radius:15px; box-shadow:none; }
  .proof-wall--carousel .proof-card--image .proof-card__visual { min-height:min(72vw,620px); background:#fff; }
  .proof-wall--carousel .proof-card--image .proof-card__visual img { border:0; border-radius:15px; box-shadow:none; }
  .proof-wall--carousel .proof-card { opacity:1; filter:none; transform:scale(.98); box-shadow:0 12px 30px rgba(0,0,0,.12); transition:transform .56s cubic-bezier(.22,1,.36,1),box-shadow .56s ease,border-color .3s ease; }
  .proof-wall--carousel .proof-card.is-current { transform:scale(1); box-shadow:0 26px 60px rgba(0,0,0,.24),0 0 0 4px rgba(230,120,28,.15); }
  .proof-wall--stack { width:min(100%,880px); margin:0 auto; }
  .proof-wall--stack .proof-wall__grid { display:grid; grid-template-columns:1fr; gap:20px; margin-top:34px; }
  .proof-wall--stack .proof-card,.proof-wall--stack .proof-card--mixed,.proof-wall--stack .proof-card--image,.proof-wall--stack .proof-card--quote:nth-child(5n+1) { min-height:0; grid-column:1; }
  .proof-wall--stack .proof-card--image { min-height:0; }
  .proof-wall--stack .proof-card__visual { min-height:min(67vw,530px); max-height:530px; }
  .proof-wall--stack .proof-card__visual img { object-fit:contain; }
  @media (max-width:820px) { .proof-wall__grid { grid-template-columns:repeat(2,minmax(0,1fr)); margin-top:34px; } .proof-card,.proof-card--mixed,.proof-card--image,.proof-card--quote:nth-child(5n+1) { min-height:0; grid-column:span 1; } .proof-card--mixed { min-height:460px; } .proof-card--image { min-height:360px; } .proof-wall--carousel .proof-wall__grid { gap:16px; } }
  @media (max-width:540px) { .proof-wall__header { align-items:flex-start; gap:12px; } .proof-wall__carousel-nav { right:5px; left:5px; } .proof-wall__browse-copy { display:none; } .proof-wall__swipe-hint { display:none; } .proof-wall__controls button { width:44px; height:44px; } .proof-wall__controls button svg { width:21px; height:21px; } .proof-wall__grid { grid-template-columns:1fr; } .proof-card,.proof-card--mixed,.proof-card--image,.proof-card--quote:nth-child(5n+1) { grid-column:1; } .proof-card--mixed { min-height:420px; } .proof-card--quote { min-height:260px; } .proof-card__quote { font-size:clamp(1.55rem,8vw,2.25rem); } .proof-wall--carousel .proof-wall__grid { gap:14px; } .proof-wall--carousel .proof-card--image .proof-card__visual { min-height:min(100vw,520px); } }
  @media (prefers-reduced-motion:reduce) { .proof-card,.proof-card::before,.proof-card__visual img,.proof-wall__controls button { transition:none; animation:none; } .proof-card { opacity:1; transform:none; } }
</style>

<style>
  /* Editorial proof carousel — one focused client story, with the original review
     available on demand. This block intentionally seals older wall styles. */
  .proof-wall,.proof-wall *, .proof-wall *::before, .proof-wall *::after { box-sizing:border-box; }
  .proof-wall,.proof-wall__grid,.proof-card,.proof-card__visual { min-width:0; max-width:100%; }
  .proof-card__quote { overflow-wrap:break-word; }
  .proof-wall--carousel {
    --carousel-card:min(76vw,940px);
    position:relative;
    width:100%;
    min-width:0;
    isolation:isolate;
    overflow:hidden;
  }
  .proof-wall--carousel .proof-wall__header {
    display:flex;
    min-height:34px;
    align-items:center;
    justify-content:space-between;
    gap:22px;
    margin:0;
    padding:0 0 14px;
    border-top:0;
    border-bottom:1px solid rgba(36,29,25,.14);
  }
