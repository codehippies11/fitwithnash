---
interface Props {
  whatsappNumber: string;
}

const { whatsappNumber } = Astro.props;
const whatsappLink = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Hi Avinash, I would like to know more about coaching.')}`;
---

<div class="floating-buttons-container">
  {/* Bottom-right buttons - ALWAYS VISIBLE */}
  <div class="floating-buttons-group floating-buttons-top">
    {/* WhatsApp Button */}
    <a 
      href={whatsappLink} 
      target="_blank" 
      rel="noreferrer" 
      class="floating-btn floating-btn-whatsapp"
      aria-label="Chat with FitWithNash on WhatsApp"
    >
      <svg viewBox="0 0 24 24" class="whatsapp-logo" aria-hidden="true">
        <path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.67-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421-7.403h-.004a9.87 9.87 0 00-4.782 1.16l-.344.194-.356.1 1.41 3.993.191-.06a8.145 8.145 0 013.885-.992c4.534 0 8.226 3.636 8.226 8.1 0 2.176-.823 4.21-2.318 5.74-.71.84-1.632 1.526-2.687 1.986l-.261.125.023.637c.024.533.023 1.402.023 2.457 0 .552-.023 1.095-.068 1.622-.022.265.565.468 1.028.303 7.236-3.488 12.065-10.737 12.065-19.128 0-11.462-9.165-20.766-20.457-20.766C6.187 2.966 2.266 6.887 2.266 11.708c0 3.589 1.754 6.822 4.666 8.816.302.18.566-.455.568-1.025z"/>
      </svg>
    </a>

    {/* Consult Button */}
    <a 
      href={whatsappLink} 
      target="_blank" 
      rel="noreferrer" 
      class="floating-btn floating-btn-consult"
      aria-label="Consult with Avinash"
    >
      <span class="consult-text">Consult<br/>Avinash</span>
      <span class="pulse-ring"></span>
    </a>
  </div>

  {/* Bottom-center button - ALWAYS VISIBLE */}
  <a 
    href={whatsappLink} 
    target="_blank" 
    rel="noreferrer" 
    class="floating-btn-center floating-btn-call-center"
    aria-label="Request a private clarity call"
  >
    <span class="call-text">Request<br/>Call</span>
    <span class="pulse-ring-call"></span>
  </a>
</div>

<style>
  .floating-buttons-container {
    --lime: #d5ff45;
    --ink: #10110f;
    --paper: #f4f1e9;
  }

  /* Bottom-right floating buttons group - ALWAYS VISIBLE */
  .floating-buttons-group {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 40;
    display: flex;
    flex-direction: column;
    gap: 12px;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* WhatsApp Button */
  .floating-btn-whatsapp {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: linear-gradient(135deg, #25d366 0%, #128c7e 100%);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    box-shadow: 0 4px 24px rgba(37, 211, 102, 0.35);
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    position: relative;
    overflow: hidden;
  }

  .floating-btn-whatsapp::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.2);
    transition: left 0.3s ease;
    border-radius: 50%;
  }

  .floating-btn-whatsapp:hover::before {
    left: 100%;
  }

  .floating-btn-whatsapp:hover {
    transform: scale(1.12) translateY(-4px);
    box-shadow: 0 8px 32px rgba(37, 211, 102, 0.45);
  }

  .floating-btn-whatsapp:active {
    transform: scale(0.95);
  }

  .whatsapp-logo {
    width: 28px;
    height: 28px;
  }

  /* Consult Button */
  .floating-btn-consult {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--lime) 0%, #a8d400 100%);
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    box-shadow: 0 4px 24px rgba(213, 255, 69, 0.3);
    transition: all 0.3s ease;
    border: 2px solid rgba(16, 17, 15, 0.1);
    cursor: pointer;
    position: relative;
    font-weight: 700;
    font-size: 10px;
    line-height: 1.2;
    text-align: center;
    font-family: 'Manrope', system-ui, sans-serif;
    overflow: hidden;
  }

  .consult-text {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .pulse-ring {
    position: absolute;
    width: 100%;
    height: 100%;
    border: 2px solid var(--lime);
    border-radius: 50%;
    animation: pulse-animation 2s ease-out infinite;
    top: 0;
    left: 0;
  }

  @keyframes pulse-animation {
    0% {
      transform: scale(1);
      opacity: 1;
    }
    100% {
      transform: scale(1.4);
      opacity: 0;
    }
  }

  .floating-btn-consult:hover {
    transform: scale(1.15) translateY(-4px);
    box-shadow: 0 8px 32px rgba(213, 255, 69, 0.45);
    background: linear-gradient(135deg, #e8ff7f 0%, #c5ff00 100%);
  }

  .floating-btn-consult:active {
    transform: scale(0.92);
  }

  /* Bottom-center button - ALWAYS VISIBLE */
  .floating-btn-center {
    position: fixed;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 39;
    background: linear-gradient(135deg, var(--lime) 0%, #a8d400 100%);
    color: var(--ink);
    padding: 14px 28px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 700;
    font-size: 13px;
    font-family: 'Manrope', system-ui, sans-serif;
    box-shadow: 0 8px 32px rgba(213, 255, 69, 0.3);
    display: flex;
    align-items: center;
    gap: 10px;
    transition: all 0.3s ease;
    cursor: pointer;
    border: 2px solid rgba(16, 17, 15, 0.08);
    opacity: 1;
    visibility: visible;
    white-space: nowrap;
    pointer-events: auto;
  }

  .call-text {
    letter-spacing: 0.5px;
    line-height: 1.2;
  }

  .pulse-ring-call {
    position: absolute;
    width: calc(100% + 16px);
    height: calc(100% + 16px);
    border: 2px solid var(--lime);
    border-radius: 50px;
    animation: pulse-call 2.5s ease-out infinite;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  @keyframes pulse-call {
    0% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 1;
    }
    100% {
      transform: translate(-50%, -50%) scale(1.3);
      opacity: 0;
    }
  }

  .floating-btn-call-center:hover {
    transform: translateX(-50%) translateY(-4px);
    box-shadow: 0 12px 40px rgba(213, 255, 69, 0.4);
    background: linear-gradient(135deg, #e8ff7f 0%, #c5ff00 100%);
  }

  .floating-btn-call-center:active {
    transform: translateX(-50%) translateY(2px);
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    .floating-buttons-group {
      bottom: 16px;
      right: 16px;
      gap: 8px;
    }

    .floating-btn-whatsapp,
    .floating-btn-consult {
      width: 50px;
      height: 50px;
    }

    .whatsapp-logo {
      width: 24px;
      height: 24px;
    }

    .consult-text {
      font-size: 9px;
    }

    .floating-btn-center {
      padding: 12px 20px;
      font-size: 11px;
      bottom: 20px;
    }

    .call-text {
      font-size: 10px;
    }
  }

  @media (max-width: 480px) {
    .floating-btn-center {
      padding: 11px 16px;
      font-size: 10px;
      gap: 6px;
      bottom: 16px;
    }

    .call-text {
      font-size: 9px;
    }
  }
</style>

<script>
  // Both button groups are always visible - no hiding on scroll
  document.addEventListener('DOMContentLoaded', () => {
    const topGroup = document.querySelector('.floating-buttons-group');
    const centerBtn = document.querySelector('.floating-btn-center');
    
    // Optional: Add entrance animation
    if (topGroup) {
      topGroup.style.opacity = '0';
      topGroup.style.transform = 'translateY(20px)';
      setTimeout(() => {
        topGroup.style.transition = 'all 0.4s cubic-bezier(0.23, 1, 0.320, 1)';
        topGroup.style.opacity = '1';
        topGroup.style.transform = 'translateY(0)';
      }, 100);
    }

    if (centerBtn) {
      centerBtn.style.opacity = '0';
      centerBtn.style.transform = 'translateX(-50%) translateY(20px)';
      setTimeout(() => {
        centerBtn.style.transition = 'all 0.5s cubic-bezier(0.23, 1, 0.320, 1)';
        centerBtn.style.opacity = '1';
        centerBtn.style.transform = 'translateX(-50%) translateY(0)';
      }, 200);
    }
  });
</script>