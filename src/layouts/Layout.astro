---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'FitWithNash | Strength, built for real life.',
  description = 'Practical training, sustainable nutrition, and a stronger version of you with FitWithNash.',
} = Astro.props;
const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER?.replace(/\D/g, '') || '918360669905';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#10110f" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet" />
    <link rel="canonical" href={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="FitWithNash home"><span>FIT</span>WITHNASH</a>
      <nav aria-label="Primary navigation">
        <a href="#programs">Programs</a>
        <a href="#method">The method</a>
        <a href="#journal">Journal</a>
      </nav>
      <a class="header-cta" href="/contact">Start here <span aria-hidden="true">↗</span></a>
    </header>
    <slot />
    <aside class="social-float" aria-label="Quick contact">
      <a class="social-float__link social-float__instagram" href="https://www.instagram.com/fitwithnash/" target="_blank" rel="noreferrer" aria-label="Message FitWithNash on Instagram"><span aria-hidden="true">◎</span><b>Instagram</b></a>
      {whatsappNumber && <a class="social-float__link social-float__whatsapp" href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Hi Nash, I would like to know more about coaching.')}`} target="_blank" rel="noreferrer" aria-label="Message FitWithNash on WhatsApp"><span aria-hidden="true">◔</span><b>WhatsApp</b></a>}
    </aside>
    <footer class="site-footer">
      <div><a class="brand" href="/"><span>FIT</span>WITHNASH</a><p>Strength, built for real life.</p></div>
      <div class="footer-links"><a href="#programs">Programs</a><a href="/contact">Contact</a><a href="https://www.instagram.com/fitwithnash/" target="_blank" rel="noreferrer">Instagram ↗</a></div>
      <small>© {new Date().getFullYear()} FitWithNash. Train responsibly.</small>
    </footer>
  </body>
</html>
