---
import '../styles/global.css';
import avinashProfile from '../assets/images/avinash-profile-real.png';

interface Props {
  title?: string;
  description?: string;
  bare?: boolean;
  noindex?: boolean;
}

const {
  title = 'FitWithNash | Personal Fitness Coaching in India',
  description = 'Personalised online fitness coaching, strength training and sustainable nutrition guidance for real life with FitWithNash.',
  bare = false,
  noindex = false,
} = Astro.props;
const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER?.replace(/\D/g, '') || '918360669905';
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://www.fitwithnash.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const socialImage = new URL(avinashProfile.src, siteUrl).href;
const organizationSchema = {
  '@context': 'https://schema.org', '@graph': [
    { '@type': 'ProfessionalService', '@id': `${siteUrl}/#business`, name: 'FitWithNash', url: siteUrl, image: socialImage, description, areaServed: { '@type': 'Country', name: 'India' }, sameAs: ['https://www.instagram.com/fitwithnash/'], contactPoint: { '@type': 'ContactPoint', telephone: `+${whatsappNumber}`, contactType: 'customer service', availableLanguage: ['English', 'Hindi'] }, knowsAbout: ['Online fitness coaching', 'Strength training', 'Fitness nutrition guidance', 'Lifestyle accountability'] },
    { '@type': 'Person', '@id': `${siteUrl}/#avinash`, name: 'Avinash Sharma', jobTitle: 'Fitness Coach', worksFor: { '@id': `${siteUrl}/#business` }, image: socialImage, sameAs: ['https://www.instagram.com/fitwithnash/'], knowsAbout: ['Strength training', 'Online fitness coaching', 'Sustainable nutrition habits'] },
    { '@type': 'WebSite', '@id': `${siteUrl}/#website`, url: siteUrl, name: 'FitWithNash', publisher: { '@id': `${siteUrl}/#business` }, inLanguage: 'en-IN', hasPart: { '@type': 'WebPage', name: 'FitWithNash Consultation', url: 'https://consult.fitwithnash.com/' } },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="theme-color" content="#10110f" />
    <link rel="icon" type="image/png" href={avinashProfile.src} />
    <link rel="apple-touch-icon" href={avinashProfile.src} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en-IN" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:site_name" content="FitWithNash" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <title>{title}</title>
  </head>
  <body>
    {!bare && <header class="site-header">
      <a class="brand" href="/" aria-label="FitWithNash home"><span>FIT</span>WITHNASH</a>
      <nav aria-label="Primary navigation">
        <a href="/#programs">Programs</a>
        <a href="/#method">The method</a>
        <a href="/#journeys">Journeys</a>
        <a href="https://consult.fitwithnash.com/">Consultation</a>
      </nav>
      <a class="header-cta" href="/contact">Start here <span aria-hidden="true">↗</span></a>
    </header>}
    <slot />
    {!bare && <aside class="social-float" aria-label="Quick contact">
      <a class="social-float__link social-float__instagram" href="https://www.instagram.com/fitwithnash/" target="_blank" rel="noreferrer" aria-label="Message FitWithNash on Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".9" class="fill"/></svg><b>Instagram</b></a>
      <a class="social-float__link social-float__whatsapp" href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Hi Nash, I would like to know more about coaching.')}`} target="_blank" rel="noreferrer" aria-label="Message FitWithNash on WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 11.8a8.3 8.3 0 0 1-12.2 7.3L3.5 20.5l1.4-4.6A8.3 8.3 0 1 1 20.5 11.8Z"/><path d="M8.5 7.8c.2-.4.4-.4.7-.4h.6c.2 0 .4.1.5.4l.7 1.7c.1.3.1.5 0 .7l-.5.6c-.1.2-.2.3 0 .5.5.9 1.3 1.6 2.2 2.1.2.1.3.1.5 0l.7-.8c.2-.2.4-.2.6-.1l1.7.8c.3.1.4.3.4.5 0 .7-.4 1.4-.8 1.6-.5.2-1.3.3-2.5-.2-1-.4-2.2-1.3-3.1-2.4-.8-.9-1.6-2.2-1.6-3.7 0-.8.4-1.5.8-1.7Z" class="fill"/></svg><b>WhatsApp</b></a>
    </aside>}
    {!bare && <footer class="site-footer">
      <div><a class="brand" href="/"><span>FIT</span>WITHNASH</a><p>Strength, built for real life.</p></div>
      <div class="footer-links"><a href="/#programs">Programs</a><a href="/transformations">Journeys</a><a href="https://consult.fitwithnash.com/">Consultation</a><a href="/contact">Contact</a><a href="https://www.instagram.com/fitwithnash/" target="_blank" rel="noreferrer">Instagram ↗</a></div>
      <small>© {new Date().getFullYear()} FitWithNash. Train responsibly.</small>
    </footer>}
  </body>
</html>
