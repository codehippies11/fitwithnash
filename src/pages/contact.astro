---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact FitWithNash | Online Fitness Coaching Consultation" description="Book a conversation with Avinash at FitWithNash about personalised online fitness coaching, strength training and practical nutrition habits.">
  <main class="contact-page">
    <section class="section contact-grid">
      <div>
        <p class="eyebrow">Your next rep starts here</p>
        <h1 class="display">Ready for a standard you can keep?</h1>
        <p class="contact-intro">Tell me what you are working toward. I’ll point you to the right place to begin.</p>
        <a class="instagram-link" href="https://www.instagram.com/fitwithnash/" target="_blank" rel="noreferrer">Or message @fitwithnash on Instagram ↗</a>
      </div>
      <form class="lead-form" method="post" action="#" data-lead-form>
        <label>Your name<input name="name" autocomplete="name" required placeholder="Name" /></label>
        <label>Email address<input name="email" type="email" autocomplete="email" required placeholder="you@example.com" /></label>
        <label>What are you working toward?<select name="goal"><option>Strength and confidence</option><option>Build muscle</option><option>Fat loss and habits</option><option>Coaching or collaboration</option></select></label>
        <label>Anything else?<textarea name="message" rows="4" placeholder="Your starting point, training history, schedule…"></textarea></label>
        <button class="button" type="submit">Send my note <span>→</span></button>
      </form>
    </section>
  </main>
</Layout>

<style>
  .contact-page { min-height:100vh; padding-top:60px; background:radial-gradient(circle at 85% 0, #3d4823 0, transparent 29%),var(--ink); }
  .contact-grid { display:grid; grid-template-columns:1fr .86fr; gap:clamp(35px,10vw,150px); align-items:start; }.contact-grid .display { margin-top:16px; font-size:clamp(3.2rem,7vw,7rem); }.contact-intro { max-width:470px; color:var(--muted); line-height:1.7; }.instagram-link { display:inline-block; margin-top:28px; color:var(--lime); border-bottom:1px solid var(--lime); }.lead-form { display:grid; gap:22px; padding:clamp(25px,4vw,48px); background:#20231e; }.lead-form label { display:grid; gap:9px; color:#d8d9d2; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; }.lead-form input,.lead-form select,.lead-form textarea { width:100%; padding:13px 0; color:var(--paper); background:transparent; border:0; border-bottom:1px solid var(--line); border-radius:0; font:16px Manrope,sans-serif; outline:none; }.lead-form select { color:#d8d9d2; }.lead-form option { color:var(--ink); }.lead-form input:focus,.lead-form textarea:focus { border-color:var(--lime); }.form-note { margin:0; color:var(--muted); font-size:11px; line-height:1.5; } @media(max-width:760px){.contact-grid{grid-template-columns:1fr;}}
</style>
