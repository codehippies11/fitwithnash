---
import avinashProfile from '../assets/images/avinash-profile-premium.webp';
import avinashCoaching from '../assets/images/avinash-coaching.png';
import transformation01 from '../assets/images/transformations/curated/transformation-01.jpeg';
import transformation02 from '../assets/images/transformations/curated/transformation-02.jpeg';
import transformation04 from '../assets/images/transformations/curated/transformation-04.jpeg';
import transformation05 from '../assets/images/transformations/curated/transformation-05.jpeg';
import transformation06 from '../assets/images/transformations/curated/transformation-06.jpeg';
import transformation07 from '../assets/images/transformations/curated/transformation-07.jpeg';
import transformation08 from '../assets/images/transformations/curated/transformation-08.jpeg';
import transformation09 from '../assets/images/transformations/curated/transformation-09.jpeg';
import transformation10 from '../assets/images/transformations/curated/transformation-10.jpeg';
import transformation11 from '../assets/images/transformations/curated/transformation-11.jpeg';
import transformation12 from '../assets/images/transformations/curated/transformation-12.jpeg';
import transformation15 from '../assets/images/transformations/curated/transformation-15.jpeg';
import arunJourney from '../assets/images/journeys/arun-journey.png';
import krishamJourney from '../assets/images/journeys/krisham-journey.png';
import fitwithnashMark from '../assets/brand/fit-with-nash-header.svg';
import TestimonialWall from '../components/TestimonialWall.astro';
import { verifiedTestimonials } from '../data/verifiedTestimonials';
import { Image } from 'astro:assets';

const whatsapp = 'https://wa.me/918360669905?text=Hi%20Avinash%2C%20I%20would%20like%20to%20book%20a%20FitWithNash%20coaching%20clarity%20call.';
const base = import.meta.env.PUBLIC_SUPABASE_URL;
const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
let media: Record<string, string> = {};
let cmsPrograms: any[] = [];
let cmsTestimonials: any[] = [];
if (base && key) {
  const headers = { apikey: key, Authorization: `Bearer ${key}` };
  const [mediaResponse, programsResponse, testimonialsResponse] = await Promise.all([
    fetch(`${base}/rest/v1/site_media?select=key,image_url`, { headers }),
    fetch(`${base}/rest/v1/programs?is_published=eq.true&select=*&order=sort_order.asc,created_at.asc`, { headers }),
    fetch(`${base}/rest/v1/testimonials?is_published=eq.true&select=*&order=sort_order.asc,created_at.asc`, { headers }),
  ]);
  if (mediaResponse.ok) media = Object.fromEntries((await mediaResponse.json()).map((item: { key: string; image_url: string }) => [item.key, item.image_url]));
  if (programsResponse.ok) cmsPrograms = await programsResponse.json();
  if (testimonialsResponse.ok) cmsTestimonials = await testimonialsResponse.json();
}
const portrait = media.consult_coach_portrait || media.hero_portrait || avinashProfile.src;
const portraitUrl = /^https?:\/\//.test(portrait) ? portrait : new URL(portrait, 'https://consult.fitwithnash.com').href;
const socialPreview = new URL(avinashCoaching.src, 'https://consult.fitwithnash.com').href;
const transformations = [
  { image: transformation01, alt: 'FitWithNash client before and after body recomposition' },
  { image: transformation02, alt: 'FitWithNash client before and after strength transformation' },
  { image: transformation04, alt: 'FitWithNash client before and after physique transformation' },
  { image: transformation05, alt: 'FitWithNash client before and after muscle-building journey' },
  { image: transformation06, alt: 'FitWithNash client before and after lean strength journey' },
  { image: transformation07, alt: 'FitWithNash client before and after body-composition progress' },
  { image: transformation08, alt: 'FitWithNash client before and after muscular development' },
  { image: transformation09, alt: 'FitWithNash client before and after sustainable fat-loss journey' },
  { image: transformation10, alt: 'FitWithNash client side-profile body transformation' },
  { image: transformation11, alt: 'FitWithNash client side-profile fitness transformation' },
  { image: transformation12, alt: 'FitWithNash client eight-week strength and physique transformation' },
  { image: arunJourney, alt: "Arun's original paired before-and-after FitWithNash transformation", name: 'Arun' },
  { image: krishamJourney, alt: "Krisham's original paired before-and-after FitWithNash transformation", name: 'Krisham' },
  { image: transformation15, alt: 'Original paired before-and-after FitWithNash client transformation' },
];
const featuredTransformationIndices = new Set([0, 1, 13]);
const transformationHeadlines = new Map([
  [0, 'Strength, revealed.'],
  [1, 'Consistency, made visible.'],
  [13, 'A healthier standard.'],
]);
const transformationPortfolio = transformations.map((transformation, index) => ({
  ...transformation,
  position: index + 1,
  headline: transformationHeadlines.get(index),
}));
const transformationArchive = transformationPortfolio.filter((_, index) => index !== 0);
const feedbackStories = Array.from(new Map(
  [...verifiedTestimonials, ...cmsTestimonials].map((item) => {
    const clientKey = String(item.client_name || '').trim().toLowerCase();
    return [clientKey ? `client:${clientKey}` : item.id || `${item.image_url || ''}|${item.quote || ''}`, item];
  }),
).values());
const feedbackPriority = ['prakhar', 'vipan kashyap'];
const feedbackStoriesSorted = [
  ...feedbackPriority
    .map((name) => feedbackStories.find((item) => String(item.client_name || '').trim().toLowerCase() === name))
    .filter(Boolean),
  ...feedbackStories.filter((item) => !feedbackPriority.includes(String(item.client_name || '').trim().toLowerCase())),
];
const packages = cmsPrograms.length ? cmsPrograms : [
  { label: 'Personal coaching', title: 'The Personal Standard.', description: 'Personalised training, practical nutrition and regular accountability around your real life.', price: 'Ask Avinash for the right fit' },
  { label: 'Focused transformation', title: '12 Weeks, Built Properly.', description: 'A focused block to build momentum with a structure you can understand and repeat.', price: 'Ask Avinash for the right fit' },
];
const steps = [
  ['01', 'Clarity & assessment', 'We start with your goal, schedule, training history and the constraints your real life brings.'],
  ['02', 'Your personal system', 'You receive training direction, practical nutrition habits and a progression you understand.'],
  ['03', 'Accountability that adapts', 'Weekly check-ins keep the plan honest as work, travel and life change around you.'],
];
const consultationFaqs = [
  ['Who is Avinash Sharma at FitWithNash?', 'Avinash Sharma is the internationally trained, INFS- and NESTA-certified nutritionist and body-transformation coach behind FitWithNash. His nutrition studies span Canada and Texas, and his work brings practical, culturally familiar food habits into personalised coaching for modern Indian life.'],
  ['What does FitWithNash 1:1 fitness coaching include?', 'Each coaching relationship starts with your goals, training history, schedule and food preferences. You receive personalised training direction, practical nutrition guidance and regular accountability.'],
  ['Can I work with an online fitness coach while travelling or working long hours?', 'Yes. FitWithNash coaching is designed around real workdays, travel and family commitments, with a plan that adapts as your schedule changes.'],
  ['Is this coaching for weight loss or muscle building?', 'The coaching can support sustainable fat loss, strength, muscle building and healthier routines. Your plan is built around your starting point and priorities rather than a generic template.'],
  ['Does FitWithNash provide dietitian and nutritionist guidance?', 'Yes. Avinash provides personalised nutrition guidance that focuses on repeatable food choices, sufficient protein, meal structure and flexible eating—not extreme restriction or a plan that leaves you constantly craving food. Diagnosis, prescription changes and urgent medical concerns should still be managed with the appropriate treating clinician.'],
  ['Who is online fitness coaching best suited for?', 'It is most useful for adults who value a clear plan, honest feedback and a coach who can adjust training around a real calendar. It is not a substitute for medical assessment, diagnosis or treatment.'],
];
const consultSchema = {
  '@context': 'https://schema.org', '@graph': [
    { '@type': 'WebSite', '@id': 'https://consult.fitwithnash.com/#website', url: 'https://consult.fitwithnash.com/', name: 'FitWithNash', inLanguage: 'en-IN', publisher: { '@id': 'https://consult.fitwithnash.com/#business' } },
    { '@type': 'WebPage', '@id': 'https://consult.fitwithnash.com/#webpage', url: 'https://consult.fitwithnash.com/', name: 'Avinash Sharma | Private Dietitian & Nutritionist | FitWithNash', description: 'Private, personalised nutrition and body-composition coaching with Avinash Sharma for professionals seeking precise guidance, familiar food and durable results.', inLanguage: 'en-IN', isPartOf: { '@id': 'https://consult.fitwithnash.com/#website' }, about: [{ '@id': 'https://consult.fitwithnash.com/#avinash-sharma' }, { '@id': 'https://consult.fitwithnash.com/#service' }], mainEntity: { '@id': 'https://consult.fitwithnash.com/#service' } },
    { '@type': 'ProfessionalService', '@id': 'https://consult.fitwithnash.com/#business', name: 'FitWithNash', alternateName: 'Fit With Nash', url: 'https://consult.fitwithnash.com/', logo: 'https://consult.fitwithnash.com/favicon.svg', image: portraitUrl, description: 'Private online dietitian, nutrition and body-composition coaching with Avinash Sharma, designed around real schedules, food preferences and long-term standards.', founder: { '@id': 'https://consult.fitwithnash.com/#avinash-sharma' }, sameAs: ['https://www.instagram.com/fitwithnash/'] },
    { '@type': 'Service', '@id': 'https://consult.fitwithnash.com/#service', name: 'FitWithNash Dietitian, Nutrition & Body Transformation Coaching', serviceType: 'Dietitian-led nutrition guidance, personal training, strength coaching and body transformation coaching', provider: { '@id': 'https://consult.fitwithnash.com/#business' }, areaServed: [{ '@type': 'Country', name: 'India' }, { '@type': 'Place', name: 'Online' }], audience: { '@type': 'Audience', audienceType: 'Adults seeking personalised nutrition, fitness coaching, sustainable weight loss or muscle building' }, offers: { '@type': 'OfferCatalog', name: 'FitWithNash coaching offers', itemListElement: packages.map((item, position) => ({ '@type': 'Offer', position: position + 1, name: item.title, description: item.description, url: 'https://consult.fitwithnash.com/' })) } },
    { '@type': 'Person', '@id': 'https://consult.fitwithnash.com/#avinash-sharma', name: 'Avinash Sharma', url: 'https://consult.fitwithnash.com/#avinash-sharma', image: portraitUrl, jobTitle: 'Dietitian, Nutritionist & Body Transformation Coach', description: 'Avinash Sharma is the internationally trained, INFS- and NESTA-certified nutritionist and body-transformation coach behind FitWithNash. His nutrition studies span Canada and Texas.', hasCredential: [{ '@type': 'EducationalOccupationalCredential', name: 'INFS Certified Nutritionist', credentialCategory: 'Nutrition certification' }, { '@type': 'EducationalOccupationalCredential', name: 'NESTA Certified Nutritionist', credentialCategory: 'Nutrition certification' }], worksFor: { '@id': 'https://consult.fitwithnash.com/#business' }, knowsAbout: ['Dietetics', 'Nutrition guidance', 'Strength training', 'Online personal training', 'Body transformation coaching', 'Sustainable weight management', 'Practical nutrition habits', 'Accountability coaching'], sameAs: ['https://www.instagram.com/fitwithnash/'] },
    { '@type': 'FAQPage', '@id': 'https://consult.fitwithnash.com/#faq', mainEntity: consultationFaqs.map(([question, answer]) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Avinash Sharma | Private Dietitian & Nutritionist | FitWithNash</title>
    <meta name="description" content="Private nutrition and body-composition coaching for professionals who value precise guidance, familiar food and a standard they can sustain. Consult Avinash Sharma." />
    <meta name="keywords" content="Avinash Sharma dietitian, Avinash Sharma nutritionist, Avinash Sharma fitness coach, FitWithNash, online dietitian India, online nutritionist, body transformation coach, weight loss nutrition guidance, online personal training" />
    <meta name="author" content="Avinash Sharma, FitWithNash" />
    <meta name="robots" content="index,follow" />
    <meta name="googlebot" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <meta name="theme-color" content="#f03212" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <link rel="shortcut icon" href="/favicon.svg" />
    <link rel="apple-touch-icon" href={avinashProfile.src} />
    <link rel="canonical" href="https://consult.fitwithnash.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FitWithNash" />
    <meta property="og:title" content="Avinash Sharma | Private Dietitian & Nutritionist" />
    <meta property="og:description" content="Private nutrition and body-composition coaching built around real schedules, familiar food and durable standards." />
    <meta property="og:url" content="https://consult.fitwithnash.com/" />
    <meta property="og:image" content={socialPreview} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="FitWithNash private nutrition and body-composition coaching with Avinash Sharma" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Avinash Sharma | Private Dietitian & Nutritionist" />
    <meta name="twitter:description" content="Private nutrition and body-composition coaching built around real schedules, familiar food and durable standards." />
    <meta name="twitter:image" content={socialPreview} />
    <meta name="twitter:image:alt" content="FitWithNash private nutrition and body-composition coaching with Avinash Sharma" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,600;1,700&family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(consultSchema)} />
  </head>
  <body>
    <main>
      <section class="hero section">
        <a class="hero-wordmark" href="https://www.fitwithnash.com/" aria-label="FitWithNash home">FIT<span>WITH</span>NASH</a>
        <a class="brand-logo" href="https://www.fitwithnash.com/" aria-label="FitWithNash home"><img src={fitwithnashMark.src} alt="" /><span>FitWithNash</span></a>
        <div class="coach-ring"><img src={portrait} alt="Avinash Sharma, FitWithNash coach" /></div>
        <p class="kicker">Internationally trained dietitian & nutritionist / private 1:1 coaching</p>
        <h1>Build a stronger body<br />without putting your <em>life</em> on pause.</h1>
        <p class="hero-copy">I help ambitious professionals build strength, lose excess body fat and create a routine they can keep—even with demanding workdays, travel and family commitments.</p>
        <div class="hero-actions"><a class="cta cta--book" href={whatsapp} target="_blank" rel="noreferrer">Request a private clarity call <span>→</span></a><a class="hero-proof-link" href="#proof"><span>↓</span> See real client proof</a></div>
        <div class="hero-signals" aria-label="FitWithNash coaching principles"><span>Personal training</span><span>Practical nutrition</span><span>Direct accountability</span></div>
        <p class="micro">A focused conversation. No pressure. We begin with your real context.</p>
      </section>

      <section class="transformation-showcase" id="proof" aria-labelledby="transformation-heading">
        <div class="transformation-showcase__intro section">
          <p class="transformation-showcase__index" aria-hidden="true">FWN / RESULTS</p>
          <div>
            <p class="kicker">Real client transformations</p>
            <h2 id="transformation-heading">The work.<br /><em>Made visible.</em></h2>
          </div>
          <p class="transformation-showcase__lead">No stock bodies. No borrowed stories. A record of clients who trained, adapted and kept showing up—built through personal coaching that respects real life.</p>
        </div>

        <div class="transformation-showcase__portfolio">
          <aside class="result-collage" aria-labelledby="result-collage-title">
            <div class="result-collage__wall">
              <div class="result-collage__mosaic" aria-label="Wall of original FitWithNash client transformations">
                {transformationPortfolio.map((transformation) => (
                  <button
                    class="result-collage__frame"
                    type="button"
                    data-proof-view
                    data-proof-src={transformation.image.src}
                    data-proof-alt={transformation.alt}
                    data-proof-label={transformation.name || 'Original client transformation'}
                    aria-label={`View ${transformation.name || 'original client transformation'} in full`}
                  >
                    <Image
                      src={transformation.image}
                      alt={transformation.alt}
                      widths={[240, 360, 480]}
                      sizes="(max-width: 800px) 0px, 15vw"
                      format="webp"
                      quality={84}
                      loading="lazy"
                    />
                  </button>
                ))}
              </div>
              <div class="result-collage__overlay">
                <p class="result-collage__eyebrow">The private portfolio</p>
                <h3 id="result-collage-title">Quiet work.<br /><em>Loud results.</em></h3>
                <p class="result-collage__standfirst">Original client records. Select any frame to inspect the full result.</p>
              </div>
            </div>
          </aside>

          <div class="transformation-archive" aria-labelledby="transformation-archive-title">
            <div class="transformation-archive__header">
              <div><p class="kicker">The result archive</p><h3 id="transformation-archive-title">Every journey remains visible.</h3></div>
            </div>
            <div class="transformation-archive__stage" data-transformation-stage>
              <div class="transformation-rail" aria-label="Scrollable archive of FitWithNash client transformations" data-transformation-track tabindex="0">
                {transformationArchive.map((transformation, index) => (
                <figure class:list={['result-thumb', featuredTransformationIndices.has(transformation.position - 1) && 'result-thumb--featured-copy']} role="group" aria-roledescription="slide" aria-label={`${transformation.name || 'Client transformation'}, result ${index + 1} of ${transformationArchive.length}`} data-transformation-card>
                  <button
                    class="result-thumb__open"
                    type="button"
                    data-proof-view
                    data-proof-src={transformation.image.src}
                    data-proof-alt={transformation.alt}
                    data-proof-label={transformation.name || 'Original client transformation'}
                    aria-label={`View ${transformation.name || 'original client transformation'} in full`}
                  >
                    <Image
                      src={transformation.image}
                      alt={transformation.alt}
                      widths={[320, 480, 768]}
                      sizes="(max-width: 800px) 76vw, (max-width: 1200px) 32vw, 420px"
                      format="webp"
                      quality={88}
                      loading="lazy"
                    />
                    <span>Open result <b aria-hidden="true">↗</b></span>
                  </button>
                  <figcaption><span>FitWithNash result</span><b>{transformation.name || 'Client transformation'}</b></figcaption>
                </figure>
              ))}
              </div>
              <div class="transformation-rail__controls" aria-label="Transformation carousel navigation">
                <button type="button" data-transformation-previous aria-label="Show previous transformation"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6" /></svg></button>
                <button type="button" data-transformation-next aria-label="Show next transformation"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></button>
              </div>
              <div class="transformation-rail__progress" aria-hidden="true"><span data-transformation-progress></span></div>
            </div>
          </div>
        </div>

        <div class="transformation-showcase__close section">
          <div><span>Discipline changes shape.</span><strong>Your starting point can, too.</strong></div>
          <a class="cta cta--book" href={whatsapp} target="_blank" rel="noreferrer">Discuss your starting point <span>→</span></a>
          <small>Individual results vary. No specific outcome is guaranteed.</small>
        </div>
      </section>

      <section class="feedback-proof section" aria-labelledby="client-proof-heading">
        <div class="feedback-proof__intro"><div><p class="kicker">Original client proof</p><h2 id="client-proof-heading">Real words.<br /><em>Real standards.</em></h2></div><p>Original reviews from people coached around real workdays, familiar food and life beyond the gym. Read the excerpt, then open the client’s original review.</p></div>
        <p class="feedback-proof__assurance"><span>Original review screenshots</span> · tap any proof to inspect the full record.</p>
        <div class="feedback-proof__stage"><TestimonialWall testimonials={feedbackStoriesSorted} tone="dark" layout="carousel" label="Original FitWithNash client reviews" /></div>
        <div class="feedback-proof__close"><p>Your context will be different. The coaching standard will not.</p><a class="cta cta--book" href={whatsapp} target="_blank" rel="noreferrer">Discuss your starting point <span>→</span></a></div>
      </section>

      <dialog class="proof-viewer" data-proof-viewer aria-labelledby="proof-viewer-title">
        <div class="proof-viewer__surface">
          <div class="proof-viewer__bar"><p id="proof-viewer-title" data-proof-viewer-label>Original client proof</p><button type="button" data-proof-close aria-label="Close proof viewer">Close <span aria-hidden="true">×</span></button></div>
          <div class="proof-viewer__canvas"><img data-proof-viewer-image alt="" /></div>
        </div>
      </dialog>

      <section class="decision section">
        <div><p class="kicker">A better first step</p><h2>You do not need to have it all figured out before you <em>start.</em></h2><p>Most people arrive with a goal and a lot of noise: conflicting advice, an inconsistent routine or the feeling that they should be further ahead. That is exactly where the conversation begins.</p></div>
        <div class="decision-grid"><article><b>01</b><h3>Bring the real context.</h3><p>Your schedule, food preferences, gym access and past attempts matter. There is no one-size-fits-all script here.</p></article><article><b>02</b><h3>Leave with a clear next move.</h3><p>You will understand the practical priority: what to focus on now, what can wait and whether coaching is the right support.</p></article><article><b>03</b><h3>Decide without pressure.</h3><p>The call is a fit check, not a hard sell. Great coaching begins with clarity on both sides.</p></article></div>
      </section>

      <section class="concierge section">
        <div class="concierge__intro"><p class="kicker">The private coaching standard</p><h2>A plan that respects<br />your <em>time.</em></h2><p>High performance is not about making fitness harder. It is about removing the friction between the person you want to become and the calendar you already have.</p><a class="cta cta--book" href={whatsapp} target="_blank" rel="noreferrer">Talk to Avinash privately <span>→</span></a></div>
        <div class="concierge__grid" aria-label="Private coaching experience"><article><span>01</span><h3>Built around your calendar</h3><p>Work, travel, family and food preferences are inputs—not excuses to work around later.</p></article><article><span>02</span><h3>Clear decisions, not more noise</h3><p>Your effort goes into the few actions that move your health, strength and confidence forward.</p></article><article><span>03</span><h3>Coaching that stays close</h3><p>Regular check-ins make sure the plan evolves before a busy week becomes a restart.</p></article><article class="concierge__note"><b>Private by design</b><p>FitWithNash is for people who value thoughtful coaching, honest feedback and a standard they can sustain.</p></article></div>
      </section>

      <section class="coach section">
        <div class="coach-image"><img src={portrait} alt="Avinash Sharma" /></div>
        <div><p class="kicker">— Meet your dietitian & coach</p><h2>Hey, I’m <em class="coach-name">Avinash.</em></h2><p class="role">INFS & NESTA-certified nutritionist · body-transformation coach</p><p>My nutrition studies span Canada and Texas. Today, my work is focused on changing everyday Indian food habits without making food, family meals or a busy schedule feel like the enemy.</p><p>Most people do not need a more extreme plan. They need an intelligent one: training that meets them where they are, food habits they can actually repeat, and someone who helps them stop restarting.</p><a class="text-link" href="https://www.instagram.com/fitwithnash/" target="_blank" rel="noreferrer">Follow the work on Instagram ↗</a></div>
      </section>

      <section class="coach-profile section" id="avinash-sharma" aria-labelledby="avinash-profile-title">
        <div><p class="kicker">— About Avinash Sharma</p><h2 id="avinash-profile-title">Nutrition-led coaching,<br />with practical <em>discipline.</em></h2></div>
        <div class="coach-profile__copy"><p>Avinash Sharma is the internationally trained, INFS- and NESTA-certified nutritionist and coach behind FitWithNash. His work is for adults who prefer a reasoned plan over fitness theatre: progressive training, food habits that can survive a busy week, and regular review before small setbacks become a complete restart.</p><p>His nutrition education spans Canada and Texas; his current mission is making healthier daily Indian habits realistic, culturally familiar and sustainable. The programme begins with the person in front of it—their training history, schedule, food preferences, recovery and priorities—then adjusts as that life changes.</p></div>
        <div class="coach-profile__topics" aria-label="FitWithNash coaching areas">
          <article id="online-fitness-coaching"><span>01</span><h3>Online fitness coaching</h3><p>Clear training direction and regular review for people who need their plan to travel well, work around real deadlines and remain intelligible outside the gym.</p></article>
          <article id="strength-training"><span>02</span><h3>Strength & body composition</h3><p>Progressive resistance training, measured against useful markers: performance, consistency, confidence and a physique built through patient work.</p></article>
          <article id="nutrition-guidance"><span>03</span><h3>Dietitian-led nutrition guidance</h3><p>Simple meal structure, protein awareness and flexible food choices—without presenting restriction as expertise or routine as punishment.</p></article>
        </div>
        <p class="coach-profile__note">Fitness coaching supports habits and training decisions. For injury, pregnancy, eating concerns or a medical condition, seek advice from an appropriately qualified healthcare professional.</p>
      </section>

      <section class="method section">
        <p class="kicker">— The framework</p><h2>The <em class="method-name">Avinash Method</em></h2><p class="method-intro">A practical coaching framework that builds a result your schedule can support.</p>
        <div class="phase-grid">
          <article class="phase-card phase-card--foundation"><span class="phase-card__symbol" aria-hidden="true">◎</span><h3>Foundation</h3><p>We establish your baseline: movement, routine, recovery and a starting point you can own.</p></article>
