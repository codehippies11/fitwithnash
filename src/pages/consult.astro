---
import avinashProfile from '../assets/images/avinash-profile-real.png';
import arunJourney from '../assets/images/journeys/arun-journey.png';
import krishamJourney from '../assets/images/journeys/krisham-journey.png';
import farbeenaJourney from '../assets/images/journeys/farbeena-journey.png';
import krishamFeedback from '../assets/images/testimonials/krisham-feedback.jpg';
import ishanaFeedback from '../assets/images/testimonials/ishana-feedback.jpg';
import ankitaFeedback from '../assets/images/testimonials/ankita-feedback.jpg';

const whatsapp = 'https://wa.me/918360669905?text=Hi%20Avinash%2C%20I%20would%20like%20to%20book%20a%20FitWithNash%20coaching%20clarity%20call.';
const base = import.meta.env.PUBLIC_SUPABASE_URL;
const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
let media: Record<string, string> = {};
let cmsPrograms: any[] = [];
if (base && key) {
  const headers = { apikey: key, Authorization: `Bearer ${key}` };
  const [mediaResponse, programsResponse] = await Promise.all([
    fetch(`${base}/rest/v1/site_media?select=key,image_url`, { headers }),
    fetch(`${base}/rest/v1/programs?is_published=eq.true&select=*&order=sort_order.asc,created_at.asc`, { headers }),
  ]);
  if (mediaResponse.ok) media = Object.fromEntries((await mediaResponse.json()).map((item: { key: string; image_url: string }) => [item.key, item.image_url]));
  if (programsResponse.ok) cmsPrograms = await programsResponse.json();
}
const portrait = media.consult_coach_portrait || media.hero_portrait || avinashProfile.src;
const journeys = [
  { image: media.consult_journey_arun || media.home_journey_arun || arunJourney.src, name: 'Arun', result: 'A phased transformation built through patient work.' },
  { image: media.consult_journey_krisham || media.home_journey_krisham || krishamJourney.src, name: 'Krisham', result: 'Consistency and a stronger routine, made visible.' },
  { image: media.consult_journey_farbeena || media.home_journey_farbeena || farbeenaJourney.src, name: 'Farbeena', result: 'Strength, energy and confidence back in the picture.' },
];
const feedbackStories = [
  { image: krishamFeedback.src, name: 'Krisham Malhotra', label: 'Client testimonial' },
  { image: ishanaFeedback.src, name: 'Ishana', label: 'Client feedback' },
  { image: ankitaFeedback.src, name: 'Ankita Takkar', label: 'Client testimonial' },
];
const packages = cmsPrograms.length ? cmsPrograms : [
  { label: 'Personal coaching', title: 'The Personal Standard.', description: 'Personalised training, practical nutrition and regular accountability around your real life.', price: 'Ask Avinash for the right fit' },
  { label: 'Focused transformation', title: '12 Weeks, Built Properly.', description: 'A focused block to build momentum with a structure you can understand and repeat.', price: 'Ask Avinash for the right fit' },
];
const steps = [
  ['01', 'Clarity & assessment', 'We start with your goal, schedule, training history and the constraints your real life brings.'],
  ['02', 'Your personal system', 'You receive training direction, practical nutrition habits and a progression you understand.'],
  ['03', 'Accountability that adapts', 'Weekly check-ins keep the plan honest as work, travel and life change around you.'],
];
const consultSchema = {
  '@context': 'https://schema.org', '@graph': [
    { '@type': 'WebPage', '@id': 'https://consult.fitwithnash.com/#webpage', url: 'https://consult.fitwithnash.com/', name: 'FitWithNash Consultation | Personal Fitness Coaching', description: 'Book a FitWithNash coaching clarity call for personalised training, practical nutrition and accountability.', inLanguage: 'en-IN', about: { '@id': 'https://www.fitwithnash.com/#business' }, mainEntity: { '@id': 'https://consult.fitwithnash.com/#service' } },
    { '@type': 'Service', '@id': 'https://consult.fitwithnash.com/#service', name: 'FitWithNash Online Fitness Coaching', serviceType: 'Online fitness coaching', provider: { '@id': 'https://www.fitwithnash.com/#business' }, areaServed: { '@type': 'Country', name: 'India' }, audience: { '@type': 'Audience', audienceType: 'Adults seeking personalised fitness coaching' }, offers: { '@type': 'OfferCatalog', name: 'FitWithNash coaching offers', itemListElement: packages.map((item, position) => ({ '@type': 'Offer', position: position + 1, name: item.title, description: item.description, url: 'https://consult.fitwithnash.com/' })) } },
    { '@type': 'Person', '@id': 'https://www.fitwithnash.com/#avinash', name: 'Avinash Sharma', jobTitle: 'Fitness Coach', sameAs: ['https://www.instagram.com/fitwithnash/'] },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>FitWithNash Consultation | Personal Fitness Coaching</title>
    <meta name="description" content="Book a FitWithNash coaching clarity call. Personalised training, practical nutrition and accountability for ambitious people with real schedules." />
    <meta name="robots" content="index,follow" />
    <link rel="icon" type="image/png" href={avinashProfile.src} />
    <link rel="apple-touch-icon" href={avinashProfile.src} />
    <link rel="canonical" href="https://consult.fitwithnash.com/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(consultSchema)} />
  </head>
  <body>
    <main>
      <section class="hero section">
        <a class="brand" href="https://www.fitwithnash.com/">FIT<span>WITH</span>NASH</a>
        <div class="coach-ring"><img src={portrait} alt="Avinash Sharma, FitWithNash coach" /></div>
        <p class="kicker">Private online coaching / built for real life</p>
        <h1>Build a stronger body<br />without putting your <em>life</em> on pause.</h1>
        <p class="hero-copy">I help ambitious professionals build strength, lose excess body fat and create a routine they can keep—even with demanding workdays, travel and family commitments.</p>
        <a class="cta" href={whatsapp} target="_blank" rel="noreferrer">Book your coaching clarity call <span>→</span></a>
        <p class="micro">A focused conversation. No pressure. Start with clarity.</p>
      </section>

      <section class="proof section" id="proof">
        <p class="kicker">— Real client proof</p>
        <h2>What changes when<br />the plan finally <em>fits.</em></h2>
        <p class="proof-lead">There is no stock imagery here. These are original FitWithNash client journeys: real starting points, real consistency and outcomes built around real life.</p>
        <div class="story-grid">{journeys.map((journey) => <article><img src={journey.image} alt={`${journey.name}'s FitWithNash before-and-after journey`} loading="lazy" /><div><span>Original paired photo</span><h3>{journey.name}</h3><p>{journey.result}</p></div></article>)}</div>
        <div class="proof-cta"><a class="cta light" href={whatsapp} target="_blank" rel="noreferrer">Talk through your starting point <span>→</span></a><small>Individual results vary. No specific outcome is guaranteed.</small></div>
      </section>

      <section class="feedback-proof section">
        <div class="feedback-proof__intro"><p class="kicker">— In their own words</p><h2>The kind of support<br />people <em>feel.</em></h2><p>Proof is not only a photo. It is the confidence to ask questions, the support to keep going and a plan that can adapt when life does.</p></div>
        <div class="feedback-proof__grid">{feedbackStories.map((story) => <article><div class="feedback-proof__image"><img src={story.image} alt={`${story.label} from ${story.name}`} loading="lazy" /></div><p>{story.label} / {story.name}</p></article>)}</div>
      </section>

      <section class="decision section">
        <div><p class="kicker">A better first step</p><h2>You do not need to have it all figured out before you <em>start.</em></h2><p>Most people arrive with a goal and a lot of noise: conflicting advice, an inconsistent routine or the feeling that they should be further ahead. That is exactly where the conversation begins.</p></div>
        <div class="decision-grid"><article><b>01</b><h3>Bring the real context.</h3><p>Your schedule, food preferences, gym access and past attempts matter. There is no one-size-fits-all script here.</p></article><article><b>02</b><h3>Leave with a clear next move.</h3><p>You will understand the practical priority: what to focus on now, what can wait and whether coaching is the right support.</p></article><article><b>03</b><h3>Decide without pressure.</h3><p>The call is a fit check, not a hard sell. Great coaching begins with clarity on both sides.</p></article></div>
      </section>

      <section class="coach section">
        <div class="coach-image"><img src={portrait} alt="Avinash Sharma" /></div>
        <div><p class="kicker">— Meet your coach</p><h2>Hey, I’m <em>Avinash.</em></h2><p class="role">FitWithNash strength & lifestyle coach</p><p>Most people do not need a more extreme plan. They need an intelligent one: training that meets them where they are, food habits they can actually repeat, and someone who helps them stop restarting.</p><p>My coaching is designed for people who want to feel capable in the gym and confident outside it—not just chase a temporary result.</p><a class="text-link" href="https://www.instagram.com/fitwithnash/" target="_blank" rel="noreferrer">Follow the work on Instagram ↗</a></div>
      </section>

      <section class="method section">
        <p class="kicker">— The framework</p><h2>The <em>Avinash Method</em></h2><p class="method-intro">A practical coaching framework that builds a result your schedule can support.</p>
        <div class="phase-grid">
          <article><b>01</b><h3>Foundation</h3><p>We establish your baseline: movement, routine, recovery and a starting point you can own.</p></article>
          <article><b>02</b><h3>Strength</h3><p>Progressive training builds confidence, capability and a physique shaped by quality work.</p></article>
          <article><b>03</b><h3>Nutrition</h3><p>Simple, flexible nutrition habits support your goal without turning food into another full-time job.</p></article>
          <article><b>04</b><h3>Integration</h3><p>We adapt the plan around travel, long workdays and the routines that make results last.</p></article>
          <article class="accountability-phase"><b>05</b><h3>Accountability</h3><p>Regular check-ins turn good intentions into measurable actions and honest progress.</p></article>
        </div>
      </section>

      <section class="packages section">
        <p class="kicker">Choose your support</p><h2>Coaching offers that fit the work you are ready to do.</h2><p class="packages-intro">Every offer is built around a real starting point—not a generic template. Pick the direction that feels right, then talk it through with Avinash.</p>
        <div class="package-grid">{packages.map((item) => <article>{item.image_url && <img src={item.image_url} alt="" loading="lazy" />}<p>{item.label}</p><h3>{item.title}</h3><span>{item.description}</span><strong>{item.price}</strong><a href={whatsapp} target="_blank" rel="noreferrer">Ask about this offer →</a></article>)}</div>
      </section>

      <section class="how section">
        <div><p class="kicker">How 1:1 coaching works</p><h2>Three steps to a body you can <em>trust.</em></h2></div>
        <div class="steps">{steps.map(([number, title, text]) => <article><b>{number}</b><h3>{title}</h3><p>{text}</p></article>)}</div>
        <a class="cta" href={whatsapp} target="_blank" rel="noreferrer">Book your clarity call <span>→</span></a>
      </section>

      <section class="fit section">
        <div><p class="kicker">Who this is for</p><h2>This is not another generic program.</h2><p>It is a personal system for people ready to build strength around the life they already lead.</p></div>
        <div class="fit-grid"><article><h3>This is for you if:</h3><ul><li>You want a clear fitness direction instead of saving more random workouts.</li><li>You want to get stronger, leaner and more confident without extreme rules.</li><li>You have a busy schedule and need coaching that adapts to it.</li><li>You are ready to show up consistently, not perfectly.</li></ul></article><article><h3>This is not for you if:</h3><ul><li>You are looking for overnight results or a crash diet.</li><li>You want a plan without the responsibility to follow it.</li><li>You want to train like someone else instead of around your own life.</li></ul></article></div>
      </section>

      <section class="final section"><p class="kicker">Your next chapter</p><h2>A stronger standard<br />starts with one <em>honest</em> conversation.</h2><p>Tell Avinash where you are now and where you want to be. You will leave with more clarity on whether FitWithNash coaching is the right fit.</p><a class="cta" href={whatsapp} target="_blank" rel="noreferrer">Start on WhatsApp <span>→</span></a><small>Results depend on individual effort, consistency and circumstances. No specific outcome is guaranteed.</small></section>
    </main>
    <nav class="social-float" aria-label="Contact FitWithNash">
      <a class="social-float__link social-float__instagram" href="https://www.instagram.com/fitwithnash/" target="_blank" rel="noreferrer" aria-label="Follow FitWithNash on Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle class="fill" cx="17.4" cy="6.7" r="1.1"></circle></svg><b>Instagram</b></a>
      <a class="social-float__link social-float__whatsapp" href={whatsapp} target="_blank" rel="noreferrer" aria-label="Message Avinash on WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 11.7a8.5 8.5 0 0 1-12.56 7.48L3.5 20.5l1.35-4.28A8.5 8.5 0 1 1 20.5 11.7Z"></path><path d="M9.05 7.6c.2-.47.42-.48.62-.49h.53c.17 0 .4.06.5.35l.76 1.8c.08.2.05.4-.08.57l-.42.55c-.12.14-.25.29-.1.54.15.26.68 1.12 1.46 1.8 1 .87 1.83 1.14 2.1 1.27.27.14.43.11.58-.08l.76-.9c.16-.2.34-.16.57-.08l1.8.85c.28.14.47.2.53.31.07.12.07.68-.16 1.32-.23.64-1.32 1.22-1.81 1.3-.46.08-1.06.11-1.71-.1-.4-.13-.92-.3-1.58-.58-2.79-1.2-4.6-4-4.74-4.18-.14-.2-1.13-1.5-1.13-2.85 0-1.35.7-2.01.95-2.29Z"></path></svg><b>WhatsApp</b></a>
    </nav>
    <a class="mobile-cta" href={whatsapp} target="_blank" rel="noreferrer">Talk to Avinash on WhatsApp <span>→</span></a>
  </body>
</html>

<style>
  :root{--ink:#11130f;--lime:#d9ff45;--paper:#f3f1e9;--muted:#a9ada2;--coral:#eb5e4f}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--ink);font-family:Manrope,sans-serif;color:var(--paper)}.section{padding:clamp(72px,10vw,150px) clamp(20px,8vw,130px)}.kicker{margin:0;color:var(--lime);font:700 11px "DM Mono",monospace;letter-spacing:.1em;text-transform:uppercase}.brand{position:absolute;top:30px;left:clamp(20px,8vw,130px);color:#fff;font-weight:800;letter-spacing:-.07em;text-decoration:none}.brand span{color:var(--lime)}.hero{position:relative;min-height:100svh;display:grid;justify-items:center;align-content:center;text-align:center;background:radial-gradient(circle at 50% 23%,#2c3520,transparent 22%),var(--ink)}.coach-ring{width:clamp(110px,12vw,165px);aspect-ratio:1;overflow:hidden;margin:26px 0 23px;border:2px solid var(--coral);border-radius:50%;background:#343b2b}.coach-ring img{width:100%;height:100%;object-fit:cover;transform:scale(1.32) translateY(4%);transform-origin:50% 38%}.hero h1,.proof h2,.decision h2,.coach h2,.method h2,.how h2,.fit h2,.final h2{max-width:1100px;margin:17px 0;font:700 clamp(3rem,7vw,7.5rem)/.92 Manrope,sans-serif;letter-spacing:-.075em}.hero h1 em,.proof h2 em,.decision h2 em,.coach h2 em,.how h2 em,.final h2 em{color:var(--coral);font-style:normal}.hero-copy{max-width:760px;margin:0;color:#c7c9c1;font-size:clamp(15px,1.5vw,19px);line-height:1.7}.cta{display:inline-flex;align-items:center;justify-content:center;gap:22px;margin-top:29px;padding:17px 23px;background:var(--lime);color:var(--ink);font-size:12px;font-weight:800;letter-spacing:.03em;text-decoration:none;text-transform:uppercase;transition:transform .2s ease}.cta:hover{transform:translateY(-3px)}.hero-proof-link{display:inline-flex;align-items:center;gap:8px;margin-top:17px;color:#fff;font-size:11px;font-weight:800;letter-spacing:.08em;text-decoration:none;text-transform:uppercase}.hero-proof-link span{color:var(--lime);font-size:17px}.micro{color:var(--muted);font-size:11px}.proof{background:var(--paper);color:var(--ink)}.proof .kicker{color:#657c13}.proof h2{max-width:760px;font-family:"Playfair Display",serif;font-weight:600;letter-spacing:-.055em}.proof h2 em{color:#61770f}.story-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:52px}.story-grid article{background:#e6e4da}.story-grid img{display:block;width:100%;aspect-ratio:35/36;object-fit:contain;background:#252820}.story-grid div{padding:18px}.story-grid h3{margin:0;font:600 1.35rem/1.1 "Playfair Display",serif}.story-grid p,.proof-note{margin:10px 0 0;color:#55594f;font-size:13px;line-height:1.6}.proof-note{margin-top:24px}.light{background:var(--ink);color:#fff}.decision{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(40px,9vw,150px);background:#242820}.decision h2{font-family:"Playfair Display",serif;font-weight:600;letter-spacing:-.055em}.decision>div>p:not(.kicker){max-width:520px;color:#c7c9c1;line-height:1.75}.decision-grid{border-top:1px solid #5a5e54}.decision-grid article{display:grid;grid-template-columns:48px 1fr;column-gap:18px;padding:20px 0;border-bottom:1px solid #5a5e54}.decision-grid b{grid-row:span 2;color:var(--lime);font:700 12px "DM Mono",monospace}.decision-grid h3{margin:0;font:600 1.4rem/1 "Playfair Display",serif}.decision-grid p{grid-column:2;margin:7px 0 0;color:#c7c9c1;font-size:13px;line-height:1.65}.coach{display:grid;grid-template-columns:auto minmax(0,1fr);gap:clamp(32px,7vw,110px);align-items:center;background:#191c16}.coach-image{position:relative;width:clamp(150px,16vw,220px);aspect-ratio:1;overflow:hidden;border:1px solid rgba(217,255,69,.55);border-radius:50%;background:#30372b;box-shadow:0 0 0 9px #191c16,0 0 0 10px rgba(217,255,69,.22),0 26px 60px rgba(0,0,0,.38)}.coach-image:after{position:absolute;inset:0;border-radius:inherit;box-shadow:inset 0 0 32px rgba(0,0,0,.22);content:'';pointer-events:none}.coach-image img{width:100%;height:100%;object-fit:cover;filter:saturate(.88) contrast(1.04);transform:scale(1.34) translateY(3%);transform-origin:50% 35%}.coach h2,.method h2,.how h2,.fit h2,.final h2{font-family:"Playfair Display",serif;font-weight:600;letter-spacing:-.055em}.role{color:var(--lime);font-weight:800}.coach p:not(.kicker):not(.role){max-width:640px;color:#c3c6be;line-height:1.8}.text-link{color:var(--lime);font-size:13px;font-weight:800;text-decoration:none;border-bottom:1px solid var(--lime)}.method{background:#d9ff45;color:var(--ink)}.method .kicker{color:#61770f}.method h2 em{font-style:italic}.method-intro{max-width:580px;line-height:1.7}.phase-grid{display:grid;grid-template-columns:repeat(5,1fr);margin-top:55px;border-top:1px solid rgba(17,19,15,.3)}.phase-grid article{min-height:255px;padding:22px;border-right:1px solid rgba(17,19,15,.3)}.phase-grid article:first-child{border-left:1px solid rgba(17,19,15,.3)}.phase-grid b,.steps b{color:#567100;font:700 12px "DM Mono",monospace}.phase-grid h3,.steps h3{font:600 1.55rem/1 "Playfair Display",serif}.phase-grid p,.steps p{font-size:13px;line-height:1.65}.how{background:#f5f3eb;color:var(--ink)}.how .kicker,.fit .kicker{color:#687a22}.how{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(38px,8vw,130px)}.how .cta{grid-column:1/-1;justify-self:start}.steps{display:grid;gap:28px}.steps article{display:grid;grid-template-columns:50px 1fr;column-gap:18px;padding-bottom:22px;border-bottom:1px solid #c6c7bc}.steps b{grid-row:span 2}.steps h3{margin:0}.steps p{grid-column:2;margin:6px 0 0;color:#565a50}.fit{background:#151714}.fit>div:first-child{max-width:750px}.fit>div:first-child>p:not(.kicker){color:#c1c3ba;line-height:1.7}.fit-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:38px}.fit-grid article{padding:30px;background:#22261e}.fit-grid article:last-child{background:#2a2020}.fit-grid h3{margin:0;font:600 1.8rem "Playfair Display",serif}.fit-grid ul{display:grid;gap:14px;padding:0;list-style:none;color:#ced0c8;font-size:14px;line-height:1.55}.fit-grid li{padding-left:18px;position:relative}.fit-grid li:before{content:'+';position:absolute;left:0;color:var(--lime)}.final{text-align:center;background:radial-gradient(circle at 50% 0,#354521,transparent 34%),var(--ink)}.final h2{margin-inline:auto}.final p:not(.kicker){max-width:610px;margin:0 auto;color:#c7c9c1;line-height:1.75}.final small{display:block;max-width:700px;margin:35px auto 0;color:#858981;font-size:10px;line-height:1.5}.social-float{position:fixed;z-index:30;right:18px;bottom:20px;display:flex;flex-direction:column;gap:9px}.social-float__link{display:flex;align-items:center;gap:9px;min-width:48px;height:48px;padding:0 15px;border-radius:999px;box-shadow:0 10px 30px rgba(0,0,0,.3);font-size:11px;font-weight:800;letter-spacing:.03em;text-decoration:none;transition:transform .2s ease}.social-float__link:hover{transform:translateY(-3px)}.social-float__link svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.8}.social-float__link .fill{fill:currentColor;stroke:none}.social-float__instagram{color:#fff;background:#292b27}.social-float__whatsapp{color:var(--ink);background:var(--lime)}.mobile-cta{display:none}@media(max-width:800px){body{padding-bottom:68px}.section{padding:78px 20px}.hero h1{font-size:clamp(2.9rem,12vw,4.8rem)}.story-grid,.decision,.coach,.how,.fit-grid{grid-template-columns:1fr}.story-grid{gap:25px}.phase-grid{grid-template-columns:1fr 1fr}.phase-grid article{min-height:auto;border-bottom:1px solid rgba(17,19,15,.3)}.phase-grid article:first-child{border-left:0}.phase-grid article:nth-child(odd){border-left:1px solid rgba(17,19,15,.3)}.coach-image{width:clamp(136px,42vw,178px);max-width:none}.how .cta{justify-self:stretch}.cta{width:100%}.social-float{right:13px;bottom:82px;gap:8px}.social-float__link{width:48px;min-width:48px;padding:0;justify-content:center}.social-float__link b{display:none}.mobile-cta{position:fixed;z-index:30;right:12px;bottom:12px;left:12px;display:flex;align-items:center;justify-content:center;gap:18px;padding:17px;background:var(--lime);color:var(--ink);box-shadow:0 12px 32px rgba(0,0,0,.35);font-size:12px;font-weight:800;letter-spacing:.03em;text-decoration:none;text-transform:uppercase}}
</style>

<style>
  .proof-lead { max-width:610px; margin:0; color:#55594f; line-height:1.75; }
  .story-grid article { overflow:hidden; }
  .story-grid article div span { color:#607619; font:700 10px "DM Mono",monospace; letter-spacing:.08em; text-transform:uppercase; }
  .proof-cta { display:flex; align-items:center; flex-wrap:wrap; gap:22px; margin-top:30px; }
  .proof-cta .cta { margin-top:0; }
