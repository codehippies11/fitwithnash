<style>
  /* Responsive guardrails: preserve the editorial layout without horizontal overflow. */
  html, body { max-width:100%; overflow-x:hidden; }
  img, svg { max-width:100%; }
  .hero { overflow:clip; }
  .story-grid > *, .package-grid > *, .phase-grid > *, .client-proof__feedback > *, .result-proof > *, .concierge__grid > * { min-width:0; }

  @media (max-width:1100px) {
    .section { padding-inline:clamp(22px,5vw,64px); }
    .story-grid, .package-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .phase-grid { grid-template-columns:repeat(3,minmax(0,1fr)); }
    .phase-grid article:first-child { border-left:1px solid rgba(17,19,15,.3); }
    .client-proof__feedback, .result-proof { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .hero h1 { max-width:min(100%,780px); }
    .hero-copy { max-width:min(100%,630px); }
  }

  @media (max-width:640px) {
    .section { padding:70px 18px; }
    .hero { min-height:700px; padding-top:124px; padding-bottom:96px; align-content:start; }
    .hero h1 { font-size:clamp(2.8rem,14vw,4.15rem); line-height:.94; }
    .hero-copy { font-size:15px; line-height:1.65; }
    .hero-wordmark { top:22px; left:50%; font-size:16px; letter-spacing:.1em; transform:translateX(-50%); }
    .brand-logo { top:8px; right:auto; left:10px; width:52px; height:52px; }
    .coach-ring { margin:10px 0 20px; }
    .hero-actions { gap:3px; }
    .hero-signals { gap:6px; }
    .hero-signals span { padding:7px 8px; font-size:8px; }
    .story-grid, .package-grid, .phase-grid, .client-proof__feedback, .result-proof { grid-template-columns:1fr; }
    .story-grid { margin-top:34px; }
    .story-grid img { aspect-ratio:4/3; }
    .phase-grid { margin-top:38px; }
    .phase-grid article, .phase-grid article:first-child, .phase-grid article:nth-child(odd) { min-height:0; border-right:1px solid rgba(17,19,15,.3); border-left:1px solid rgba(17,19,15,.3); }
    .phase-grid .accountability-phase { grid-column:auto; }
    .package-grid { margin-top:34px; }
    .package-grid article { padding:21px; }
    .package-grid article > img { width:calc(100% + 42px); height:155px; margin:-21px -21px 20px; }
    .client-proof__feedback { margin-top:34px; }
    .client-proof__feedback article { padding:22px; }
    .client-proof__feedback h3 { margin-top:22px; }
    .feedback-proof__signals span { width:100%; justify-content:center; }
    .proof-actions, .proof-cta { width:100%; }
    .coach-image { margin-inline:auto; }
    .social-float { bottom:76px; }
    .proof-wall--carousel .proof-wall__grid { padding-inline:7vw; }
  }

  @media (max-width:360px) {
    .section { padding-inline:14px; }
    .hero { min-height:660px; padding-top:110px; }
    .hero-wordmark { top:20px; left:50%; font-size:12px; letter-spacing:.075em; transform:translateX(-50%); }
    .hero-wordmark span { margin-inline:.05em; letter-spacing:.1em; }
    .brand-logo { top:7px; right:auto; left:7px; width:42px; height:42px; }
    .hero-signals span { font-size:7px; }
    .mobile-cta { right:8px; bottom:8px; left:8px; padding:15px 9px; font-size:10px; }
  }

  @media (min-width:1600px) {
    .section { padding-inline:max(10vw,150px); }
    .hero-copy { max-width:720px; }
  }
</style>

<style>
  .brand-logo { position:absolute; z-index:4; top:14px; right:auto; left:clamp(14px,3vw,46px); display:flex; width:clamp(70px,6vw,88px); height:clamp(70px,6vw,88px); align-items:center; justify-content:center; border-radius:50%; background:transparent; box-shadow:none; transition:transform .35s cubic-bezier(.22,1,.36,1),filter .35s ease; }
