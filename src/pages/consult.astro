---
import avinashProfile from '../assets/images/avinash-profile-premium.webp';
import avinashCoaching from '../assets/images/avinash-coaching.png';
import transformation01 from '../assets/images/transformations/curated/transformation-01.jpeg';
import transformation02 from '../assets/images/transformations/curated/transformation-02.jpeg';
import transformation04 from '../assets/images/transformations/curated/transformation-04.jpeg';
import transformation05 from '../assets/images/transformations/curated/transformation-05.jpeg';
import transformation06 from '../assets/images/transformations/curated/transformation-06.jpeg';
import transformation07 from '../assets/images/transformations/curated/transformation-07.jpeg';
import transformation08 from '../assets/images/transformations/curated/transformation-08.jpeg';
import transformation09 from '../assets/images/transformations/curated/transformation-09.jpeg';
import transformation10 from '../assets/images/transformations/curated/transformation-10.jpeg';
import transformation11 from '../assets/images/transformations/curated/transformation-11.jpeg';
import transformation12 from '../assets/images/transformations/curated/transformation-12.jpeg';
import transformation15 from '../assets/images/transformations/curated/transformation-15.jpeg';
import arunJourney from '../assets/images/journeys/arun-journey.png';
import krishamJourney from '../assets/images/journeys/krisham-journey.png';
import fitwithnashMark from '../assets/brand/fit-with-nash-header.svg';
import TestimonialWall from '../components/TestimonialWall.astro';
import FloatingButtons from '../components/FloatingButtons.astro';
import { verifiedTestimonials } from '../data/verifiedTestimonials';
import { Image } from 'astro:assets';

const whatsapp = 'https://wa.me/918360669905?text=Hi%20Avinash%2C%20I%20would%20like%20to%20book%20a%20FitWithNash%20coaching%20clarity%20call.';
const base = import.meta.env.PUBLIC_SUPABASE_URL;
const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
let media: Record<string, string> = {};
let cmsPrograms: any[] = [];
let cmsTestimonials: any[] = [];
if (base && key) {
  const headers = { apikey: key, Authorization: `Bearer ${key}` };
  const [mediaResponse, programsResponse, testimonialsResponse] = await Promise.all([
    fetch(`${base}/rest/v1/site_media?select=key,image_url`, { headers }),
    fetch(`${base}/rest/v1/programs?is_published=eq.true&select=*&order=sort_order.asc,created_at.asc`, { headers }),
    fetch(`${base}/rest/v1/testimonials?is_published=eq.true&select=*&order=sort_order.asc,created_at.asc`, { headers }),
  ]);
  if (mediaResponse.ok) media = Object.fromEntries((await mediaResponse.json()).map((item: { key: string; image_url: string }) => [item.key, item.image_url]));
  if (programsResponse.ok) cmsPrograms = await programsResponse.json();
  if (testimonialsResponse.ok) cmsTestimonials = await testimonialsResponse.json();
}
const portrait = media.consult_coach_portrait || media.hero_portrait || avinashProfile.src;
const portraitUrl = /^https?:\/\//.test(portrait) ? portrait : new URL(portrait, 'https://consult.fitwithnash.com').href;
const socialPreview = new URL(avinashCoaching.src, 'https://consult.fitwithnash.com').href;
const transformations = [
  { image: transformation01, alt: 'FitWithNash client before and after body recomposition' },
  { image: transformation02, alt: 'FitWithNash client before and after strength transformation' },
  { image: transformation04, alt: 'FitWithNash client before and after physique transformation' },
  { image: transformation05, alt: 'FitWithNash client before and after muscle-building journey' },
  { image: transformation06, alt: 'FitWithNash client before and after lean strength journey' },
  { image: transformation07, alt: 'FitWithNash client before and after body-composition progress' },
  { image: transformation08, alt: 'FitWithNash client before and after muscular development' },
  { image: transformation09, alt: 'FitWithNash client before and after sustainable fat-loss journey' },
  { image: transformation10, alt: 'FitWithNash client side-profile body transformation' },
  { image: transformation11, alt: 'FitWithNash client side-profile fitness transformation' },
  { image: transformation12, alt: 'FitWithNash client eight-week strength and physique transformation' },
  { image: arunJourney, alt: "Arun's original paired before-and-after FitWithNash transformation", name: 'Arun' },
  { image: krishamJourney, alt: "Krisham's original paired before-and-after FitWithNash transformation", name: 'Krisham' },
  { image: transformation15, alt: 'Original paired before-and-after FitWithNash client transformation' },
];
const featuredTransformationIndices = new Set([0, 1, 13]);
const transformationHeadlines = new Map([
  [0, 'Strength, revealed.'],
  [1, 'Consistency, made visible.'],
  [13, 'A healthier standard.'],
]);
const transformationPortfolio = transformations.map((transformation, index) => ({
  ...transformation,
  position: index + 1,
  headline: transformationHeadlines.get(index),
}));
const featuredTransformations = transformationPortfolio.filter((_, index) => featuredTransformationIndices.has(index));
const transformationArchive = transformationPortfolio.filter((_, index) => index !== 0);
const feedbackStories = Array.from(new Map(
  [...verifiedTestimonials, ...cmsTestimonials].map((item) => {
    const clientKey = String(item.client_name || '').trim().toLowerCase();
    return [clientKey ? `client:${clientKey}` : item.id || `${item.image_url || ''}|${item.quote || ''}`, item];
  }),
).values());
const feedbackPriority = ['prakhar', 'vipan kashyap'];
const feedbackStoriesSorted = [
  ...feedbackPriority
    .map((name) => feedbackStories.find((item) => String(item.client_name || '').trim().toLowerCase() === name))
    .filter(Boolean),
  ...feedbackStories.filter((item) => !feedbackPriority.includes(String(item.client_name || '').trim().toLowerCase())),
];
const mobileLeadStories = feedbackStoriesSorted.slice(0, 2);
const packages = cmsPrograms.length ? cmsPrograms : [
  { label: 'Personal coaching', title: 'The Personal Standard.', description: 'Personalised training, practical nutrition and regular accountability around your real life.', price: 'Ask Avinash for the investment.' },
  { label: 'Focused transformation', title: '12 Weeks, Built Properly.', description: 'A focused block to build momentum with a structure you can understand and repeat.', price: 'Ask Avinash for the investment.' },
];
const steps = [
  ['01', 'Clarity & assessment', 'We start with your goal, schedule, training history and the constraints your real life brings.'],
  ['02', 'Your personal system', 'You receive training direction, practical nutrition habits and a progression you understand.'],
  ['03', 'Accountability that adapts', 'Weekly check-ins keep the plan honest as work, travel and life change around you.'],
];
const consultationFaqs = [
  ['Who is Avinash Sharma at FitWithNash?', 'Avinash Sharma is the internationally trained, INFS- and NESTA-certified nutritionist and body-transformation coach behind FitWithNash. His nutrition studies and coaching certifications come from leading institutions across London and India.'],
  ['What does FitWithNash 1:1 fitness coaching include?', 'Each coaching relationship starts with your goals, training history, schedule and food preferences. You receive personalised training direction, practical nutrition habits and a progression you understand. Weekly check-ins ensure the plan adapts to your real life.'],
  ['Can I work with an online fitness coach while travelling or working long hours?', 'Yes. FitWithNash coaching is designed around real workdays, travel and family commitments, with a plan that adapts to change instead of expecting your life to disappear.'],
  ['Is this coaching for weight loss or muscle building?', 'The coaching can support sustainable fat loss, strength, muscle building and healthier routines. Your plan is built around your starting point and goal.'],
  ['Does FitWithNash provide dietitian and nutritionist guidance?', 'Yes. Avinash provides personalised nutrition guidance that focuses on repeatable food choices, sufficient protein, meal structure and flexibility—not rigid rules.'],
  ['Who is online fitness coaching best suited for?', 'It is most useful for adults who value a clear plan, honest feedback and a coach who can adjust training around a real calendar. It is not a quick fix or replacement for medical advice.'],
];
const consultSchema = {
  '@context': 'https://schema.org', '@graph': [
    { '@type': 'WebSite', '@id': 'https://consult.fitwithnash.com/#website', url: 'https://consult.fitwithnash.com/', name: 'FitWithNash', inLanguage: 'en-IN', publisher: { '@id': 'https://consult.fitwithnash.com/#business' } },
    { '@type': 'WebPage', '@id': 'https://consult.fitwithnash.com/#webpage', url: 'https://consult.fitwithnash.com/', name: 'Avinash Sharma | Private Dietitian & Nutritionist | FitWithNash', description: 'Private nutrition and body-composition coaching for professionals.', inLanguage: 'en-IN', isPartOf: { '@id': 'https://consult.fitwithnash.com/#website' } },
    { '@type': 'ProfessionalService', '@id': 'https://consult.fitwithnash.com/#business', name: 'FitWithNash', alternateName: 'Fit With Nash', url: 'https://consult.fitwithnash.com/', logo: 'https://www.fitwithnash.com/favicon.svg', image: portraitUrl, description: 'Private nutrition and body-composition coaching.' },
    { '@type': 'Service', '@id': 'https://consult.fitwithnash.com/#service', name: 'FitWithNash Dietitian, Nutrition & Body Transformation Coaching', serviceType: 'Dietitian-led nutrition guidance and fitness coaching.', provider: { '@id': 'https://consult.fitwithnash.com/#business' }, areaServed: { '@type': 'Country', name: 'IN' } },
    { '@type': 'Person', '@id': 'https://consult.fitwithnash.com/#avinash-sharma', name: 'Avinash Sharma', url: 'https://consult.fitwithnash.com/#avinash-sharma', image: portraitUrl, jobTitle: 'Dietitian & Fitness Coach', worksFor: { '@id': 'https://consult.fitwithnash.com/#business' } },
    { '@type': 'FAQPage', '@id': 'https://consult.fitwithnash.com/#faq', mainEntity: consultationFaqs.map(([question, answer]) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Avinash Sharma | Private Dietitian & Nutritionist | FitWithNash</title>
    <meta name="description" content="Private nutrition and body-composition coaching for professionals who value precise guidance, familiar food and a standard they can sustain. Consult Avinash Sharma." />
    <meta name="keywords" content="Avinash Sharma dietitian, Avinash Sharma nutritionist, Avinash Sharma fitness coach, FitWithNash, online dietitian India, online nutritionist, body transformation coaching" />
    <meta name="author" content="Avinash Sharma, FitWithNash" />
    <meta name="robots" content="index,follow" />
    <meta name="googlebot" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <meta name="theme-color" content="#f03212" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <link rel="shortcut icon" href="/favicon.svg" />
    <link rel="apple-touch-icon" href={avinashProfile.src} />
    <link rel="canonical" href="https://consult.fitwithnash.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FitWithNash" />
    <meta property="og:title" content="Avinash Sharma | Private Dietitian & Nutritionist" />
    <meta property="og:description" content="Private nutrition and body-composition coaching built around real schedules, familiar food and durable standards." />
    <meta property="og:url" content="https://consult.fitwithnash.com/" />
    <meta property="og:image" content={socialPreview} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="FitWithNash private nutrition and body-composition coaching with Avinash Sharma" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Avinash Sharma | Private Dietitian & Nutritionist" />
    <meta name="twitter:description" content="Private nutrition and body-composition coaching built around real schedules, familiar food and durable standards." />
    <meta name="twitter:image" content={socialPreview} />
    <meta name="twitter:image:alt" content="FitWithNash private nutrition and body-composition coaching with Avinash Sharma" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,600;1,700&family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(consultSchema)} />
  </head>
  <body>
    <FloatingButtons whatsappNumber="918360669905" />
    <main>
      <section class="hero section">
        <a class="hero-wordmark" href="https://www.fitwithnash.com/" aria-label="FitWithNash home">FIT<span>WITH</span>NASH</a>
        <a class="brand-logo" href="https://www.fitwithnash.com/" aria-label="FitWithNash home"><img src={fitwithnashMark.src} alt="" /><span>FitWithNash</span></a>
        <div class="coach-ring"><img src={portrait} alt="Avinash Sharma, FitWithNash coach" /></div>
        <p class="kicker">Internationally trained dietitian & nutritionist / private 1:1 coaching</p>
        <h1>Build a stronger body<br />without putting your <em>life</em> on pause.</h1>
        <p class="hero-copy">I help ambitious professionals build strength, lose excess body fat and create a routine they can keep—even with demanding workdays, travel and family commitments.</p>
        <div class="hero-actions"><a class="cta cta--book" href={whatsapp} target="_blank" rel="noreferrer">Request a private clarity call <span>→</span></a><a class="hero-proof-link" href="#proof">See the proof <span>→</span></a></div>
        <div class="hero-signals" aria-label="FitWithNash coaching principles"><span>Personal training</span><span>Practical nutrition</span><span>Direct accountability</span></div>
        <p class="micro">A focused conversation. No pressure. We begin with your real context.</p>
      </section>

      <section class="transformation-showcase" id="proof" aria-labelledby="transformation-heading">
        <div class="transformation-showcase__intro section">
          <p class="transformation-showcase__index" aria-hidden="true">FWN / RESULTS</p>
          <div>
            <p class="kicker">Real client transformations</p>
            <h2 id="transformation-heading">The work.<br /><em>Made visible.</em></h2>
          </div>
          <p class="transformation-showcase__lead">No stock bodies. No borrowed stories. A record of clients who trained, adapted and kept showing up—built through personal coaching that respects their real life.</p>
        </div>

        <div class="transformation-showcase__portfolio">
          <div class="transformation-featured" aria-label="Selected original FitWithNash client transformations">
            {featuredTransformations.map((transformation, index) => (
              <figure class:list={["result-feature", `result-feature--${index + 1}`]}>
                <button
                  class="result-feature__open"
                  type="button"
                  data-proof-view
                  data-proof-src={transformation.image.src}
                  data-proof-alt={transformation.alt}
                  data-proof-label={transformation.name || 'Original client transformation'}
                  aria-label={`View ${transformation.name || 'original client transformation'} in full`}
                >
                  <span class="result-feature__media">
                    <Image
                      src={transformation.image}
                      alt={transformation.alt}
                      widths={[480, 768, 1080, 1440]}
                      sizes={index === 0 ? "(max-width: 800px) 82vw, 62vw" : "(max-width: 800px) 82vw, 38vw"}
                      format="webp"
                      quality={88}
                      loading="lazy"
                    />
                  </span>
                  <span class="result-feature__view">View full result <b aria-hidden="true">↗</b></span>
                </button>
                <figcaption>
                  <span>Selected client journey</span>
                  <strong>{transformation.headline}</strong>
                  <small>{transformation.name || 'Original client transformation'}</small>
                </figcaption>
              </figure>
            ))}
          </div>

          <div class="transformation-archive" aria-labelledby="transformation-archive-title">
            <div class="transformation-archive__header">
              <div><p class="kicker">The result archive</p><h3 id="transformation-archive-title">Every journey remains visible.</h3></div>
              <p>Swipe or drag through the complete client record. Tap any image to inspect the original.</p>
            </div>
            <div class="transformation-archive__stage" data-transformation-stage>
              <div class="transformation-rail" aria-label="Scrollable archive of FitWithNash client transformations" data-transformation-track tabindex="0">
                {transformationArchive.map((transformation, index) => (
                <figure class:list={['result-thumb', featuredTransformationIndices.has(transformation.position - 1) && 'result-thumb--featured-copy']} role="group" aria-roledescription="slide" aria-label={`Transformation ${transformation.position}`} data-transformation-card>
                  <button
                    class="result-thumb__open"
                    type="button"
                    data-proof-view
                    data-proof-src={transformation.image.src}
                    data-proof-alt={transformation.alt}
                    data-proof-label={transformation.name || 'Original client transformation'}
                    aria-label={`View ${transformation.name || 'original client transformation'} in full`}
                  >
                    <Image
                      src={transformation.image}
                      alt={transformation.alt}
                      widths={[320, 480, 768]}
                      sizes="(max-width: 800px) 72vw, 330px"
                      format="webp"
                      quality={84}
                      loading="lazy"
                    />
                    <span>Open result <b aria-hidden="true">↗</b></span>
                  </button>
                  <figcaption><span>FitWithNash result</span><b>{transformation.name || 'Client transformation'}</b></figcaption>
                </figure>
              ))}
              </div>
              <div class="transformation-rail__controls" aria-label="Transformation carousel navigation">
                <button type="button" data-transformation-previous aria-label="Show previous transformation"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6" /></svg><span>Previous</span></button>
                <button type="button" data-transformation-next aria-label="Show next transformation"><span>Next</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></button>
              </div>
            </div>
          </div>
        </div>

        <div class="transformation-showcase__close section">
          <div><span>Discipline changes shape.</span><strong>Your starting point can, too.</strong></div>
          <a class="cta cta--book" href={whatsapp} target="_blank" rel="noreferrer">Discuss your starting point <span>→</span></a>
          <small>Individual results vary. No specific outcome is guaranteed.</small>
        </div>
      </section>

      <section class="feedback-proof section" aria-labelledby="client-proof-heading">
        <div class="feedback-proof__intro"><div><p class="kicker">Original client proof</p><h2 id="client-proof-heading">Real words.<br /><em>Real standards.</em></h2></div><p>Original reviews from verified FitWithNash clients. Tap to inspect the full record.</p></div>
        <p class="feedback-proof__assurance"><span>Original review screenshots</span> · tap any proof to inspect the full record.</p>
        <div class="feedback-proof__lead"><TestimonialWall testimonials={mobileLeadStories} tone="dark" layout="stack" label="Featured original FitWithNash client reviews" /></div>
        <div class="feedback-proof__stage"><TestimonialWall testimonials={feedbackStoriesSorted} tone="dark" layout="carousel" label="Original FitWithNash client reviews" /></div>
        <div class="feedback-proof__close"><p>Your context will be different. The coaching standard will not.</p><a class="cta cta--book" href={whatsapp} target="_blank" rel="noreferrer">Discuss your goals <span>→</span></a></div>
      </section>

      <dialog class="proof-viewer" data-proof-viewer aria-labelledby="proof-viewer-title">
        <div class="proof-viewer__surface">
          <div class="proof-viewer__bar"><p id="proof-viewer-title" data-proof-viewer-label>Original client proof</p><button type="button" data-proof-close aria-label="Close proof viewer">Close <b aria-hidden="true">×</b></button></div>
          <div class="proof-viewer__canvas"><img data-proof-viewer-image alt="" /></div>
        </div>
      </dialog>

      <section class="decision section">
        <div><p class="kicker">A better first step</p><h2>You do not need to have it all figured out before you <em>start.</em></h2><p>Most people arrive with a goal and a lot of noise: conflicting advice, past attempts, equipment at home. Your first step is clarity on what you need—not a perfect plan.</p></div>
        <div class="decision-grid"><article><b>01</b><h3>Bring the real context.</h3><p>Your schedule, food preferences, gym access and past attempts matter. There is no one-size-fits-all script here.</p></article><article><b>02</b><h3>Personalisation that adapts.</h3><p>You receive training direction, nutrition guidance and a progression you understand. It moves with your life, not against it.</p></article><article><b>03</b><h3>Accountability that sticks.</b><p>Regular check-ins with Avinash keep you honest. You adjust together as demands at work, travel or home arise.</p></article></div>
      </section>

      <section class="concierge section">
        <div class="concierge__intro"><p class="kicker">The private coaching standard</p><h2>A plan that respects<br />your <em>time.</em></h2><p>High performance is not about making fitness hard. It is about building a system around your real life.</p></div>
        <div class="concierge__grid" aria-label="Private coaching experience"><article><span>01</span><h3>Built around your calendar</h3><p>Work, travel, family and food preferences are inputs—not obstacles. Your plan moves when life demands it.</p></article><article><span>02</span><h3>Practical nutrition guidance</h3><p>No restrictions. Simple meal structure, sufficient protein, and flexibility around the food you already enjoy.</p></article><article><span>03</span><h3>Progressive training direction</h3><p>A training focus that meets you where you are. Clear progression. Confidence in what you are doing and why.</p></article></div>
      </section>

      <section class="coach section">
        <div class="coach-image"><img src={portrait} alt="Avinash Sharma" /></div>
        <div><p class="kicker">— Meet your dietitian & coach</p><h2>Hey, I'm <em class="coach-name">Avinash.</em></h2><p class="role">INFS & NESTA-certified nutritionist · body-transformation coach</p><p>I train ambitious professionals who want to build strength, move past diet noise and create a routine that fits their real life. No quick fixes. No sacrifice. A personal system you can keep.</p></div>
      </section>

      <section class="coach-profile section" id="avinash-sharma" aria-labelledby="avinash-profile-title">
        <div><p class="kicker">— About Avinash Sharma</p><h2 id="avinash-profile-title">Nutrition-led coaching,<br />with practical <em>discipline.</em></h2></div>
        <div class="coach-profile__copy"><p>Avinash Sharma is the internationally trained, INFS- and NESTA-certified nutritionist and coach behind FitWithNash. His nutrition studies and coaching certifications come from leading institutions across London and India. He works with ambitious professionals who prefer evidence over noise, and a plan they can repeat.</p><p>His approach is built on three pillars: simple nutrition habits that travel well, progressive training that builds confidence, and accountability that adapts to real life.</p></div>
        <div class="coach-profile__topics" aria-label="FitWithNash coaching areas">
          <article id="online-fitness-coaching"><span>01</span><h3>Online fitness coaching</h3><p>Clear training direction and regular review for people who need their plan to travel well, work around long days, and adapt to change.</p></article>
          <article id="strength-training"><span>02</span><h3>Strength & body composition</h3><p>Progressive resistance training, measured against useful markers: performance, consistency, confidence and how you feel in your clothes.</p></article>
          <article id="nutrition-guidance"><span>03</span><h3>Dietitian-led nutrition guidance</h3><p>Simple meal structure, protein awareness and flexible food choices—without presenting restriction as discipline or suggesting sacrifice builds character.</p></article>
        </div>
        <p class="coach-profile__note">Fitness coaching supports habits and training decisions. For injury, pregnancy, eating concerns or a medical condition, seek advice from an appropriately qualified health professional.</p>
      </section>

      <section class="method section">
        <p class="kicker">— The framework</p><h2>The <em class="method-name">Avinash Method</em></h2><p class="method-intro">A practical coaching framework that builds a result your schedule can support.</p>
        <div class="phase-grid">
          <article class="phase-card phase-card--foundation"><span class="phase-card__symbol" aria-hidden="true">◎</span><h3>Foundation</h3><p>We establish your baseline: movement, routine, recovery and the patterns that shape your body. No assumptions.</p></article>
          <article class="phase-card phase-card--strength"><span class="phase-card__symbol" aria-hidden="true">▲</span><h3>Strength</h3><p>Progressive training builds confidence, capability and the resilience to keep going when demands arise.</p></article>
          <article class="phase-card phase-card--nutrition"><span class="phase-card__symbol" aria-hidden="true">✦</span><h3>Nutrition</h3><p>Simple, flexible nutrition habits support your goal while fitting the food you already know and prefer.</p></article>
          <article class="phase-card phase-card--integration"><span class="phase-card__symbol" aria-hidden="true">◌</span><h3>Integration</h3><p>We adapt the plan around travel, long workdays and family changes. Your routine stays intact when life shifts.</p></article>
          <article class="phase-card accountability-phase"><span class="phase-card__symbol" aria-hidden="true">◆</span><h3 class="accountability-title">Accountability</h3><p>Regular check-ins keep the plan honest. You adjust together as context changes. Progress is measured against what matters to you.</p></article>
        </div>
      </section>

      <section class="packages section">
        <p class="kicker">Choose your support</p><h2>Coaching offers that fit the work you are ready to do.</h2><p class="packages-intro">Every offer is built around a real starting point—not a generic package.</p>
        <div class="package-grid">{packages.map((item) => <article>{item.image_url && <img src={item.image_url} alt="" loading="lazy" />}<p>{item.label}</p><h3>{item.title}</h3><span>{item.description}</span><p class="package-price"><strong>Investment:</strong> {item.price}</p></article>)}</div>
      </section>

      <section class="how section">
        <div><p class="kicker">How 1:1 coaching works</p><h2>Three steps to a body you can <em>trust.</em></h2></div>
        <div class="steps">{steps.map(([number, title, text]) => <article><b>{number}</b><h3 class={title === 'Accountability that adapts' ? 'accountability-title' : ''}>{title}</h3><p>{text}</p></article>)}</div>
        <a class="cta cta--book" href={whatsapp} target="_blank" rel="noreferrer">Book your clarity call <span>→</span></a>
      </section>

      <section class="fit section">
        <div><p class="kicker">Who this is for</p><h2>This is not another generic program.</h2><p>It is a personal system for people ready to build strength around the life they already lead.</p></div>
        <div class="fit-grid"><article><h3>This is for you if:</h3><ul><li>You want a clear fitness direction instead of saving more random workouts.</li><li>You want to get stronger, leaner and more confident—in a way you can keep.</li><li>You value practical guidance over ideology.</li><li>Your schedule is real: work pressures, travel, family commitments.</li><li>You prefer a coach who adapts to you, not a program you adapt to.</li></ul></article><article><h3>This is probably not for you if:</h3><ul><li>You are looking for a quick fix or a 12-week miracle.</li><li>You want a one-size-fits-all program.</li><li>You prefer rigid meal plans and calorie counting over intuitive food choices.</li><li>You don't value regular feedback and adjustment.</li><li>You need medical advice for injury, illness or pregnancy.</li></ul></article></div>
      </section>

      <section class="faq section" id="faq">
        <p class="kicker">— Coaching questions</p>
        <h2>Clear answers before<br />you <em>start.</em></h2>
        <div class="faq__list">{consultationFaqs.map(([question, answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div>
      </section>

      <section class="final section"><p class="kicker">Your next chapter</p><h2>A stronger standard<br />starts with one <em>honest</em> conversation.</h2><p>Tell Avinash where you are now and what you want. Together, you'll build a plan that respects your time and delivers the body you can trust.</p><a class="cta cta--book" href={whatsapp} target="_blank" rel="noreferrer">Start here: Request a clarity call <span>→</span></a><small>A focused 20-minute conversation. No pressure. No pitch. We talk about your goal and whether 1:1 coaching is the right move for you.</small></section>
    </main>
    <script is:inline>
      // Proof viewer handling
      const proofViewer = document.querySelector('[data-proof-viewer]');
      const proofViewerImage = proofViewer?.querySelector('[data-proof-viewer-image]');
      const proofViewerLabel = proofViewer?.querySelector('[data-proof-viewer-label]');
      const closeProofViewer = () => {
        if (!proofViewer?.open) return;
        proofViewer.close();
      };
      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        const trigger = event.target.closest('[data-proof-view]');
        if (!trigger || !proofViewer || !proofViewerImage) return;
        event.preventDefault();
        const source = trigger.getAttribute('data-proof-src');
        if (!source) return;
        proofViewerImage.setAttribute('src', source);
        proofViewerImage.setAttribute('alt', trigger.getAttribute('data-proof-alt') || 'Original FitWithNash client proof');
        if (proofViewerLabel) proofViewerLabel.textContent = trigger.getAttribute('data-proof-label') || 'Original client proof';
        if (typeof proofViewer.showModal === 'function') {
          document.dispatchEvent(new CustomEvent('proofviewer:open'));
          proofViewer.showModal();
        } else window.open(source, '_blank', 'noopener,noreferrer');
      });
      proofViewer?.querySelector('[data-proof-close]')?.addEventListener('click', closeProofViewer);
      proofViewer?.addEventListener('click', (event) => {
        if (event.target === proofViewer) closeProofViewer();
      });
      proofViewer?.addEventListener('close', () => {
        proofViewerImage?.removeAttribute('src');
        document.dispatchEvent(new CustomEvent('proofviewer:close'));
      });

      // Motion reveal
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const motionSections = [...document.querySelectorAll('main > .section:not(.hero)')];
      const motionTargets = 'p.kicker, h2, h3, .proof-lead, .hero-copy, .story-grid article, .decision-grid article, .concierge__grid article, .coach-image, .coach-profile__copy, .coach-profile__topics';
      motionSections.forEach((section) => {
        section.classList.add('motion-section');
        [...section.querySelectorAll(motionTargets)].forEach((item, index) => {
          item.classList.add('motion-item');
          item.style.setProperty('--motion-delay', `${Math.min(index, 7) * 55}ms`);
        });
      });
      if (reducedMotion || !('IntersectionObserver' in window)) {
        motionSections.forEach((section) => section.classList.add('is-revealed'));
      } else {
        const reveal = new IntersectionObserver((entries) => entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-revealed');
          reveal.unobserve(entry.target);
        }), { threshold: 0.1, rootMargin: '0px 0px -6% 0px' });
        motionSections.forEach((section) => reveal.observe(section));
      }

      // Transformation carousel auto-scroll
      const transformationArt = [...document.querySelectorAll('[data-transformation-art]')];
      if (reducedMotion || !('IntersectionObserver' in window)) {
        transformationArt.forEach((item) => item.classList.add('is-visible'));
      } else {
        const artReveal = new IntersectionObserver((entries) => entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          artReveal.unobserve(entry.target);
        }), { threshold: 0.14, rootMargin: '0px 0px -8% 0px' });
        transformationArt.forEach((item) => artReveal.observe(item));
      }

      document.querySelectorAll('[data-transformation-stage]').forEach((stage) => {
        const track = stage.querySelector('[data-transformation-track]');
        const previous = stage.querySelector('[data-transformation-previous]');
        const next = stage.querySelector('[data-transformation-next]');
        const cards = [...(track?.querySelectorAll('[data-transformation-card]') || [])];
        if (!track || cards.length < 2) return;

        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let activeIndex = 0;
        let autoScrollTimer = 0;

        const cardLeft = (card) => card.offsetLeft - Math.max((track.clientWidth - card.clientWidth) / 2, 0);
        const position = (index, behavior = 'smooth') => {
          const card = cards[index];
          if (!card) return;
          const left = cardLeft(card);
          if (behavior === 'auto' || reduced) track.scrollLeft = left;
          else track.scrollTo({ left, behavior });
        };
        const syncCurrent = (index) => {
          activeIndex = Math.max(0, Math.min(cards.length - 1, index));
          cards.forEach((card, cardIndex) => card.classList.toggle('is-current', cardIndex === activeIndex));
        };
        const nearestIndex = () => {
          const center = track.getBoundingClientRect().left + track.clientWidth / 2;
          return cards.reduce((best, card, index) => {
            const rect = card.getBoundingClientRect();
            const distance = Math.abs(rect.left + rect.width / 2 - center);
            return distance < best.distance ? { index, distance } : best;
          }, { index: activeIndex, distance: Infinity }).index;
        };
        const updateFromScroll = () => syncCurrent(nearestIndex());
        const move = (direction) => {
          const target = Math.max(0, Math.min(cards.length - 1, activeIndex + direction));
          syncCurrent(target);
          position(target, 'smooth');
        };
        const centerCurrent = () => position(activeIndex, 'auto');
        const autoScroll = () => {
          clearInterval(autoScrollTimer);
          autoScrollTimer = setInterval(() => {
            move(1);
          }, 1000);
        };

        previous?.addEventListener('click', () => {
          move(-1);
          clearInterval(autoScrollTimer);
          setTimeout(autoScroll, 3000);
        });
        next?.addEventListener('click', () => {
          move(1);
          clearInterval(autoScrollTimer);
          setTimeout(autoScroll, 3000);
        });
        track.addEventListener('keydown', (event) => {
          if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
          event.preventDefault();
          clearInterval(autoScrollTimer);
          move(event.key === 'ArrowRight' ? 1 : -1);
          setTimeout(autoScroll, 3000);
        });
        track.addEventListener('scroll', () => window.requestAnimationFrame(updateFromScroll), { passive: true });
        track.addEventListener('pointerenter', () => clearInterval(autoScrollTimer));
        track.addEventListener('pointerleave', () => autoScroll());
        
        syncCurrent(activeIndex);
        window.addEventListener('load', centerCurrent, { once: true });
        document.fonts?.ready?.then(centerCurrent);
        window.setTimeout(centerCurrent, 220);
        if ('ResizeObserver' in window) new ResizeObserver(centerCurrent).observe(track);
        
        autoScroll();
      });
    </script>
  </body>
</html>