    <script is:inline>
      // A refresh should reopen the funnel at its beginning, while direct #section links still work.
      if (!window.location.hash) {
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        const openAtHero = () => window.scrollTo({ top: 0, left: 0, behavior: 'auto' });
        openAtHero();
        window.addEventListener('pageshow', openAtHero);
      }

      // Floating actions stay visible across every section, hero and closing chapter included.
      document.querySelector('.private-call-float')?.classList.remove('is-hidden');
      document.querySelector('.social-float')?.classList.remove('is-hidden');

      const proofViewer = document.querySelector('[data-proof-viewer]');
      const proofViewerImage = proofViewer?.querySelector('[data-proof-viewer-image]');
      const proofViewerLabel = proofViewer?.querySelector('[data-proof-viewer-label]');
      const closeProofViewer = () => {
        if (!proofViewer?.open) return;
        proofViewer.close();
      };
      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        const trigger = event.target.closest('[data-proof-view]');
        if (!trigger || !proofViewer || !proofViewerImage) return;
        event.preventDefault();
        const source = trigger.getAttribute('data-proof-src');
        if (!source) return;
        proofViewerImage.setAttribute('src', source);
        proofViewerImage.setAttribute('alt', trigger.getAttribute('data-proof-alt') || 'Original FitWithNash client proof');
        if (proofViewerLabel) proofViewerLabel.textContent = trigger.getAttribute('data-proof-label') || 'Original client proof';
        if (typeof proofViewer.showModal === 'function') {
          document.dispatchEvent(new CustomEvent('proofviewer:open'));
          proofViewer.showModal();
        } else window.open(source, '_blank', 'noopener,noreferrer');
      });
      proofViewer?.querySelector('[data-proof-close]')?.addEventListener('click', closeProofViewer);
      proofViewer?.addEventListener('click', (event) => {
        if (event.target === proofViewer) closeProofViewer();
      });
      proofViewer?.addEventListener('close', () => {
        proofViewerImage?.removeAttribute('src');
        document.dispatchEvent(new CustomEvent('proofviewer:close'));
      });

      // Keep motion understated: each editorial section enters once as it earns attention.
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const motionSections = [...document.querySelectorAll('main > .section:not(.hero)')];
      const motionTargets = 'p.kicker, h2, h3, .proof-lead, .hero-copy, .story-grid article, .decision-grid article, .concierge__grid article, .coach-image, .coach-profile__copy, .coach-profile__topics article, .phase-grid article, .package-grid article, .steps article, .fit-grid article, .faq details, .proof-cta, .cta';
      motionSections.forEach((section) => {
        section.classList.add('motion-section');
        [...section.querySelectorAll(motionTargets)].forEach((item, index) => {
          item.classList.add('motion-item');
          item.style.setProperty('--motion-delay', `${Math.min(index, 7) * 55}ms`);
        });
      });
      if (reducedMotion || !('IntersectionObserver' in window)) {
        motionSections.forEach((section) => section.classList.add('is-revealed'));
      } else {
        const reveal = new IntersectionObserver((entries) => entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-revealed');
          reveal.unobserve(entry.target);
        }), { threshold: 0.1, rootMargin: '0px 0px -6% 0px' });
        motionSections.forEach((section) => reveal.observe(section));
      }

      const transformationArt = [...document.querySelectorAll('[data-transformation-art]')];
      if (reducedMotion || !('IntersectionObserver' in window)) {
        transformationArt.forEach((item) => item.classList.add('is-visible'));
      } else {
        const artReveal = new IntersectionObserver((entries) => entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          artReveal.unobserve(entry.target);
        }), { threshold: 0.14, rootMargin: '0px 0px -8% 0px' });
        transformationArt.forEach((item) => artReveal.observe(item));
      }

      document.querySelectorAll('[data-transformation-stage]').forEach((stage) => {
        const track = stage.querySelector('[data-transformation-track]');
        const previous = stage.querySelector('[data-transformation-previous]');
        const next = stage.querySelector('[data-transformation-next]');
        // Some cards are hidden at this breakpoint; only laid-out ones can be positioned.
        const originals = [...(track?.querySelectorAll('[data-transformation-card]') || [])]
          .filter((card) => card.offsetParent !== null);
        if (!track || originals.length < 2) return;

        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Clone the ends so the rail can wrap without ever showing an edge.
        const makeClone = (card) => {
          const clone = card.cloneNode(true);
          clone.setAttribute('aria-hidden', 'true');
          clone.setAttribute('inert', '');
          clone.removeAttribute('aria-label');
          clone.dataset.transformationClone = 'true';
          return clone;
        };
        track.prepend(makeClone(originals.at(-1)));
        track.append(makeClone(originals[0]));

        const cards = [...track.querySelectorAll('[data-transformation-card]')]
          .filter((card) => card.offsetParent !== null);
        const total = originals.length;
        let activeIndex = 1;
        let timer = 0;
        let resumeTimer = 0;
        let scrollTimer = 0;
        let inViewport = false;
        let focusInside = false;

        const cardLeft = (card) => card.offsetLeft - Math.max((track.clientWidth - card.clientWidth) / 2, 0);
        const position = (index, behavior = 'smooth') => {
          const card = cards[index];
          if (!card) return;
          const left = cardLeft(card);
          if (behavior === 'auto' || reduced) track.scrollLeft = left;
          else track.scrollTo({ left, behavior });
        };
        const progress = stage.querySelector('[data-transformation-progress]');
        progress?.style.setProperty('--rail-steps', String(total));
        const syncCurrent = (index) => {
          activeIndex = Math.max(0, Math.min(cards.length - 1, index));
          cards.forEach((card, cardIndex) => card.classList.toggle('is-current', cardIndex === activeIndex));
          // activeIndex 1..total maps onto the real cards; clones sit either side.
          const step = Math.min(total - 1, Math.max(0, activeIndex - 1));
          progress?.style.setProperty('--rail-step', String(step));
        };
        const stop = () => { window.clearInterval(timer); timer = 0; };
        const start = () => {
          stop();
          if (reduced || !inViewport || document.hidden || focusInside) return;
          timer = window.setInterval(() => {
            syncCurrent(activeIndex + 1);
            position(activeIndex, 'smooth');
          }, 1000);
        };
        const scheduleResume = () => {
          window.clearTimeout(resumeTimer);
          resumeTimer = window.setTimeout(start, 1600);
        };
        const nearestIndex = () => {
          const center = track.getBoundingClientRect().left + track.clientWidth / 2;
          return cards.reduce((best, card, index) => {
            const rect = card.getBoundingClientRect();
            const distance = Math.abs(rect.left + rect.width / 2 - center);
            return distance < best.distance ? { index, distance } : best;
          }, { index: activeIndex, distance: Infinity }).index;
        };
        // Landing on a clone means jumping silently to its real counterpart.
        const normalize = () => {
          const nearest = nearestIndex();
          if (nearest === 0) { syncCurrent(total); position(total, 'auto'); }
          else if (nearest === total + 1) { syncCurrent(1); position(1, 'auto'); }
          else syncCurrent(nearest);
        };
        const move = (direction) => {
          stop();
          syncCurrent(activeIndex + direction);
          position(activeIndex, 'smooth');
          scheduleResume();
        };
        const centerCurrent = () => position(activeIndex, 'auto');

        previous?.addEventListener('click', () => move(-1));
        next?.addEventListener('click', () => move(1));
        track.addEventListener('keydown', (event) => {
          if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
          event.preventDefault();
          move(event.key === 'ArrowRight' ? 1 : -1);
        });
        track.addEventListener('focusin', () => { focusInside = true; stop(); });
        track.addEventListener('focusout', (event) => {
          if (stage.contains(event.relatedTarget)) return;
          focusInside = false;
          scheduleResume();
        });
        track.addEventListener('touchstart', () => { stop(); scheduleResume(); }, { passive: true });
        track.addEventListener('scroll', () => {
          window.clearTimeout(scrollTimer);
          scrollTimer = window.setTimeout(normalize, 130);
        }, { passive: true });
        document.addEventListener('visibilitychange', start);
        document.addEventListener('proofviewer:open', stop);
        document.addEventListener('proofviewer:close', start);

        if ('IntersectionObserver' in window) {
          new IntersectionObserver(([entry]) => {
            inViewport = entry.isIntersecting;
            if (inViewport) start(); else stop();
          }, { threshold: 0.2 }).observe(stage);
        } else inViewport = true;

        syncCurrent(activeIndex);
        window.addEventListener('load', centerCurrent, { once: true });
        document.fonts?.ready?.then(centerCurrent);
        window.setTimeout(centerCurrent, 220);
        if ('ResizeObserver' in window) new ResizeObserver(centerCurrent).observe(track);
        start();
      });
    </script>
  </body>
</html>

