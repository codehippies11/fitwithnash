<style>
  /* Curated results: a full-bleed editorial gallery, never a generic card carousel. */
  .transformation-showcase {
    position:relative;
    isolation:isolate;
    overflow:clip;
    background:#070807;
    color:#f4efe7;
  }
  .transformation-showcase::before {
    position:absolute;
