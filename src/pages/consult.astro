<style>
  /* The Maison system: calm European editorial contrast, deliberately limited to five tones. */
  :root { --maison-ink:#201b18; --maison-paper:#f5efe5; --maison-cream:#e9dfd0; --maison-wine:#5a2623; --maison-brass:#a9814f; --maison-olive:#6c725e; }
  body { background:var(--maison-ink); color:var(--maison-paper); }
