<style>
  /* Playfair's capital A has a left overhang. Keep a positive inset so it can never be clipped at any viewport. */
  .brand { display:inline-flex; align-items:center; padding-bottom:7px; font:800 18px/.9 Manrope,sans-serif; letter-spacing:-.095em; }
