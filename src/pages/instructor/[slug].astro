---
import Layout from '../../layouts/Layout.astro';

export const getStaticPaths = async () => {
  const apiUrl = import.meta.env.PUBLIC_API_URL;
  if (!apiUrl) {
    throw new Error('PUBLIC_API_URL must be set to build instructor pages.');
  }

  const res = await fetch(`${apiUrl}/instructors`, {
    headers: { Accept: 'application/json' },
  });
  if (!res.ok) throw new Error(`Unable to load instructors: ${res.status}`);

  const instructors = await res.json();
  return Promise.all(instructors.map(async ({ slug }: { slug: string }) => {
    const instructorRes = await fetch(`${apiUrl}/instructors/${slug}`);
    if (!instructorRes.ok) throw new Error(`Unable to load instructor ${slug}: ${instructorRes.status}`);
    return { params: { slug }, props: { instructor: await instructorRes.json() } };
  }));
};

const { instructor } = Astro.props;
const title = instructor.metaTitle || instructor.fullName || 'Instructor';
const description = instructor.metaDesc || instructor.bio || '';
const socialLinks = [
  ['Instagram', instructor.social?.instagram, 'text-blue-600'],
  ['YouTube', instructor.social?.youtube, 'text-red-600'],
  ['LinkedIn', instructor.social?.linkedin, 'text-blue-500'],
].filter(([, link]) => link?.url);
---

<Layout>
  <main class="py-12 px-4 max-w-4xl mx-auto">
    <article>
      <h1 class="text-4xl font-bold mb-4">{instructor.fullName}</h1>
      {instructor.image?.formats?.large?.thumbnailUrl && (
        <img
          src={instructor.image.formats.large.thumbnailUrl}
          alt={instructor.fullName}
          class="w-full h-auto rounded mb-6"
        />
      )}
      <div class="prose max-w-none">
        <p>{instructor.bio || 'No biography available.'}</p>
      </div>
      {socialLinks.length > 0 && (
        <div class="mt-8">
          <h2 class="text-2xl font-semibold">Social Links</h2>
          <ul class="list-disc pl-5">
            {socialLinks.map(([name, link, colorClass]) => (
              <li>
                <a href={link.url} class={`${colorClass} hover:underline`} target="_blank" rel="noreferrer">{name}</a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </article>
  </main>
</Layout>
