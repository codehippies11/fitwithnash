---
import { getSEO } from '~/lib/seo';
import type { InferGetStaticParamsType } from 'astro';

export const getStaticPaths = async () => {
  // In production, fetch from Strapi API
  const res = await fetch(`${import.meta.env.PUBLIC_API_URL}/instructors`, {
    headers: { Accept: 'application/json' },
  });
  const instructors = await res.json();
  return instructors.map((i: any) => ({
    params: { slug: i.slug },
  }));
};

export async function getStaticMetadata({
  params,
}: InferGetStaticParamsType<{ params: { slug: string } }>) {
  const slug = params.slug;
  // Fetch instructor details from Strapi (replace with real GraphQL client)
  const instructorRes = await fetch(
    `${import.meta.env.PUBLIC_API_URL}/instructors/${slug}`
  );
  const instructor = await instructorRes.json();

  const seo = getSEO(
    instructor.metaTitle,
    instructor.metaDesc,
    instructor.image?.formats?.large?.thumbnailUrl
  );

  return {
    title: seo.title,
    description: seo.description,
    openGraph: {
      title: seo.title,
      description: seo.description,
      images: [{ url: seo.image }],
    },
    twitter: {
      title: seo.title,
      description: seo.description,
      images: [{ url: seo.image }],
      card: 'summary_large_image',
    },
  };
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Open Graph & Twitter cards injected by getStaticMetadata */}
  </head>
  <body class="min-h-screen bg-gray-100 antialiased">
    <Layout>
      <main class="py-12 px-4 max-w-4xl mx-auto">
        <article>
          <h1 class="text-4xl font-bold mb-4">{instructor.fullName}</h1>
          <img
            src={instructor.image?.formats?.large?.thumbnailUrl}
            alt={instructor.fullName}
            class="w-full h-auto rounded mb-6"
          />
          <div class="prose max-w-none">
            <p>{instructor.bio || 'No biography available.'}</p>
          </div>
          <div class="mt-8">
            <h2 class="text-2xl font-semibold">Social Links</h2>
            <ul class="list-disc pl-5">
              {#if (instructor.social.instagram)}
                <li><a href={instructor.social.instagram.url} class="text-blue-600 hover:underline" target="_blank">Instagram</a></li>
              {/if}
              {#if (instructor.social.youtube)}
                <li><a href={instructor.social.youtube.url} class="text-red-600 hover:underline" target="_blank">YouTube</a></li>
              {/if}
              {#if (instructor.social.linkedin)}
                <li><a href={instructor.social.linkedin.url} class="text-blue-500 hover:underline" target="_blank">LinkedIn</a></li>
              {/if}
            </ul>
          </div>
        </article>
      </main>
    </Layout>
  </body>
</html>
---