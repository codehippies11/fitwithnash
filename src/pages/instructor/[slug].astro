---
import Layout from '../../layouts/Layout.astro';
export const prerender = false;
const { slug } = Astro.params;
const base = import.meta.env.PUBLIC_SUPABASE_URL;
const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
let trainer: any = null;
if (base && key && slug) {
  const res = await fetch(`${base}/rest/v1/trainers?slug=eq.${encodeURIComponent(slug)}&is_published=eq.true&select=*`, { headers: { apikey: key, Authorization: `Bearer ${key}` } });
  trainer = (await res.json())[0] || null;
}
---
<Layout title={trainer ? `${trainer.full_name} | FitWithNash` : 'Trainer | FitWithNash'} description={trainer?.meta_description || trainer?.bio || 'Meet the FitWithNash coaching team.'} noindex={!trainer}>
  <main class="trainer-page section">
    {trainer ? <article><img src={trainer.avatar_url || 'https://images.unsplash.com/photo-1538805060514-97d9cc17730c?auto=format&fit=crop&w=1200&q=85'} alt={trainer.full_name} /><div><p class="eyebrow">FitWithNash coach</p><h1 class="display">{trainer.full_name}</h1><p class="headline">{trainer.headline}</p><p>{trainer.bio}</p>{trainer.instagram_url && <a class="button" href={trainer.instagram_url}>Follow on Instagram ↗</a>}</div></article> : <section><p class="eyebrow">Not found</p><h1 class="section-title">This trainer isn’t published yet.</h1><a class="button" href="/">Back home</a></section>}
  </main>
</Layout>
<style>.trainer-page{padding-top:150px}.trainer-page article{display:grid;grid-template-columns:.85fr 1fr;gap:clamp(30px,8vw,120px);align-items:center}.trainer-page img{aspect-ratio:4/5;width:100%;object-fit:cover}.headline{color:var(--lime);font-size:20px}.trainer-page article p:not(.eyebrow):not(.headline){max-width:560px;color:var(--muted);line-height:1.8}@media(max-width:760px){.trainer-page article{grid-template-columns:1fr}}</style>
