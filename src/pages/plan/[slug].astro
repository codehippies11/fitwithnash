---
import Layout from '../../layouts/Layout.astro';

export const getStaticPaths = async () => {
  const apiUrl = import.meta.env.PUBLIC_API_URL;
  if (!apiUrl) return [];
  const headers = {
    Accept: 'application/json',
    ...(import.meta.env.CMS_API_TOKEN
      ? { Authorization: `Bearer ${import.meta.env.CMS_API_TOKEN}` }
      : {}),
  };

  const res = await fetch(`${apiUrl}/plans`, { headers });
  if (!res.ok) throw new Error(`Unable to load plans: ${res.status}`);

  const plans = await res.json();
  return Promise.all(plans.map(async ({ slug }: { slug: string }) => {
    const planRes = await fetch(`${apiUrl}/plans/${slug}`, { headers });
    if (!planRes.ok) throw new Error(`Unable to load plan ${slug}: ${planRes.status}`);
    return { params: { slug }, props: { plan: await planRes.json() } };
  }));
};

const { plan } = Astro.props;
---

<Layout>
  <main class="py-12 px-4 max-w-3xl mx-auto">
    <article>
      <h1 class="text-4xl font-bold mb-4">{plan.name}</h1>
      {plan.image?.formats?.large?.thumbnailUrl && <img src={plan.image.formats.large.thumbnailUrl} alt={plan.name} class="w-full h-48 object-cover rounded mb-6" />}
      <div class="prose max-w-none">
        <p>{plan.excerpt || 'No description available.'}</p>
        <ul class="mt-4">
          {(plan.features || []).map((feature: string) => <li>{feature}</li>)}
        </ul>
      </div>
      <div class="mt-8">
        <p class="font-medium">Price: {plan.price} {plan.currency || 'INR'}</p>
      </div>
    </article>
  </main>
</Layout>
