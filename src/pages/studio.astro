---
import Layout from '../layouts/Layout.astro';
import arunJourney from '../assets/images/journeys/arun-journey.png';
import krishamJourney from '../assets/images/journeys/krisham-journey.png';
import farbeenaJourney from '../assets/images/journeys/farbeena-journey.png';
const url = import.meta.env.PUBLIC_SUPABASE_URL || '';
const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
const websiteMedia = [
  { key: 'hero_portrait', name: 'Homepage circular coach portrait', image: null },
  { key: 'home_journey_arun', name: 'Arun journey', image: arunJourney },
  { key: 'home_journey_krisham', name: 'Krisham journey', image: krishamJourney },
  { key: 'home_journey_farbeena', name: 'Farbeena journey', image: farbeenaJourney },
  { key: 'consult_coach_portrait', name: 'Consultation funnel coach portrait', image: null },
  { key: 'consult_journey_arun', name: 'Consultation funnel — Arun journey', image: arunJourney },
  { key: 'consult_journey_krisham', name: 'Consultation funnel — Krisham journey', image: krishamJourney },
  { key: 'consult_journey_farbeena', name: 'Consultation funnel — Farbeena journey', image: farbeenaJourney },
];
---
<Layout title="FitWithNash Studio" bare noindex>
  <main class="studio">
    {url && key ? <><section id="login-view" class="login-view"><p class="eyebrow">FitWithNash / private CMS</p><h1>Content studio</h1><p>Sign in to manage the live website.</p><form id="login"><label>CMS ID or email<input name="email" type="text" autocomplete="username" required /></label><label>Password<div class="password-field"><input name="password" type="password" autocomplete="current-password" required /><button id="toggle-password" type="button" aria-label="Show password">Show</button></div></label><button class="button">Sign in <span>→</span></button></form></section>
      <section id="editor" hidden>
        <header class="studio-dashboard"><div><p class="eyebrow">CMS dashboard</p><h1>FitWithNash content studio</h1><p id="account" class="account"></p></div><button id="sign-out" type="button" class="text-button">Sign out</button></header>
        <nav class="studio-tabs" aria-label="CMS sections"><button type="button" class="is-active" data-tab="dashboard">Dashboard</button><button type="button" data-tab="website">Website images</button><button type="button" data-tab="programs">Programs & packages</button><button type="button" data-tab="journeys">Journey stories</button><button type="button" data-tab="testimonials">Testimonials</button><button type="button" data-tab="trainers">Trainers</button></nav>
        <section class="cms-panel cms-overview" data-panel="dashboard"><div class="panel-heading"><p class="eyebrow">Welcome to FitWithNash Studio</p><h2>What would you like to manage?</h2><p>Choose an area below. Every published change is saved to Supabase and appears on the live website automatically.</p></div><div class="dashboard-nav"><article><b>01</b><h3>Website images</h3><p>Replace the coach portrait and the transformation photos already shown on the website.</p><button type="button" class="text-button" data-open-tab="website">Manage images →</button></article><article><b>02</b><h3>Programs & packages</h3><p>Create offers with rates, personal sales copy, display order and images for the homepage.</p><button type="button" class="text-button" data-open-tab="programs">Manage offers →</button></article><article><b>03</b><h3>Journey stories</h3><p>Publish client transformations with before/after images and an authentic story.</p><button type="button" class="text-button" data-open-tab="journeys">Manage journeys →</button></article><article><b>04</b><h3>Trainers</h3><p>Create and publish trainer profile pages, bios, Instagram links and profile images.</p><button type="button" class="text-button" data-open-tab="trainers">Manage trainers →</button></article></div></section>
        <section class="cms-panel" data-panel="website" hidden><div class="panel-heading"><p class="eyebrow">Live website</p><h2>Replace deployed images</h2><p>The first card controls the circular profile image in the homepage hero. Select an image, upload a replacement and save—it updates the website without a GitHub commit.</p></div><div id="website-media-list" class="website-media-list" aria-live="polite">{websiteMedia.map((item) => <article class="media-card" data-media-key={item.key}><div class="media-card__image">{item.image ? <img src={item.image.src} alt={item.name} loading="lazy" /> : <span>Coach<br />portrait</span>}</div><div><strong>{item.name}</strong><small>Live image</small><button type="button" class="text-button" data-edit-media={item.key}>Replace image</button></div></article>)}</div><form id="site-media" class="cms-form"><div class="form-heading"><div><p class="form-kicker">Image editor</p><h2 id="site-media-title">Choose a live image above</h2></div></div><input name="key" type="hidden" /><label>Replacement image<input name="image" type="file" accept="image/*" required /></label><img id="site-media-preview" hidden alt="Current live image" /><div class="image-actions"><button class="button" disabled>Save live image <span>→</span></button><button id="remove-site-media" type="button" class="text-button" hidden>Remove live image</button></div></form></section>
        <section class="cms-panel" data-panel="programs" hidden><div class="panel-heading"><p class="eyebrow">Homepage offers</p><h2>Programs & packages</h2><p>Set the program name, sales copy, price, image and display order. Published offers replace the homepage placeholders immediately.</p></div><section class="story-panel"><div class="story-panel__heading"><h2>Saved offers</h2><button id="new-program" type="button" class="text-button">New offer</button></div><div id="program-list" class="story-list" aria-live="polite"></div></section><form id="program" class="cms-form"><input name="id" type="hidden" /><p id="program-mode" class="form-kicker">Create a new offer</p><input name="label" placeholder="Label e.g. 01 / Online coaching" required /><input name="slug" placeholder="program-slug" required /><input name="title" placeholder="Program or package title" required /><textarea name="description" placeholder="Clear, personal sales description" required></textarea><input name="price" placeholder="Price e.g. From ₹4,999 / month" required /><input name="sort_order" type="number" min="0" value="0" placeholder="Display order" /><label>Program image <small>Leave empty to keep the existing image.</small><input name="image" type="file" accept="image/*" /><img id="program-preview" hidden alt="Current program image" /></label><label class="check"><input name="published" type="checkbox" /> Publish this offer on the homepage</label><button class="button" id="save-program">Save offer <span>→</span></button></form></section>
        <section class="cms-panel" data-panel="journeys" hidden><div class="panel-heading"><p class="eyebrow">Client transformations</p><h2>Journey stories</h2><p>Create a new story or edit any CMS journey, including both before and after images.</p></div><section class="story-panel"><div class="story-panel__heading"><h2>Saved journeys</h2><button id="new-story" type="button" class="text-button">New story</button></div><div id="story-list" class="story-list" aria-live="polite"></div></section><form id="story" class="cms-form"><input name="id" type="hidden" /><p id="story-mode" class="form-kicker">Create a new journey</p><input name="client_name" placeholder="Client name" required /><input name="slug" placeholder="story-slug" required /><input name="title" placeholder="Transformation title" required /><textarea name="story" placeholder="Write the client's realistic coaching story and result" required></textarea><div class="image-fields"><label>Before image <small>Leave empty to keep the existing image.</small><input name="before" type="file" accept="image/*" /><img id="before-preview" hidden alt="Current before image" /></label><label>After image <small>Leave empty to keep the existing image.</small><input name="after" type="file" accept="image/*" /><img id="after-preview" hidden alt="Current after image" /></label></div><label class="check"><input name="published" type="checkbox" /> Publish this story</label><button class="button" id="save-story">Save story <span>→</span></button></form></section>
        <section class="cms-panel" data-panel="testimonials" hidden><div class="panel-heading"><p class="eyebrow">Social proof</p><h2>Client testimonials</h2><p>Add genuine feedback, optional proof images, display order and publication status for the website.</p></div><section class="story-panel"><div class="story-panel__heading"><h2>Saved testimonials</h2><button id="new-testimonial" type="button" class="text-button">New testimonial</button></div><div id="testimonial-list" class="story-list" aria-live="polite"></div></section><form id="testimonial" class="cms-form"><input name="id" type="hidden" /><p id="testimonial-mode" class="form-kicker">Create a new testimonial</p><input name="client_name" placeholder="Client name" required /><textarea name="quote" placeholder="Client feedback" required></textarea><input name="sort_order" type="number" min="0" value="0" placeholder="Display order" /><label>Proof image <small>Leave empty to keep the existing image.</small><input name="image" type="file" accept="image/*" /><img id="testimonial-preview" hidden alt="Current testimonial image" /></label><label class="check"><input name="published" type="checkbox" /> Publish this testimonial</label><div class="image-actions"><button class="button" id="save-testimonial">Save testimonial <span>→</span></button><button id="delete-testimonial" type="button" class="text-button" hidden>Delete testimonial</button></div></form></section>
        <section class="cms-panel" data-panel="trainers" hidden><div class="panel-heading"><p class="eyebrow">Coach profiles</p><h2>Trainers</h2><p>Add, review and publish trainer pages.</p></div><div id="trainer-list" class="trainer-list" aria-live="polite"></div><form id="trainer" class="cms-form"><input name="id" type="hidden" /><input name="full_name" placeholder="Trainer name" required /><input name="slug" placeholder="trainer-slug" required /><input name="headline" placeholder="Headline" /><textarea name="bio" placeholder="Bio"></textarea><input name="instagram_url" placeholder="Instagram URL" /><label>Profile image <small>Leave empty to keep the existing image.</small><input name="image" type="file" accept="image/*" /></label><label class="check"><input name="published" type="checkbox" /> Publish this trainer</label><button class="button">Save trainer <span>→</span></button></form></section>
      </section><p id="status" role="status"></p></> : <p class="setup-error">Configure <code>PUBLIC_SUPABASE_URL</code> and <code>PUBLIC_SUPABASE_ANON_KEY</code> in Vercel, then redeploy.</p>}
  </main>
</Layout>
<script>
  import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';
  const url = import.meta.env.PUBLIC_SUPABASE_URL || '';
  const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
  if (url && key) {
    const supabase = createClient(url, key);
    const login = document.querySelector('#login'); const loginView = document.querySelector('#login-view'); const editor = document.querySelector('#editor');
    const trainer = document.querySelector('#trainer'); const story = document.querySelector('#story'); const program = document.querySelector('#program');
    const status = document.querySelector('#status'); const storyList = document.querySelector('#story-list'); const trainerList = document.querySelector('#trainer-list');
    const newStory = document.querySelector('#new-story'); const storyMode = document.querySelector('#story-mode'); const account = document.querySelector('#account'); const signOut = document.querySelector('#sign-out'); const togglePassword = document.querySelector('#toggle-password');
    const beforePreview = document.querySelector('#before-preview'); const afterPreview = document.querySelector('#after-preview');
    const programList = document.querySelector('#program-list'); const newProgram = document.querySelector('#new-program'); const programMode = document.querySelector('#program-mode'); const programPreview = document.querySelector('#program-preview');
    const testimonial = document.querySelector('#testimonial'); const testimonialList = document.querySelector('#testimonial-list'); const newTestimonial = document.querySelector('#new-testimonial'); const testimonialMode = document.querySelector('#testimonial-mode'); const testimonialPreview = document.querySelector('#testimonial-preview'); const deleteTestimonial = document.querySelector('#delete-testimonial');
    const siteMedia = document.querySelector('#site-media'); const siteMediaTitle = document.querySelector('#site-media-title'); const siteMediaPreview = document.querySelector('#site-media-preview'); const removeSiteMedia = document.querySelector('#remove-site-media'); const mediaList = document.querySelector('#website-media-list');
    const tabs = document.querySelectorAll('[data-tab]'); const panels = document.querySelectorAll('[data-panel]');
    let stories = [];
    let programs = [];
    let testimonials = [];
    let liveMedia = {};
    const setStatus = (message) => { status.textContent = message; };
    const upload = async (file) => {
      if (!(file instanceof File) || !file.size) return null;
      const path = `${crypto.randomUUID()}-${file.name.replace(/[^a-zA-Z0-9._-]/g, '-')}`;
      const result = await supabase.storage.from('cms-images').upload(path, file, { upsert: false });
      if (result.error) throw result.error;
      return supabase.storage.from('cms-images').getPublicUrl(path).data.publicUrl;
    };
    const resetStory = () => {
      story.reset(); story.elements.id.value = ''; storyMode.textContent = 'Create a new journey';
      beforePreview.hidden = true; afterPreview.hidden = true; beforePreview.removeAttribute('src'); afterPreview.removeAttribute('src');
      document.querySelector('#save-story').textContent = 'Publish story';
    };
    const populateStory = (item) => {
      story.elements.id.value = item.id; story.elements.client_name.value = item.client_name; story.elements.slug.value = item.slug;
      story.elements.title.value = item.title; story.elements.story.value = item.story; story.elements.published.checked = item.is_published;
      storyMode.textContent = `Editing ${item.client_name}'s journey`;
      [['before', beforePreview, item.before_image_url], ['after', afterPreview, item.after_image_url]].forEach(([, preview, source]) => { if (source) { preview.src = source; preview.hidden = false; } else preview.hidden = true; });
      document.querySelector('#save-story').textContent = 'Update story'; story.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };
    const escapeHtml = (value) => String(value || '').replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[char]);
    const renderStories = () => {
      storyList.innerHTML = stories.length ? stories.map((item) => `<article class="story-row"><div class="story-row__thumb">${item.after_image_url ? `<img src="${escapeHtml(item.after_image_url)}" alt="" />` : '<span>NO IMAGE</span>'}</div><div><strong>${escapeHtml(item.client_name)}</strong><p>${escapeHtml(item.title)}</p><small>${item.is_published ? 'Published' : 'Draft'}</small></div><div class="row-actions"><button type="button" data-edit="${item.id}" class="text-button">Edit</button><button type="button" data-delete-story="${item.id}" class="text-button danger">Delete</button></div></article>`).join('') : '<p class="empty">No journeys yet. Create the first one below.</p>';
      storyList.querySelectorAll('[data-edit]').forEach((button) => button.addEventListener('click', () => populateStory(stories.find((item) => item.id === button.dataset.edit))));
      storyList.querySelectorAll('[data-delete-story]').forEach((button) => button.addEventListener('click', async () => { if (!window.confirm('Delete this journey? This cannot be undone.')) return; const result = await supabase.from('transformations').delete().eq('id', button.dataset.deleteStory); setStatus(result.error?.message || 'Journey deleted.'); if (!result.error) await loadStories(); }));
    };
    const renderTrainers = (trainers) => { trainerList.innerHTML = trainers.length ? trainers.map((item) => `<article class="trainer-row">${item.avatar_url ? `<img src="${escapeHtml(item.avatar_url)}" alt="" />` : '<span>FWN</span>'}<div><strong>${escapeHtml(item.full_name)}</strong><p>${escapeHtml(item.headline || 'Trainer profile')}</p><small>${item.is_published ? 'Published' : 'Draft'} · /instructor/${escapeHtml(item.slug)}</small></div><div class="row-actions"><button type="button" data-edit-trainer="${item.id}" class="text-button">Edit</button><button type="button" data-delete-trainer="${item.id}" class="text-button danger">Delete</button></div></article>`).join('') : '<p class="empty">No CMS trainers yet. Create one in the Trainer profile form.</p>'; trainerList.querySelectorAll('[data-edit-trainer]').forEach((button) => button.addEventListener('click', () => { const item = trainers.find((entry) => entry.id === button.dataset.editTrainer); trainer.elements.id.value = item.id; trainer.elements.full_name.value = item.full_name; trainer.elements.slug.value = item.slug; trainer.elements.headline.value = item.headline || ''; trainer.elements.bio.value = item.bio || ''; trainer.elements.instagram_url.value = item.instagram_url || ''; trainer.elements.published.checked = item.is_published; trainer.scrollIntoView({ behavior: 'smooth', block: 'start' }); })); trainerList.querySelectorAll('[data-delete-trainer]').forEach((button) => button.addEventListener('click', async () => { if (!window.confirm('Delete this trainer?')) return; const result = await supabase.from('trainers').delete().eq('id', button.dataset.deleteTrainer); setStatus(result.error?.message || 'Trainer deleted.'); if (!result.error) await loadTrainers(); })); };
    const loadTrainers = async () => { const result = await supabase.from('trainers').select('*').order('created_at', { ascending: false }); if (result.error) throw result.error; renderTrainers(result.data || []); };
    const loadStories = async () => { const result = await supabase.from('transformations').select('*').order('created_at', { ascending: false }); if (result.error) throw result.error; stories = result.data || []; renderStories(); };
    const resetProgram = () => { program.reset(); program.elements.id.value = ''; program.elements.sort_order.value = '0'; programMode.textContent = 'Create a new offer'; programPreview.hidden = true; programPreview.removeAttribute('src'); document.querySelector('#save-program').textContent = 'Save offer →'; };
    const populateProgram = (item) => { program.elements.id.value = item.id; program.elements.label.value = item.label; program.elements.slug.value = item.slug; program.elements.title.value = item.title; program.elements.description.value = item.description; program.elements.price.value = item.price; program.elements.sort_order.value = item.sort_order || 0; program.elements.published.checked = item.is_published; programMode.textContent = `Editing ${item.title}`; if (item.image_url) { programPreview.src = item.image_url; programPreview.hidden = false; } else programPreview.hidden = true; document.querySelector('#save-program').textContent = 'Update offer →'; program.scrollIntoView({ behavior: 'smooth', block: 'start' }); };
    const renderPrograms = () => { programList.innerHTML = programs.length ? programs.map((item) => `<article class="story-row"><div class="story-row__thumb">${item.image_url ? `<img src="${escapeHtml(item.image_url)}" alt="" />` : '<span>NO IMAGE</span>'}</div><div><strong>${escapeHtml(item.title)}</strong><p>${escapeHtml(item.price)} · ${escapeHtml(item.label)}</p><small>${item.is_published ? 'Published' : 'Draft'}</small></div><div class="row-actions"><button type="button" data-edit-program="${item.id}" class="text-button">Edit</button><button type="button" data-delete-program="${item.id}" class="text-button danger">Delete</button></div></article>`).join('') : '<p class="empty">No offers yet. The homepage placeholders remain visible.</p>'; programList.querySelectorAll('[data-edit-program]').forEach((button) => button.addEventListener('click', () => populateProgram(programs.find((item) => item.id === button.dataset.editProgram)))); programList.querySelectorAll('[data-delete-program]').forEach((button) => button.addEventListener('click', async () => { if (!window.confirm('Delete this offer?')) return; const result = await supabase.from('programs').delete().eq('id', button.dataset.deleteProgram); setStatus(result.error?.message || 'Offer deleted.'); if (!result.error) await loadPrograms(); })); };
    const loadPrograms = async () => { const result = await supabase.from('programs').select('*').order('sort_order', { ascending: true }).order('created_at', { ascending: true }); if (result.error) throw result.error; programs = result.data || []; renderPrograms(); };
    const resetTestimonial = () => { testimonial.reset(); testimonial.elements.id.value = ''; testimonial.elements.sort_order.value = '0'; testimonialMode.textContent = 'Create a new testimonial'; testimonialPreview.hidden = true; testimonialPreview.removeAttribute('src'); deleteTestimonial.hidden = true; };
    const populateTestimonial = (item) => { testimonial.elements.id.value = item.id; testimonial.elements.client_name.value = item.client_name; testimonial.elements.quote.value = item.quote; testimonial.elements.sort_order.value = item.sort_order || 0; testimonial.elements.published.checked = item.is_published; testimonialMode.textContent = `Editing ${item.client_name}'s testimonial`; if (item.image_url) { testimonialPreview.src = item.image_url; testimonialPreview.hidden = false; } else testimonialPreview.hidden = true; deleteTestimonial.hidden = false; testimonial.scrollIntoView({ behavior: 'smooth', block: 'start' }); };
    const renderTestimonials = () => { testimonialList.innerHTML = testimonials.length ? testimonials.map((item) => `<article class="story-row"><div class="story-row__thumb">${item.image_url ? `<img src="${escapeHtml(item.image_url)}" alt="" />` : '<span>QUOTE</span>'}</div><div><strong>${escapeHtml(item.client_name)}</strong><p>${escapeHtml(item.quote)}</p><small>${item.is_published ? 'Published' : 'Draft'}</small></div><button type="button" data-edit-testimonial="${item.id}" class="text-button">Edit</button></article>`).join('') : '<p class="empty">No testimonials yet. Create the first one below.</p>'; testimonialList.querySelectorAll('[data-edit-testimonial]').forEach((button) => button.addEventListener('click', () => populateTestimonial(testimonials.find((item) => item.id === button.dataset.editTestimonial)))); };
    const loadTestimonials = async () => { const result = await supabase.from('testimonials').select('*').order('sort_order', { ascending: true }).order('created_at', { ascending: true }); if (result.error) throw result.error; testimonials = result.data || []; renderTestimonials(); };
    const renderLiveMedia = () => { mediaList?.querySelectorAll('[data-media-key]').forEach((card) => { const item = liveMedia[card.dataset.mediaKey]; const image = card.querySelector('img'); if (item?.image_url) { if (image) image.src = item.image_url; else card.querySelector('.media-card__image').innerHTML = `<img src="${item.image_url}" alt="" />`; } }); };
    const loadLiveMedia = async () => { const result = await supabase.from('site_media').select('*'); if (result.error) throw result.error; liveMedia = Object.fromEntries((result.data || []).map((item) => [item.key, item])); renderLiveMedia(); };
    const selectMedia = (mediaKey) => { const card = mediaList?.querySelector(`[data-media-key="${mediaKey}"]`); const name = card?.querySelector('strong')?.textContent || 'Website image'; const image = card?.querySelector('img'); siteMedia.reset(); siteMedia.elements.key.value = mediaKey; siteMediaTitle.textContent = `Replace ${name}`; siteMedia.querySelector('.button').disabled = false; removeSiteMedia.hidden = !liveMedia[mediaKey]; if (image?.src) { siteMediaPreview.src = image.src; siteMediaPreview.hidden = false; } else siteMediaPreview.hidden = true; siteMedia.scrollIntoView({ behavior: 'smooth', block: 'center' }); };
    const showTab = (name) => { tabs.forEach((tab) => tab.classList.toggle('is-active', tab.dataset.tab === name)); panels.forEach((panel) => { panel.hidden = panel.dataset.panel !== name; }); };
    const enterStudio = async () => { const { data: { user } } = await supabase.auth.getUser(); loginView.hidden = true; editor.hidden = false; account.textContent = user?.email ? `Signed in as ${user.email.replace('.local', '')}` : 'Signed in'; try { await Promise.all([loadStories(), loadTrainers(), loadLiveMedia(), loadPrograms(), loadTestimonials()]); } catch (error) { setStatus(error.message); } };
    const loginEmail = (value) => { const id = String(value || '').trim().toLowerCase(); return id.endsWith('@fitwithnash') ? `${id}.local` : id; };
    login?.addEventListener('submit', async (event) => { event.preventDefault(); const form = new FormData(login); const result = await supabase.auth.signInWithPassword({ email: loginEmail(form.get('email')), password: form.get('password') }); setStatus(result.error?.message || 'Signed in.'); if (!result.error) await enterStudio(); });
    trainer?.addEventListener('submit', async (event) => { event.preventDefault(); const form = new FormData(trainer); const editing = form.get('id'); try { const current = await supabase.from('trainers').select('avatar_url').eq('id', editing).maybeSingle(); const avatar = await upload(form.get('image')); const payload = { full_name: form.get('full_name'), slug: form.get('slug'), headline: form.get('headline'), bio: form.get('bio'), instagram_url: form.get('instagram_url'), avatar_url: avatar || current.data?.avatar_url || null, is_published: form.get('published') === 'on' }; const result = editing ? await supabase.from('trainers').update(payload).eq('id', editing) : await supabase.from('trainers').insert(payload); setStatus(result.error?.message || `Trainer saved: /instructor/${form.get('slug')}`); if (!result.error) { trainer.reset(); await loadTrainers(); } } catch (error) { setStatus(error.message); } });
    story?.addEventListener('submit', async (event) => { event.preventDefault(); const form = new FormData(story); const editing = form.get('id'); try { const old = stories.find((item) => item.id === editing); const before = await upload(form.get('before')); const after = await upload(form.get('after')); const payload = { client_name: form.get('client_name'), slug: form.get('slug'), title: form.get('title'), story: form.get('story'), is_published: form.get('published') === 'on', before_image_url: before || old?.before_image_url || null, after_image_url: after || old?.after_image_url || null }; const result = editing ? await supabase.from('transformations').update(payload).eq('id', editing) : await supabase.from('transformations').insert(payload); if (result.error) throw result.error; setStatus(editing ? 'Transformation updated.' : 'Transformation saved.'); resetStory(); await loadStories(); } catch (error) { setStatus(error.message); } });
    program?.addEventListener('submit', async (event) => { event.preventDefault(); const form = new FormData(program); const editing = form.get('id'); try { const old = programs.find((item) => item.id === editing); const imageUrl = await upload(form.get('image')); const payload = { label: form.get('label'), slug: form.get('slug'), title: form.get('title'), description: form.get('description'), price: form.get('price'), sort_order: Number(form.get('sort_order')) || 0, image_url: imageUrl || old?.image_url || null, is_published: form.get('published') === 'on' }; const result = editing ? await supabase.from('programs').update(payload).eq('id', editing) : await supabase.from('programs').insert(payload); if (result.error) throw result.error; setStatus(editing ? 'Offer updated.' : 'Offer saved.'); resetProgram(); await loadPrograms(); } catch (error) { setStatus(error.message); } });
    testimonial?.addEventListener('submit', async (event) => { event.preventDefault(); const form = new FormData(testimonial); const editing = form.get('id'); try { const old = testimonials.find((item) => item.id === editing); const imageUrl = await upload(form.get('image')); const payload = { client_name: form.get('client_name'), quote: form.get('quote'), sort_order: Number(form.get('sort_order')) || 0, image_url: imageUrl || old?.image_url || null, is_published: form.get('published') === 'on' }; const result = editing ? await supabase.from('testimonials').update(payload).eq('id', editing) : await supabase.from('testimonials').insert(payload); if (result.error) throw result.error; setStatus(editing ? 'Testimonial updated.' : 'Testimonial saved.'); resetTestimonial(); await loadTestimonials(); } catch (error) { setStatus(error.message); } });
    deleteTestimonial?.addEventListener('click', async () => { const id = testimonial.elements.id.value; if (!id || !window.confirm('Delete this testimonial? This cannot be undone.')) return; const result = await supabase.from('testimonials').delete().eq('id', id); setStatus(result.error?.message || 'Testimonial deleted.'); if (!result.error) { resetTestimonial(); await loadTestimonials(); } });
    siteMedia?.addEventListener('submit', async (event) => { event.preventDefault(); const form = new FormData(siteMedia); try { const imageUrl = await upload(form.get('image')); if (!imageUrl) throw new Error('Choose an image first.'); const result = await supabase.from('site_media').upsert({ key: form.get('key'), image_url: imageUrl, updated_at: new Date().toISOString() }); if (result.error) throw result.error; setStatus('Live website image updated.'); await loadLiveMedia(); selectMedia(form.get('key')); } catch (error) { setStatus(error.message); } });
    removeSiteMedia?.addEventListener('click', async () => { const mediaKey = siteMedia.elements.key.value; if (!mediaKey) return; if (!window.confirm('Remove this live image override and restore the website default?')) return; try { const result = await supabase.from('site_media').delete().eq('key', mediaKey); if (result.error) throw result.error; setStatus('Live image removed. The website default is restored.'); await loadLiveMedia(); selectMedia(mediaKey); } catch (error) { setStatus(error.message); } });
    newStory?.addEventListener('click', resetStory);
    newProgram?.addEventListener('click', resetProgram);
    newTestimonial?.addEventListener('click', resetTestimonial);
    mediaList?.querySelectorAll('[data-edit-media]').forEach((button) => button.addEventListener('click', () => selectMedia(button.dataset.editMedia)));
    tabs.forEach((tab) => tab.addEventListener('click', () => showTab(tab.dataset.tab)));
    document.querySelectorAll('[data-open-tab]').forEach((button) => button.addEventListener('click', () => showTab(button.dataset.openTab)));
    togglePassword?.addEventListener('click', () => { const field = login?.elements.password; const visible = field?.type === 'text'; field.type = visible ? 'password' : 'text'; togglePassword.textContent = visible ? 'Show' : 'Hide'; togglePassword.setAttribute('aria-label', visible ? 'Show password' : 'Hide password'); });
    signOut?.addEventListener('click', async () => { await supabase.auth.signOut(); editor.hidden = true; loginView.hidden = false; login.reset(); setStatus('Signed out.'); });
    supabase.auth.getSession().then(({ data }) => { if (data.session) enterStudio(); });
  }
</script>
<style>
  .studio{min-height:100svh;padding:clamp(28px,7vw,88px);background:radial-gradient(circle at 88% 8%,#313924,transparent 32%),var(--ink)}.login-view{display:grid;gap:20px;width:min(100%,470px);min-height:calc(100svh - clamp(56px,14vw,176px));align-content:center;margin:auto}.login-view h1,.studio-dashboard h1{margin:0;font:600 clamp(2.6rem,5vw,5.2rem)/.9 "Playfair Display",serif;letter-spacing:-.06em}.login-view>p:not(.eyebrow),.panel-heading>p:not(.eyebrow){margin:0;color:var(--muted);line-height:1.65}.studio form{display:grid;gap:16px;margin:0}.login-view form{margin-top:10px;padding:25px;background:#20231e;border:1px solid var(--line)}.studio input,.studio textarea{width:100%;box-sizing:border-box;padding:14px;background:#171916;color:var(--paper);border:1px solid var(--line);font:inherit}.studio textarea{min-height:130px;resize:vertical}.studio label{display:grid;gap:7px;color:#d8d9d2;font-size:13px;font-weight:700}.password-field{display:flex}.password-field input{min-width:0;flex:1}.password-field button{padding:0 14px;border:1px solid var(--line);border-left:0;background:#2a2d27;color:var(--lime);font:700 12px inherit;cursor:pointer}.studio>#editor[hidden],.cms-panel[hidden]{display:none}.studio-dashboard{display:flex;justify-content:space-between;gap:24px;padding:clamp(24px,4vw,45px);background:#20231e;border:1px solid var(--line)}.account{margin:13px 0 0;color:var(--muted);font-size:13px}.studio-tabs{display:flex;gap:8px;overflow:auto;margin:20px 0}.studio-tabs button{flex:none;padding:11px 15px;border:1px solid var(--line);background:#1b1d1a;color:var(--paper);font:700 12px Manrope,sans-serif;cursor:pointer}.studio-tabs button.is-active{background:var(--lime);color:var(--ink);border-color:var(--lime)}.cms-panel{display:grid;gap:20px;padding:clamp(20px,3vw,36px);background:#20231e;border:1px solid var(--line)}.panel-heading{max-width:680px}.panel-heading h2,.form-heading h2,.story-panel h2{margin:8px 0;font:600 clamp(1.75rem,3vw,3rem)/.95 "Playfair Display",serif;letter-spacing:-.045em}.dashboard-nav{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.dashboard-nav article{display:grid;gap:11px;min-height:190px;padding:22px;background:#181a17;border:1px solid var(--line)}.dashboard-nav b{color:var(--lime);font:700 11px "DM Mono",monospace}.dashboard-nav h3{margin:0;font:600 1.55rem/1 "Playfair Display",serif}.dashboard-nav p{margin:0;color:var(--muted);font-size:13px;line-height:1.55}.dashboard-nav .text-button{margin-top:auto}.website-media-list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.media-card{min-width:0;border:1px solid var(--line);background:#181a17}.media-card__image{display:grid;place-items:center;aspect-ratio:1;background:#30342c;color:var(--muted);font:12px "DM Mono",monospace;text-align:center}.media-card__image img{width:100%;height:100%;object-fit:cover}.media-card>div:last-child{display:grid;gap:7px;padding:12px}.media-card small,.story-row small,.trainer-row small{color:var(--lime);font-size:11px}.text-button{width:max-content;padding:0;border:0;background:none;color:var(--lime);font:700 12px Manrope,sans-serif;cursor:pointer}.cms-form,.story-panel{padding:22px;background:#181a17;border:1px solid var(--line)}.cms-form>img{width:min(100%,260px);aspect-ratio:1;object-fit:contain;background:#282b26;border:1px solid var(--line)}.image-actions{display:flex;align-items:center;gap:18px;flex-wrap:wrap}.form-heading{display:flex;justify-content:space-between;gap:16px}.form-kicker{margin:0;color:var(--lime);font:700 11px "DM Mono",monospace;letter-spacing:.09em;text-transform:uppercase}.check{display:flex!important;align-items:center;gap:9px}.check input{width:auto}.story-panel__heading,.story-row,.trainer-row{display:flex;gap:16px;align-items:center;justify-content:space-between}.story-list,.trainer-list{display:grid;gap:8px;max-height:360px;overflow:auto}.story-row,.trainer-row{padding:10px;background:#20231e;border:1px solid var(--line)}.story-row>div:nth-child(2),.trainer-row>div{min-width:0;flex:1}.story-row p,.trainer-row p,.empty{margin:6px 0;color:var(--muted);font-size:13px;line-height:1.4}.story-row__thumb,.trainer-row>img,.trainer-row>span{width:56px;height:56px;flex:none;background:#30342c}.story-row__thumb img,.trainer-row>img{display:block;width:100%;height:100%;object-fit:cover}.trainer-row>span{display:grid;place-items:center;font:9px monospace;color:var(--muted)}.image-fields{display:grid;grid-template-columns:1fr 1fr;gap:12px}.image-fields img{width:100%;aspect-ratio:4/5;object-fit:contain;background:#282b26;border:1px solid var(--line)}#status{min-height:1.4em;margin:18px 0 0;color:var(--lime);font-size:13px}.setup-error{color:var(--paper)}@media(max-width:760px){.studio{padding:24px 18px}.studio-dashboard,.story-panel__heading{align-items:flex-start;flex-direction:column}.dashboard-nav,.website-media-list,.image-fields{grid-template-columns:repeat(2,minmax(0,1fr))}.media-card>div:last-child{padding:10px}.cms-panel{padding:18px}.login-view{min-height:calc(100svh - 48px)}}
</style>
