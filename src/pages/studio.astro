---
import Layout from '../layouts/Layout.astro';
const url = import.meta.env.PUBLIC_SUPABASE_URL || '';
const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
---
<Layout title="FitWithNash Studio">
  <main class="studio section"><p class="eyebrow">Private CMS</p><h1 class="section-title">Content studio</h1>
    {url && key ? <><form id="login"><input name="email" type="text" placeholder="CMS ID or email" autocomplete="username" required /><input name="password" type="password" placeholder="Password" autocomplete="current-password" required /><button class="button">Sign in</button></form>
      <div id="editor" hidden>
        <header class="studio-dashboard"><div><p class="eyebrow">CMS dashboard</p><h2>Everything you need to keep FitWithNash current.</h2><p id="account" class="account"></p></div><button id="sign-out" type="button" class="text-button">Sign out</button></header>
        <div class="studio-guide"><article><b>01</b><div><strong>Trainer profile</strong><span>Update Avinash’s details, profile image and public instructor page.</span></div></article><article><b>02</b><div><strong>Client journeys</strong><span>Create, publish and edit every transformation, story and before/after image.</span></div></article><article><b>03</b><div><strong>Live publishing</strong><span>Published edits appear on the website—no code or redeploy required.</span></div></article></div>
        <form id="trainer"><div class="form-heading"><div><p class="form-kicker">01 / Coach</p><h2>Trainer profile</h2></div><span>Public instructor page</span></div><input name="full_name" placeholder="Trainer name" required /><input name="slug" placeholder="trainer-slug" required /><input name="headline" placeholder="Headline" /><textarea name="bio" placeholder="Bio"></textarea><input name="instagram_url" placeholder="Instagram URL" /><label>Profile image<input name="image" type="file" accept="image/*" /></label><label><input name="published" type="checkbox" /> Publish this trainer</label><button class="button">Save trainer</button></form>
        <section class="story-panel"><div class="story-panel__heading"><div><h2>Transformation stories</h2><p>Edit the copy and replace either before or after image whenever a client sends a better photo.</p></div><button id="new-story" type="button" class="text-button">New story</button></div><div id="story-list" class="story-list" aria-live="polite"></div>
          <form id="story"><input name="id" type="hidden" /><p id="story-mode" class="form-kicker">Create a new journey</p><input name="client_name" placeholder="Client name" required /><input name="slug" placeholder="story-slug" required /><input name="title" placeholder="Transformation title" required /><textarea name="story" placeholder="Write the client's realistic coaching story and result" required></textarea><div class="image-fields"><label>Before image <small>Leave empty to keep the existing image.</small><input name="before" type="file" accept="image/*" /><img id="before-preview" hidden alt="Current before image" /></label><label>After image <small>Leave empty to keep the existing image.</small><input name="after" type="file" accept="image/*" /><img id="after-preview" hidden alt="Current after image" /></label></div><label><input name="published" type="checkbox" /> Publish this story</label><button class="button" id="save-story">Save story</button></form>
        </section>
      </div><p id="status" role="status"></p></> : <p>Configure <code>PUBLIC_SUPABASE_URL</code> and <code>PUBLIC_SUPABASE_ANON_KEY</code> in Vercel, then redeploy.</p>}
  </main>
</Layout>
<script define:vars={{ url, key }}>
  import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';
  if (url && key) {
    const supabase = createClient(url, key);
    const login = document.querySelector('#login'); const editor = document.querySelector('#editor');
    const trainer = document.querySelector('#trainer'); const story = document.querySelector('#story');
    const status = document.querySelector('#status'); const storyList = document.querySelector('#story-list');
    const newStory = document.querySelector('#new-story'); const storyMode = document.querySelector('#story-mode'); const account = document.querySelector('#account'); const signOut = document.querySelector('#sign-out');
    const beforePreview = document.querySelector('#before-preview'); const afterPreview = document.querySelector('#after-preview');
    let stories = [];
    const setStatus = (message) => { status.textContent = message; };
    const upload = async (file) => {
      if (!(file instanceof File) || !file.size) return null;
      const path = `${crypto.randomUUID()}-${file.name.replace(/[^a-zA-Z0-9._-]/g, '-')}`;
      const result = await supabase.storage.from('cms-images').upload(path, file, { upsert: false });
      if (result.error) throw result.error;
      return supabase.storage.from('cms-images').getPublicUrl(path).data.publicUrl;
    };
    const resetStory = () => {
      story.reset(); story.elements.id.value = ''; storyMode.textContent = 'Create a new journey';
      beforePreview.hidden = true; afterPreview.hidden = true; beforePreview.removeAttribute('src'); afterPreview.removeAttribute('src');
      document.querySelector('#save-story').textContent = 'Publish story';
    };
    const populateStory = (item) => {
      story.elements.id.value = item.id; story.elements.client_name.value = item.client_name; story.elements.slug.value = item.slug;
      story.elements.title.value = item.title; story.elements.story.value = item.story; story.elements.published.checked = item.is_published;
      storyMode.textContent = `Editing ${item.client_name}'s journey`;
      [['before', beforePreview, item.before_image_url], ['after', afterPreview, item.after_image_url]].forEach(([, preview, source]) => { if (source) { preview.src = source; preview.hidden = false; } else preview.hidden = true; });
      document.querySelector('#save-story').textContent = 'Update story'; story.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };
    const escapeHtml = (value) => String(value || '').replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[char]);
    const renderStories = () => {
      storyList.innerHTML = stories.length ? stories.map((item) => `<article class="story-row"><div class="story-row__thumb">${item.after_image_url ? `<img src="${escapeHtml(item.after_image_url)}" alt="" />` : '<span>NO IMAGE</span>'}</div><div><strong>${escapeHtml(item.client_name)}</strong><p>${escapeHtml(item.title)}</p><small>${item.is_published ? 'Published' : 'Draft'}</small></div><button type="button" data-edit="${item.id}" class="text-button">Edit</button></article>`).join('') : '<p class="empty">No journeys yet. Create the first one below.</p>';
      storyList.querySelectorAll('[data-edit]').forEach((button) => button.addEventListener('click', () => populateStory(stories.find((item) => item.id === button.dataset.edit))));
    };
    const loadStories = async () => { const result = await supabase.from('transformations').select('*').order('created_at', { ascending: false }); if (result.error) throw result.error; stories = result.data || []; renderStories(); };
    const enterStudio = async () => { const { data: { user } } = await supabase.auth.getUser(); login.hidden = true; editor.hidden = false; account.textContent = user?.email ? `Signed in as ${user.email.replace('.local', '')}` : 'Signed in'; try { await loadStories(); } catch (error) { setStatus(error.message); } };
    const loginEmail = (value) => { const id = String(value || '').trim().toLowerCase(); return id.endsWith('@fitwithnash') ? `${id}.local` : id; };
    login?.addEventListener('submit', async (event) => { event.preventDefault(); const form = new FormData(login); const result = await supabase.auth.signInWithPassword({ email: loginEmail(form.get('email')), password: form.get('password') }); setStatus(result.error?.message || 'Signed in.'); if (!result.error) await enterStudio(); });
    trainer?.addEventListener('submit', async (event) => { event.preventDefault(); const form = new FormData(trainer); try { const result = await supabase.from('trainers').insert({ full_name: form.get('full_name'), slug: form.get('slug'), headline: form.get('headline'), bio: form.get('bio'), instagram_url: form.get('instagram_url'), avatar_url: await upload(form.get('image')), is_published: form.get('published') === 'on' }); setStatus(result.error?.message || `Trainer saved: /instructor/${form.get('slug')}`); if (!result.error) trainer.reset(); } catch (error) { setStatus(error.message); } });
    story?.addEventListener('submit', async (event) => { event.preventDefault(); const form = new FormData(story); const editing = form.get('id'); try { const old = stories.find((item) => item.id === editing); const before = await upload(form.get('before')); const after = await upload(form.get('after')); const payload = { client_name: form.get('client_name'), slug: form.get('slug'), title: form.get('title'), story: form.get('story'), is_published: form.get('published') === 'on', before_image_url: before || old?.before_image_url || null, after_image_url: after || old?.after_image_url || null }; const result = editing ? await supabase.from('transformations').update(payload).eq('id', editing) : await supabase.from('transformations').insert(payload); if (result.error) throw result.error; setStatus(editing ? 'Transformation updated.' : 'Transformation saved.'); resetStory(); await loadStories(); } catch (error) { setStatus(error.message); } });
    newStory?.addEventListener('click', resetStory);
    signOut?.addEventListener('click', async () => { await supabase.auth.signOut(); editor.hidden = true; login.hidden = false; login.reset(); setStatus('Signed out.'); });
    supabase.auth.getSession().then(({ data }) => { if (data.session) enterStudio(); });
  }
</script>
<style>
  .studio{min-height:100vh;padding-top:150px}.studio>#editor{display:grid;grid-template-columns:minmax(260px,.72fr) minmax(0,1.28fr);gap:24px}.studio-dashboard,.studio-guide{grid-column:1/-1}.studio-dashboard{display:flex;align-items:flex-start;justify-content:space-between;gap:22px;padding:28px;border:1px solid var(--line);background:linear-gradient(120deg,#22261f,#161816)}.studio-dashboard h2{max-width:650px;font:600 clamp(1.8rem,3vw,3rem)/.95 "Playfair Display",serif;letter-spacing:-.04em}.account{margin:12px 0 0;color:var(--muted);font-size:13px}.studio-guide{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}.studio-guide article{display:flex;gap:13px;padding:18px;background:#20231e}.studio-guide b{color:var(--lime);font:700 12px "DM Mono",monospace}.studio-guide strong,.studio-guide span{display:block}.studio-guide span{margin-top:6px;color:var(--muted);font-size:12px;line-height:1.45}.studio form,.story-panel{display:grid;gap:14px;margin:0;padding:25px;background:#20231e}.studio h2{margin:0;color:var(--lime)}.studio input,.studio textarea{padding:14px;background:#20231e;color:var(--paper);border:1px solid var(--line);font:inherit}.studio textarea{min-height:130px;resize:vertical}.studio label{display:grid;gap:7px;font-size:13px}.studio small{color:var(--muted);font-weight:400}.studio code{color:var(--lime)}.story-panel{margin:0}.form-heading,.story-panel__heading,.story-row{display:flex;gap:16px;align-items:center;justify-content:space-between}.form-heading>span{color:var(--muted);font-size:12px}.story-panel__heading p,.story-row p,.empty{margin:7px 0 0;color:var(--muted);font-size:14px;line-height:1.45}.story-list{display:grid;gap:8px;max-height:320px;overflow:auto}.story-row{justify-content:flex-start;padding:9px;background:#181a17;border:1px solid var(--line)}.story-row>div:nth-child(2){min-width:0;flex:1}.story-row small{color:var(--lime)}.story-row__thumb{width:54px;height:54px;flex:none;background:#30342c}.story-row__thumb img{display:block;width:100%;height:100%;object-fit:cover}.story-row__thumb span{display:grid;height:100%;place-items:center;font:8px monospace;color:var(--muted)}.text-button{border:0;background:none;color:var(--lime);font:700 12px inherit;cursor:pointer}.form-kicker{margin:0;color:var(--lime);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.09em}.image-fields{display:grid;grid-template-columns:1fr 1fr;gap:12px}.image-fields img{width:100%;aspect-ratio:4/5;object-fit:cover;border:1px solid var(--line)}@media(max-width:760px){.studio>#editor,.image-fields,.studio-guide{grid-template-columns:1fr}.studio-dashboard,.story-panel__heading,.form-heading{align-items:flex-start}.studio-dashboard{flex-direction:column}.story-row{align-items:center}}
</style>
