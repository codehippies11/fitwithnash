---
import Layout from '../layouts/Layout.astro';
const url = import.meta.env.PUBLIC_SUPABASE_URL || '';
const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
---
<Layout title="FitWithNash Studio">
  <main class="studio section"><p class="eyebrow">Private CMS</p><h1 class="section-title">Content studio</h1>
    {url && key ? <><form id="login"><input type="email" placeholder="Email" required /><input type="password" placeholder="Password" required /><button class="button">Sign in</button></form>
      <div id="editor" hidden><form id="trainer"><h2>Trainer</h2><input name="full_name" placeholder="Trainer name" required /><input name="slug" placeholder="trainer-slug" required /><input name="headline" placeholder="Headline" /><textarea name="bio" placeholder="Bio"></textarea><input name="instagram_url" placeholder="Instagram URL" /><input name="image" type="file" accept="image/*" /><label><input name="published" type="checkbox" /> Publish this trainer</label><button class="button">Save trainer</button></form>
      <form id="story"><h2>Transformation story</h2><input name="client_name" placeholder="Client name" required /><input name="slug" placeholder="story-slug" required /><input name="title" placeholder="Transformation title" required /><textarea name="story" placeholder="Their journey and result" required></textarea><label>Before image<input name="before" type="file" accept="image/*" /></label><label>After image<input name="after" type="file" accept="image/*" /></label><label><input name="published" type="checkbox" /> Publish this story</label><button class="button">Save story</button></form></div><p id="status"></p></> : <p>Configure <code>PUBLIC_SUPABASE_URL</code> and <code>PUBLIC_SUPABASE_ANON_KEY</code> in Vercel, then redeploy.</p>}
  </main>
</Layout>
<script define:vars={{ url, key }}>
  import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';
  if (url && key) { const supabase=createClient(url,key); const login=document.querySelector('#login'); const editor=document.querySelector('#editor'); const trainer=document.querySelector('#trainer'); const story=document.querySelector('#story'); const status=document.querySelector('#status'); const upload=async(file)=>{if(!(file instanceof File)||!file.size)return null;const path=`${crypto.randomUUID()}-${file.name}`;const result=await supabase.storage.from('cms-images').upload(path,file);if(result.error)throw result.error;return supabase.storage.from('cms-images').getPublicUrl(path).data.publicUrl}; login?.addEventListener('submit',async(e)=>{e.preventDefault();const f=new FormData(login);const r=await supabase.auth.signInWithPassword({email:f.get('email'),password:f.get('password')});status.textContent=r.error?.message||'Signed in.';if(!r.error){login.hidden=true;editor.hidden=false}}); trainer?.addEventListener('submit',async(e)=>{e.preventDefault();const f=new FormData(trainer);try{const r=await supabase.from('trainers').insert({full_name:f.get('full_name'),slug:f.get('slug'),headline:f.get('headline'),bio:f.get('bio'),instagram_url:f.get('instagram_url'),avatar_url:await upload(f.get('image')),is_published:f.get('published')==='on'});status.textContent=r.error?.message||`Trainer saved: /instructor/${f.get('slug')}`;if(!r.error)trainer.reset()}catch(error){status.textContent=error.message}}); story?.addEventListener('submit',async(e)=>{e.preventDefault();const f=new FormData(story);try{const r=await supabase.from('transformations').insert({client_name:f.get('client_name'),slug:f.get('slug'),title:f.get('title'),story:f.get('story'),before_image_url:await upload(f.get('before')),after_image_url:await upload(f.get('after')),is_published:f.get('published')==='on'});status.textContent=r.error?.message||'Transformation story saved.';if(!r.error)story.reset()}catch(error){status.textContent=error.message}}); }
</script>
<style>.studio{min-height:100vh;padding-top:150px}.studio>#editor{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.studio form{display:grid;max-width:560px;gap:14px;margin:34px 0;padding:25px;background:#20231e}.studio h2{margin:0;color:var(--lime)}.studio input,.studio textarea{padding:14px;background:#20231e;color:var(--paper);border:1px solid var(--line);font:inherit}.studio label{display:grid;gap:7px;font-size:13px}.studio code{color:var(--lime)}@media(max-width:760px){.studio>#editor{grid-template-columns:1fr}}</style>
