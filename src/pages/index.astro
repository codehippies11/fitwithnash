---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import avinashProfile from '../assets/images/avinash-profile-real.png';
import coaching from '../assets/images/avinash-coaching.png';
import arunJourney from '../assets/images/journeys/arun-journey.png';
import krishamJourney from '../assets/images/journeys/krisham-journey.png';
import farbeenaJourney from '../assets/images/journeys/farbeena-journey.png';

const programs = [
  { label: '01 / Foundation', title: 'Build a body that lasts.', text: 'A progressive strength system for a powerful, capable baseline.', image: 'https://images.unsplash.com/photo-1583454110551-21f2fa2afe61?auto=format&fit=crop&w=1000&q=82' },
  { label: '02 / Performance', title: 'Train with intent.', text: 'Structured programming for strength, muscle and athletic movement.', image: 'https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&w=1000&q=82' },
  { label: '03 / Lifestyle', title: 'Make consistency normal.', text: 'Simple nutrition and habits that fit an ambitious real life.', image: 'https://images.unsplash.com/photo-1517836357463-d25dfeac3438?auto=format&fit=crop&w=1000&q=82' },
];

const posts = [
  { category: 'Training notes', title: 'The training split that earns your consistency.', image: 'https://images.unsplash.com/photo-1518611012118-696072aa579a?auto=format&fit=crop&w=1000&q=82' },
  { category: 'Nutrition', title: 'Stop restarting your nutrition every Monday.', image: 'https://images.unsplash.com/photo-1490645935967-10de6ba17061?auto=format&fit=crop&w=1000&q=82' },
  { category: 'Mindset', title: 'Your plan is only as good as your recovery.', image: 'https://images.unsplash.com/photo-1538805060514-97d9cc17730c?auto=format&fit=crop&w=1000&q=82' },
];

const journeys = [
  { image: arunJourney, name: 'Arun', title: 'A standard built through phases.', detail: 'Fat loss, maintenance and muscle gain—built through patient work.' },
  { image: krishamJourney, name: 'Krisham', title: 'Consistency, made visible.', detail: 'A stronger physique shaped by the routine behind it.' },
  { image: farbeenaJourney, name: 'Farbeena', title: 'Progress that changes daily life.', detail: 'A journey that puts strength, energy and confidence back in the picture.' },
];
---

<Layout>
  <main>
    <section class="hero">
      <div class="hero-portrait"><Image src={avinashProfile} alt="Avinash Sharma, FitWithNash fitness coach" widths={[160, 320]} sizes="(max-width: 760px) 160px, 300px" priority /><span>The real coach behind the work</span></div>
      <div class="hero-copy">
        <p class="eyebrow">Evidence-led coaching / built for real life</p>
        <h1 class="display">Strength isn’t a look.<br />It’s a <em>standard.</em></h1>
        <p>Training, nutrition and accountability for people ready to feel strong in every room they walk into.</p>
        <a class="button" href="/contact">Find your starting point <span>→</span></a>
      </div>
      <span class="hero-meta">FITWITHNASH / 01—26</span>
    </section>

    <section class="proof" aria-label="FitWithNash highlights">
      <div><span>Not a quick fix</span><strong>Built to last.</strong></div>
      <div><strong>01</strong><span>Clear training</span></div>
      <div><strong>02</strong><span>Simple nutrition</span></div>
      <div><strong>03</strong><span>Real accountability</span></div>
    </section>

    <section id="programs" class="section programs">
      <p class="eyebrow">Ways to train</p>
      <h2 class="section-title">A system for the work you’re actually ready to do.</h2>
      <div class="program-grid">
        {programs.map((program) => <article class="program-card" style={`background-image:url('${program.image}')`}><span>{program.label}</span><h3>{program.title}</h3><p>{program.text}</p></article>)}
      </div>
    </section>

    <section class="offer section">
      <div><p class="eyebrow">Coaching that meets you where you are</p><h2 class="section-title">You don’t need another plan saved to your phone. You need a coach who notices.</h2></div>
      <div class="offer-list"><article><b>1:1 COACHING</b><h3>Your training, reviewed.</h3><p>Personal programming, clear feedback and a plan that adapts when work, travel or life gets loud.</p></article><article><b>PROGRAMS</b><h3>A proven place to start.</h3><p>Structured blocks for people who want direction without pretending fitness is their only priority.</p></article><article><b>FORM & MINDSET</b><h3>Build confidence under the bar.</h3><p>Learn the movements, understand your effort, and stop second-guessing every session.</p></article><a class="button dark" href="/contact">Talk to Nash <span>→</span></a></div>
    </section>

    <section class="section journey-feature" id="journeys">
      <div class="journey-feature__intro"><p class="eyebrow">The journey / Real people, real work</p><h2 class="section-title">The photo is the proof.<br />The <em>becoming</em> is the win.</h2><p>No miracle promises. Just a better relationship with training, food and the commitments you make to yourself—built one ordinary day at a time.</p><a class="button" href="/transformations">See every journey <span>→</span></a></div>
      <div class="journey-feature__stories">{journeys.map((journey, index) => <article class="journey-feature__card"><div class="journey-feature__image"><Image src={journey.image} alt={`${journey.name}'s authentic FitWithNash before-and-after journey`} loading="lazy" /><span>Original paired photo</span></div><p class="eyebrow">0{index + 1} / {journey.name}</p><h3>{journey.title}</h3><p>{journey.detail}</p></article>)}</div>
      <p class="journey-feature__note">Each card uses its original paired client photograph. Background, face and body have not been AI-altered. Individual results vary.</p>
    </section>

    <section id="method" class="section method">
      <div class="method-copy">
        <p class="eyebrow">The Nash method</p>
        <h2 class="section-title">Less noise. Better reps. More belief.</h2>
        <p>There’s no secret routine. There is a better way to show up: understand the why, execute the basics with quality, and build around a life you want to keep living.</p>
        <div class="principles">
          <div class="principle"><b>01</b><div><h3>Train the pattern</h3><p>Fundamental movement, progressive overload and enough recovery to adapt.</p></div></div>
          <div class="principle"><b>02</b><div><h3>Fuel the person</h3><p>Nutrition that supports performance without turning food into a full-time job.</p></div></div>
          <div class="principle"><b>03</b><div><h3>Build the identity</h3><p>Small, repeatable actions that make training part of who you are.</p></div></div>
        </div>
      </div>
      <Image class="method-image" src={coaching} alt="Avinash coaching a strength-training session" widths={[720, 1080, 1440]} sizes="(max-width: 760px) 100vw, 48vw" loading="lazy" />
    </section>

    <section id="journal" class="section journal">
      <p class="eyebrow">The journal</p>
      <h2 class="section-title">Useful ideas for becoming harder to break.</h2>
      <div class="journal-grid">
        {posts.map((post) => <article class="post" style={`background-image:url('${post.image}')`}><span>{post.category}</span><h3>{post.title}</h3></article>)}
      </div>
    </section>

    <section class="section testimonial"><p class="eyebrow">The difference is personal</p><blockquote>“The goal isn’t to live like an athlete. It’s to become the person who can trust themselves to do hard things.”</blockquote><p>— Nash, FitWithNash</p><a href="/transformations">Read transformation stories ↗</a></section>

    <section class="section instagram">
      <p class="eyebrow">Daily training notes</p>
      <h2>Follow the work.<br /><i>@fitwithnash</i></h2>
      <a href="https://www.instagram.com/fitwithnash/" target="_blank" rel="noreferrer">Visit Instagram ↗</a>
    </section>
  </main>
</Layout>
