---
import Layout from '../../layouts/Layout.astro';

export const prerender = true;

export const getStaticPaths = async () => {
  const apiUrl = import.meta.env.PUBLIC_API_URL;
  if (!apiUrl) {
    return [];
  }
  const headers = {
    Accept: 'application/json',
    ...(import.meta.env.CMS_API_TOKEN
      ? { Authorization: `Bearer ${import.meta.env.CMS_API_TOKEN}` }
      : {}),
  };

  const res = await fetch(`${apiUrl}/blog-posts`, { headers });
  if (!res.ok) throw new Error(`Unable to load blog posts: ${res.status}`);

  const posts = await res.json();
  return Promise.all(posts.map(async ({ slug }: { slug: string }) => {
    const postRes = await fetch(`${apiUrl}/blog-posts/${slug}`, { headers });
    if (!postRes.ok) throw new Error(`Unable to load blog post ${slug}: ${postRes.status}`);
    return { params: { slug }, props: { post: await postRes.json() } };
  }));
};

const { post } = Astro.props;
const publishedAt = post.publishDate ? new Date(post.publishDate).toISOString() : undefined;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.excerpt,
  datePublished: publishedAt,
  dateModified: publishedAt,
  mainEntityOfPage: `https://www.fitwithnash.com/blog/${post.slug}`,
  author: { '@type': 'Person', name: 'Avinash Sharma', url: 'https://www.fitwithnash.com/#avinash' },
  publisher: { '@type': 'Organization', name: 'FitWithNash', url: 'https://www.fitwithnash.com/' },
  ...(post.image?.formats?.large?.thumbnailUrl ? { image: post.image.formats.large.thumbnailUrl } : {}),
};
---

<Layout title={`${post.title} | FitWithNash`} description={post.excerpt || 'Practical fitness guidance from FitWithNash.'}>
  <main class="py-12 px-4 max-w-2xl mx-auto">
    <article>
      <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
      <h1 class="text-4xl font-bold mb-4">{post.title}</h1>
      {post.image?.formats?.large?.thumbnailUrl && <img src={post.image.formats.large.thumbnailUrl} alt={post.title} class="w-full h-48 object-cover rounded mb-6" />}
      <div class="prose max-w-none">
        <p>{post.excerpt}</p>
        <Fragment set:html={post.body} />
      </div>
      <footer class="mt-8 text-sm text-gray-600">
        Posted on {new Date(post.publishDate).toLocaleDateString()}
      </footer>
    </article>
  </main>
</Layout>
