---
import Layout from '../../layouts/Layout.astro';

export const getStaticPaths = async () => {
  const apiUrl = import.meta.env.PUBLIC_API_URL;
  if (!apiUrl) {
    throw new Error('PUBLIC_API_URL must be set to build blog pages.');
  }

  const res = await fetch(`${apiUrl}/blog-posts`, { headers: { Accept: 'application/json' } });
  if (!res.ok) throw new Error(`Unable to load blog posts: ${res.status}`);

  const posts = await res.json();
  return Promise.all(posts.map(async ({ slug }: { slug: string }) => {
    const postRes = await fetch(`${apiUrl}/blog-posts/${slug}`);
    if (!postRes.ok) throw new Error(`Unable to load blog post ${slug}: ${postRes.status}`);
    return { params: { slug }, props: { post: await postRes.json() } };
  }));
};

const { post } = Astro.props;
---

<Layout>
  <main class="py-12 px-4 max-w-2xl mx-auto">
    <article>
      <h1 class="text-4xl font-bold mb-4">{post.title}</h1>
      {post.image?.formats?.large?.thumbnailUrl && <img src={post.image.formats.large.thumbnailUrl} alt={post.title} class="w-full h-48 object-cover rounded mb-6" />}
      <div class="prose max-w-none">
        <p>{post.excerpt}</p>
        <Fragment set:html={post.body} />
      </div>
      <footer class="mt-8 text-sm text-gray-600">
        Posted on {new Date(post.publishDate).toLocaleDateString()}
      </footer>
    </article>
  </main>
</Layout>
