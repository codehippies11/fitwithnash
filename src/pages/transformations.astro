---
import Layout from '../layouts/Layout.astro';
export const prerender = false;
const base = import.meta.env.PUBLIC_SUPABASE_URL;
const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
let stories: any[] = [];
if (base && key) {
  const response = await fetch(`${base}/rest/v1/transformations?is_published=eq.true&select=*&order=created_at.desc`, { headers: { apikey: key, Authorization: `Bearer ${key}` } });
  stories = await response.json();
}
---
<Layout title="Real transformations | FitWithNash" description="Stories of sustainable training, consistency and confidence from the FitWithNash community.">
  <main class="section transformations"><p class="eyebrow">The work speaks</p><h1 class="section-title">Real people. Real change.</h1><div class="story-grid">{stories.length ? stories.map((story) => <article><div class="story-images">{story.before_image_url && <img src={story.before_image_url} alt={`${story.client_name} before training`} />}{story.after_image_url && <img src={story.after_image_url} alt={`${story.client_name} after training`} />}</div><p class="eyebrow">{story.client_name}</p><h2>{story.title}</h2><p>{story.story}</p></article>) : <p class="empty">Transformation stories will appear here as they are published.</p>}</div></main>
</Layout>
<style>.transformations{padding-top:150px}.story-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:24px;margin-top:50px}.story-images{display:grid;grid-template-columns:1fr 1fr;gap:3px}.story-images img{width:100%;aspect-ratio:4/5;object-fit:cover}.story-grid h2{font:600 2rem/1 "Playfair Display",serif}.story-grid article>p:last-child{color:var(--muted);line-height:1.7}.empty{color:var(--muted)}@media(max-width:760px){.story-grid{grid-template-columns:1fr}}</style>
