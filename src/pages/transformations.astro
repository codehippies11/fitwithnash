---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import arunJourney from '../assets/images/journeys/arun-journey.png';
import krishamJourney from '../assets/images/journeys/krisham-journey.png';
import farbeenaJourney from '../assets/images/journeys/farbeena-journey.png';
export const prerender = false;
const base = import.meta.env.PUBLIC_SUPABASE_URL;
const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
let stories: any[] = [];
let media: Record<string, string> = {};
if (base && key) {
  const response = await fetch(`${base}/rest/v1/transformations?is_published=eq.true&select=*&order=created_at.desc`, { headers: { apikey: key, Authorization: `Bearer ${key}` } });
  if (response.ok) stories = await response.json();
  const mediaResponse = await fetch(`${base}/rest/v1/site_media?select=key,image_url`, { headers: { apikey: key, Authorization: `Bearer ${key}` } });
  if (mediaResponse.ok) media = Object.fromEntries((await mediaResponse.json()).map((item: { key: string; image_url: string }) => [item.key, item.image_url]));
}
const highlights = [
  { image: media.home_journey_arun || arunJourney.src, name: 'Arun', title: 'The plan became a standard.', story: 'Arun stopped chasing short bursts of motivation and began building his weeks around training he could actually repeat. The visible change came after the quieter win: showing up on ordinary days, keeping food simple and learning that patient work compounds.' },
  { image: media.home_journey_krisham || krishamJourney.src, name: 'Krisham', title: 'More strength. More self-belief.', story: 'Krisham’s result is not about a perfect routine. It is about committing to the next session, adapting when life got busy and giving his body enough time to respond. The physique changed because the habits underneath it did too.' },
  { image: media.home_journey_farbeena || farbeenaJourney.src, name: 'Farbeena', title: 'Confidence, rebuilt from the inside out.', story: 'Farbeena chose progress that fits real life: practical training, supportive nutrition and a pace she could own. What started as a physical goal became more energy, more confidence and proof that she could keep a promise to herself.' },
];
---
<Layout title="Transformation journeys | FitWithNash" description="Real FitWithNash coaching journeys built on strength, nutrition and sustainable habits.">
  <main class="transformations">
    <section class="journey-hero section"><p class="eyebrow">Client experiences</p><h1 class="display">The before is a moment.<br />The <em>becoming</em> is the story.</h1><p>These are real client journeys, built through better training, repeatable nutrition and a decision to keep going when life is busy.</p><a class="button" href="/contact">Start your own story <span>→</span></a></section>
    <section class="journey-grid section" aria-label="FitWithNash client journeys">
      {stories.length ? stories.map((story, index) => <article class="cms-story"><div class="story-images">{story.before_image_url && <figure><img src={story.before_image_url} alt={`${story.client_name} before their coaching journey`} /><figcaption>Before</figcaption></figure>}{story.after_image_url && <figure><img src={story.after_image_url} alt={`${story.client_name} during their coaching journey`} /><figcaption>After</figcaption></figure>}</div><div class="story-copy"><p class="eyebrow">{String(index + 1).padStart(2, '0')} / {story.client_name}</p><h2>{story.title}</h2><p>{story.story}</p><a href="/contact">Write your next chapter ↗</a></div></article>) : highlights.map((story, index) => <article class="journey-card"><div class="journey-image"><img src={story.image} alt={`${story.name}'s authentic FitWithNash paired before-and-after journey`} loading="lazy" /><div class="journey-stamp"><span>Real journey</span><b>0{index + 1}</b></div></div><div class="story-copy"><p class="eyebrow">{story.name} / coaching journey</p><h2>{story.title}</h2><p>{story.story}</p><a href="/contact">Build your own story ↗</a></div></article>)}
    </section>
    <section class="journey-cta section"><p class="eyebrow">Your turn</p><h2>There is no perfect time to start. There is a first honest step.</h2><p>Tell Avinash what you want to change. You’ll get clarity on the right way to begin—not another recycled plan.</p><div><a class="button" href="https://wa.me/918360669905?text=Hi%20Avinash%2C%20I%20want%20to%20start%20my%20fitness%20journey." target="_blank" rel="noreferrer">Message on WhatsApp <span>→</span></a><a class="text-link" href="/contact">Or send a detailed enquiry ↗</a></div></section>
  </main>
</Layout>
<style>
  .journey-hero{padding-top:160px;min-height:620px;background:radial-gradient(circle at 84% 30%,#52651a 0,transparent 25%),var(--ink)}.journey-hero .display{max-width:1100px}.journey-hero>p:not(.eyebrow){max-width:600px;color:var(--muted);line-height:1.75;margin:26px 0 32px}.journey-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(45px,8vw,130px) clamp(18px,3vw,45px);background:#ebe8de;color:var(--ink)}.journey-card,.cms-story{display:grid;gap:20px;min-width:0}.journey-card:nth-child(even),.cms-story:nth-child(even){margin-top:100px}.journey-image{position:relative;display:grid;place-items:center;aspect-ratio:35/36;overflow:hidden;background:#24261f}.journey-image :global(img){display:block;width:100%;height:100%;object-fit:contain;filter:saturate(.87) contrast(1.04)}.journey-image:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 65%,rgba(17,18,16,.5)),linear-gradient(115deg,rgba(213,255,69,.18),transparent 35%);pointer-events:none}.journey-stamp{position:absolute;z-index:1;inset:auto 16px 16px;display:flex;align-items:center;justify-content:space-between;color:var(--paper);font:700 11px "DM Mono",monospace;text-transform:uppercase;letter-spacing:.1em}.journey-stamp b{display:grid;place-items:center;width:38px;height:38px;background:var(--lime);color:var(--ink);border-radius:50%}.story-copy h2{margin:12px 0 13px;font:600 clamp(2rem,3vw,3.25rem)/.92 "Playfair Display",serif;letter-spacing:-.05em}.story-copy>p:last-of-type{max-width:540px;color:#585b53;line-height:1.72}.story-copy a{display:inline-block;margin-top:6px;color:var(--ink);font-size:13px;font-weight:800;border-bottom:1px solid currentColor}.story-images{display:grid;grid-template-columns:1fr 1fr;gap:4px}.story-images figure{position:relative;display:grid;place-items:center;aspect-ratio:3/4;margin:0;overflow:hidden;background:#24261f}.story-images img{display:block;width:100%;height:100%;object-fit:contain}.story-images figcaption{position:absolute;left:10px;bottom:10px;padding:6px 8px;background:var(--lime);color:var(--ink);font:700 10px "DM Mono",monospace;text-transform:uppercase;letter-spacing:.08em}.journey-cta{text-align:center;background:var(--lime);color:var(--ink)}.journey-cta h2{max-width:900px;margin:17px auto;font:600 clamp(2.7rem,6vw,6rem)/.9 "Playfair Display",serif;letter-spacing:-.06em}.journey-cta>p:not(.eyebrow){max-width:560px;margin:0 auto 30px;line-height:1.7}.journey-cta>div{display:flex;gap:22px;justify-content:center;align-items:center}.text-link{border-bottom:1px solid var(--ink);font-size:13px;font-weight:800}@media(max-width:760px){.journey-hero{padding-top:135px;min-height:auto}.journey-grid{grid-template-columns:1fr;gap:58px}.journey-card:nth-child(even),.cms-story:nth-child(even){margin-top:0}.journey-cta>div{flex-direction:column;gap:18px}}
</style>
