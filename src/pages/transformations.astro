---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import transformationJourney from '../assets/images/instagram/fe49d0a755944497.jpg';
export const prerender = false;
const base = import.meta.env.PUBLIC_SUPABASE_URL;
const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
let stories: any[] = [];
if (base && key) {
  const response = await fetch(`${base}/rest/v1/transformations?is_published=eq.true&select=*&order=created_at.desc`, { headers: { apikey: key, Authorization: `Bearer ${key}` } });
  stories = await response.json();
}
const highlights = [{ image: transformationJourney, label: 'Authentic paired journey', title: 'The before and after belong to the same story.' }];
---
<Layout title="Transformation journeys | FitWithNash" description="Real FitWithNash coaching journeys built on strength, nutrition and sustainable habits.">
  <main class="transformations">
    <section class="journey-hero section"><p class="eyebrow">Client experiences</p><h1 class="display">The before is a moment.<br />The <em>becoming</em> is the story.</h1><p>These are not miracle promises. They are the visible result of better training, repeatable nutrition and someone deciding that they deserve to feel strong.</p><a class="button" href="/contact">Start your own story <span>→</span></a></section>
    <section class="journey-grid section" aria-label="FitWithNash client journeys">
      {stories.length ? stories.map((story) => <article class="cms-story"><div class="story-images">{story.before_image_url && <img src={story.before_image_url} alt={`${story.client_name} before their coaching journey`} />}{story.after_image_url && <img src={story.after_image_url} alt={`${story.client_name} during their coaching journey`} />}</div><p class="eyebrow">{story.client_name}</p><h2>{story.title}</h2><p>{story.story}</p></article>) : highlights.map((story, index) => <article class="journey-card"><div class="journey-image"><Image src={story.image} alt="Authentic FitWithNash client before-and-after transformation shared in one Instagram post" loading="lazy" /><span>{String(index + 1).padStart(2, '0')}</span></div><p class="eyebrow">{story.label}</p><h2>{story.title}</h2><p>This original paired photo is shared as one complete client journey. The goal is not a quick fix—it is progress built through training, nutrition and consistency.</p></article>)}
    </section>
    <section class="journey-cta section"><p class="eyebrow">Your turn</p><h2>There is no perfect time to start. There is a first honest step.</h2><p>Tell Avinash what you want to change. You’ll get clarity on the right way to begin—not another recycled plan.</p><div><a class="button" href="https://wa.me/918360669905?text=Hi%20Avinash%2C%20I%20want%20to%20start%20my%20fitness%20journey." target="_blank" rel="noreferrer">Message on WhatsApp <span>→</span></a><a class="text-link" href="/contact">Or send a detailed enquiry ↗</a></div></section>
  </main>
</Layout>
<style>
  .journey-hero{padding-top:160px;min-height:620px;background:radial-gradient(circle at 84% 30%,#52651a 0,transparent 25%),var(--ink)}.journey-hero .display{max-width:1100px}.journey-hero>p:not(.eyebrow){max-width:580px;color:var(--muted);line-height:1.75;margin:26px 0 32px}.journey-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:clamp(32px,6vw,90px) 22px;background:#ebe8de;color:var(--ink)}.journey-card:nth-child(odd){margin-top:80px}.journey-image{position:relative;overflow:hidden;background:#24261f}.journey-image :global(img){width:100%;aspect-ratio:4/5;object-fit:cover;filter:saturate(.82) contrast(1.06)}.journey-image:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 65%,rgba(17,18,16,.48)),linear-gradient(115deg,rgba(213,255,69,.2),transparent 35%);mix-blend-mode:soft-light}.journey-image span{position:absolute;z-index:1;top:18px;left:18px;width:42px;height:42px;display:grid;place-items:center;border-radius:99px;background:var(--lime);font:12px "DM Mono",monospace}.journey-card h2,.cms-story h2{margin:12px 0 9px;font:600 clamp(1.8rem,3vw,3rem)/.95 "Playfair Display",serif;letter-spacing:-.04em}.journey-card>p:last-child,.cms-story>p:last-child{max-width:500px;color:#585b53;line-height:1.7}.cms-story .story-images{display:grid;grid-template-columns:1fr 1fr;gap:4px}.cms-story img{width:100%;aspect-ratio:3/4;object-fit:cover}.journey-cta{text-align:center;background:var(--lime);color:var(--ink)}.journey-cta h2{max-width:900px;margin:17px auto;font:600 clamp(2.7rem,6vw,6rem)/.9 "Playfair Display",serif;letter-spacing:-.06em}.journey-cta>p:not(.eyebrow){max-width:560px;margin:0 auto 30px;line-height:1.7}.journey-cta>div{display:flex;gap:22px;justify-content:center;align-items:center}.text-link{border-bottom:1px solid var(--ink);font-size:13px;font-weight:800}@media(max-width:760px){.journey-hero{padding-top:135px;min-height:auto}.journey-grid{grid-template-columns:1fr}.journey-card:nth-child(odd){margin-top:0}.journey-cta>div{flex-direction:column;gap:18px}}
</style>
